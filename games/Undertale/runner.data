  "SCR_TEXT_2626": " %%",
  "SCR_TEXT_2634": "* (It's a statue^1.)&* (The structures at its&  feet seem dry.)/%%",
  "SCR_TEXT_2637": "* (Put the umbrella on the&  statue?)&         Yes         Do not\\C",
  "SCR_TEXT_2638": " ",
  "SCR_TEXT_2642": "* (The music continues^1, and&  doesn't stop.)/%%",
  "SCR_TEXT_2651": "* (You place the umbrella&  atop the statue.)/",
  "SCR_TEXT_2652": "* (Inside the statue^1, a music&  box begins to play...)/%%",
  "SCR_TEXT_2667": " %%",
  "SCR_TEXT_2674": "* (It's a rusty old&  fridge.)/",
  "SCR_TEXT_2675": "* (Look inside?)& &         Yes         No\\C",
  "SCR_TEXT_2676": " ",
  "SCR_TEXT_2682": "* (You open the fridge.^1)&* (The air fills with a&  rotten stench.)/",
  "SCR_TEXT_2683": "* (All the food inside here&  spoiled long ago.)/%%",
  "SCR_TEXT_2686": " %%",
  "SCR_TEXT_2692": "* error/%%",
  "SCR_TEXT_2694": "* (The cooler is empty.)/%%",
  "SCR_TEXT_2698": "* (Take a space food bar&  from the cooler?)&         Yes         No \\C",
  "SCR_TEXT_2699": " ",
  "SCR_TEXT_2704": "* (It's a cooler^1.&* It has no brand^1, and&  shows no signs of wear...)/",
  "SCR_TEXT_2705": "* (Inside are a couple&  of freeze-dried space&  food bars.)/",
  "SCR_TEXT_2706": "* (Take one?)& &         Yes         No \\C",
  "SCR_TEXT_2707": " ",
  "SCR_TEXT_2726": "* (You got the Astronaut Food.)/%%",
  "SCR_TEXT_2728": "* (You're carrying too much.)/%%",
  "SCR_TEXT_2732": "* %%",
  "SCR_TEXT_2739": "* (Seems like a regular&  training dummy.)/",
  "SCR_TEXT_2740": "* (Do you want to beat it&  up?)&         Yes         No \\C",
  "SCR_TEXT_2741": " ",
  "SCR_TEXT_2744": "* (You've had enough of&  the dummy.)/%%",
  "SCR_TEXT_2752": "* (You tap the dummy with&  your fist.)/",
  "SCR_TEXT_2753": "* (You feel bad.)/%%",
  "SCR_TEXT_2757": "* (You hit the dummy&  lightly.)/",
  "SCR_TEXT_2758": "* (You don't feel like&  you learned anything.)/%%",
  "SCR_TEXT_2762": "* (You sock the dummy.)/",
  "SCR_TEXT_2763": "* (Who cares?)/%%",
  "SCR_TEXT_2767": "* (You punch the dummy at&  full force.)/",
  "SCR_TEXT_2768": "* (Feels good.)/%%",
