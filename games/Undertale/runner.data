  "SCR_TEXT_6835": "\\Y   * (Saved)       * (Saved)\\W ",
  "SCR_TEXT_6848": "   * Someone else",
  "SCR_TEXT_6849": "   * Asriel Dreemurr",
  "SCR_TEXT_6868": "* Dialing..\\E0.\\TT /",
  "SCR_TEXT_6876": "\\F1 %",
  "SCR_TEXT_6877": "\\E0* This is TORIEL./",
  "SCR_TEXT_6878": "* You only wanted to&  say hello...^2?&* Well then./",
  "SCR_TEXT_6879": "\\E0* 'Hello!'/",
  "SCR_TEXT_6880": "* I hope that suffices^1.&* Hee hee./",
  "SCR_TEXT_6881": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6882": "* Click.../%%",
  "SCR_TEXT_6886": "\\F1 %",
  "SCR_TEXT_6887": "\\E0* This is TORIEL./",
  "SCR_TEXT_6888": "* You want to say&  hello again?/",
  "SCR_TEXT_6889": "* 'Salutations!'/",
  "SCR_TEXT_6890": "* Is that enough?/",
  "SCR_TEXT_6891": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6892": "* Click.../%%",
  "SCR_TEXT_6896": "\\F1 \\TT %",
  "SCR_TEXT_6897": "\\E0* This is TORIEL./",
  "SCR_TEXT_6898": "* Are you bored^1?&* I should have given&  a book to you./",
  "SCR_TEXT_6899": "* My apologies./",
  "SCR_TEXT_6900": "* Why not use your&  imagination to&  divert yourself?/",
  "SCR_TEXT_6901": "* Pretend you are..^1.&* A monarch!/",
  "SCR_TEXT_6902": "* Rule over the leaf pile&  with a fist of iron./",
  "SCR_TEXT_6903": "* Can you do that for me?/",
  "SCR_TEXT_6904": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6905": "* Click.../%%",
  "SCR_TEXT_6909": "\\F1 \\TT %",
  "SCR_TEXT_6910": "\\E0* This is TORIEL./",
  "SCR_TEXT_6911": "* Hello^1, my child./",
  "SCR_TEXT_6912": "\\E1* Sorry^1, I do not have&  much to say./",
  "SCR_TEXT_6913": "\\E0* It was nice to hear&  your voice^1, though^1./",
  "SCR_TEXT_6914": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6915": "* Click.../%%",
  "SCR_TEXT_6920": "* Dialing..\\E0.\\TT /",
  "SCR_TEXT_6921": "\\F1 %",
  "SCR_TEXT_6922": "* This is TORIEL./",
  "SCR_TEXT_6923": "\\E1* Help with a puzzle^1.^1.^1.?/",
  "SCR_TEXT_6924": "* Um^1, you have not&  left the room^1, have you?/",
  "SCR_TEXT_6925": "\\E0* Wait patiently for&  me and we can solve&  it together!/",
  "SCR_TEXT_6926": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6927": "* Click.../%%",
  "SCR_TEXT_6931": "* Dialing..\\E0.\\TT /",
  "SCR_TEXT_6932": "\\F1 %",
  "SCR_TEXT_6933": "* This is TORIEL./",
  "SCR_TEXT_6934": "\\E1* You want to know&  more about me?/",
  "SCR_TEXT_6935": "* Well^1, I am afraid there&  is not much to say./",
  "SCR_TEXT_6936": "\\E0* I am just a silly little&  lady who worries too&  much!/",
  "SCR_TEXT_6937": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6938": "* Click.../%%",
  "SCR_TEXT_6943": "* Dialing..\\E0.\\TT /",
  "SCR_TEXT_6944": "\\F1 %",
  "SCR_TEXT_6945": "* This is TORIEL./",
  "SCR_TEXT_6946": "\\E8* Huh^2?&* Did you just call&  me... \"Mom\"?/",
  "SCR_TEXT_6947": "\\E1* Well...&* I suppose.../",
  "SCR_TEXT_6948": "* Would that make you&  happy?/",
  "SCR_TEXT_6949": "* To call me..^2.&* \"Mother?\"/",
  "SCR_TEXT_6950": "\\E0* Well then^1, call me&  whatever you like!/!",
  "SCR_TEXT_6951": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6952": "* Click.../%%",
  "SCR_TEXT_6963": "* Dialing..\\E0.\\TT /",
  "SCR_TEXT_6964": "\\F1 %",
  "SCR_TEXT_6965": "\\E8* ...^2 huh???/",
  "SCR_TEXT_6966": "\\E1* Oh,^1 heh..^1 heh...^1 \\E0 &* Ha ha ha!/",
  "SCR_TEXT_6967": "* How adorable...^1 I&  could pinch your cheek!/",
  "SCR_TEXT_6968": "* You can certainly find&  better than an old woman&  like me./",
  "SCR_TEXT_6969": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6970": "* Click.../%%",
  "SCR_TEXT_6974": "* Dialing..\\E0.\\TT /",
  "SCR_TEXT_6975": "\\F1 %",
  "SCR_TEXT_6976": "\\E1* Oh dear,^1 are you&  serious...?/",
  "SCR_TEXT_6977": "\\E1* I do not know if this is&  pathetic,^1 or endearing./",
  "SCR_TEXT_6978": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6979": "* Click.../%%",
  "SCR_TEXT_6982": "\\E8* And after you said you&  want to call&  me \"mother...\"/",
  "SCR_TEXT_6983": "\\E0* You are an...^2 &  \\E1... \"interesting\"&  child./",
  "SCR_TEXT_6984": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_6985": "* Click.../%%",
  "SCR_TEXT_6994": "* Dialing... /",
  "SCR_TEXT_6995": "* ... /",
  "SCR_TEXT_6996": "* But nobody came./%%",
  "SCR_TEXT_7000": "* Dialing... /",
  "SCR_TEXT_7001": "* ... /",
  "SCR_TEXT_7002": "* Nobody picked up./%%",
  "SCR_TEXT_7007": "* Dialing... /",
  "SCR_TEXT_7008": "* ... /",
  "SCR_TEXT_7009": "* The ringing is coming from&  inside your inventory./%%",
  "SCR_TEXT_7016": "* Dialing...\\TT /",
  "SCR_TEXT_7017": "\\F1 %",
  "SCR_TEXT_7018": "* Hey^1, you silly&  child./",
  "SCR_TEXT_7019": "* If you want to&  talk to me^1, I am&  right here./",
  "SCR_TEXT_7020": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_7021": "* Click.../%%",
  "SCR_TEXT_7025": "* Dialing... /",
  "SCR_TEXT_7026": "* ... /",
  "SCR_TEXT_7027": "* (Somewhere^1, signals deflected&  by a dog.)/%%",
  "SCR_TEXT_7040": "* (No response.^1)&* (Their phone might be out&  of batteries.)/%%",
  "SCR_TEXT_7052": "* (The box is aclog with the&  hair of a dog.)/%%",
  "SCR_TEXT_7079": "* You encountered the Dummy.",
  "SCR_TEXT_7080": "%%%",
  "SCR_TEXT_7084": "* Froggit attacks you!",
  "SCR_TEXT_7085": "%%%",
  "SCR_TEXT_7089": "* Froggit hopped close!",
  "SCR_TEXT_7090": "%%%",
  "SCR_TEXT_7094": "* Whimsun approached meekly!",
  "SCR_TEXT_7095": "%%%",
  "SCR_TEXT_7099": "* Froggit and Whimsun drew near!",
  "SCR_TEXT_7100": "%%%",
  "SCR_TEXT_7104": "* Moldsmal blocked the way!",
  "SCR_TEXT_7105": "%%%",
  "SCR_TEXT_dogshrine_5913": "* (Dog Shrine.)/",
  "SCR_TEXT_dogshrine_5914": "* (Donate?)& &         Dognate     Dognot\\C",
  "SCR_TEXT_dogshrine_5919": "* (\\[1] of \\[2]G in the box.)& &         Dognate     Dognot\\C",
  "SCR_TEXT_dogshrine_5924": "* (Looks like the money was used&  to buy some fairy lights.)/",
  "SCR_TEXT_dogshrine_5925": "* (It was kind of dark in here.)/",
  "SCR_TEXT_dogshrine_5933": "* (Looks like the money was used&  to increase the size of the&  shrine.)/",
  "SCR_TEXT_dogshrine_5941": "* (The donation box slot is even&  bigger now.)/",
  "SCR_TEXT_dogshrine_5942": "* (You should be able to donate&  even more at once!)/",
  "SCR_TEXT_dogshrine_5943": "* (... actually^1, it looks like&  the sides of the slot are&  just painted on...)/",
  "SCR_TEXT_dogshrine_5944": "* (Seems you'll still have to&  donate just 1G at a time...)/",
  "SCR_TEXT_dogshrine_5954": "* (The donation box is sealed.)/",
  "SCR_TEXT_dogshrine_5955": "* (There was seemingly no point&  to all of this...)/%",
  "SCR_TEXT_dogshrine_5958": "* (Since your adventure is over^1,&  you can reminisce about how&  useful the Dog Shrine was...)/",
  "SCR_TEXT_dogshrine_5959": "* (... it wasn't useful at all.)/%",
  "SCR_TEXT_dogshrine_5970": "* (Something is wrong with&  the box.)/%",
  "SCR_TEXT_dogshrine_5977": "* (The box is full.)/%",
  "SCR_TEXT_dogshrine_5982": "* (Not enough money.)/",
  "SCR_TEXT_dogshrine_5983": "* (That's relieving...)/%",
  "SCR_TEXT_dogshrine_5993": "* (You donated 1G.)/%",
  "SCR_TEXT_dogshrine_5997": "* (You put 1G into the box.)/",
  "SCR_TEXT_dogshrine_5998": "* (You feel like you're about to&  waste a lot of time...)/%",
  "SCR_TEXT_dogshrine_6003": "* (Clink!)&* (The box is filled with coins.)/",
  "SCR_TEXT_dogshrine_6004": "* (Perhaps if you leave and&  return^1, the donations will be&  used for something.)/%",
  "SCR_TEXT_dogshrine_6015": "* (You feel a sense of relief.)/%",
  "SCR_TEXT_dogshrine_6024": "* (Donation box.)& &         Use It      Do not\\C",
  "SCR_TEXT_dogshrine_6031": "* (... hand can't fit inside.)/",
  "SCR_TEXT_dogshrine_6032": "* (Check it again to try&  donating.)/%",
  "SCR_TEXT_dogshrine_6037": "* (Right.)/%",
  "SCR_TEXT_dogshrine_6045": "* (The boombox is playing...)&* (An upbeat song.)/",
  "SCR_TEXT_dogshrine_6046": "* (It's having a psychological&  effect on your desire to&  donate.)/",
  "SCR_TEXT_dogshrine_6047": "* (... It's not clear what kind&  of effect that is.)/",
  "SCR_TEXT_dogshrine_6048": "* (Change the track?)& &         Change      Do not\\C",
  "SCR_TEXT_dogshrine_6059": "* (Huh!?)&* (The next track is just the&  same but faster...!?)/%",
  "SCR_TEXT_dogshrine_6065": "* (You see no reason to&  change it.)/%",
  "SCR_TEXT_dogshrine_6070": "* (You returned the song&  to normal.)/%",
  "SCR_TEXT_dogshrine_6076": "* (\\[1]G inside.)& &         Donate      Do not\\C",
  "SCR_TEXT_dogshrine_6095": "* (1G was put inside.)/%",
  "SCR_TEXT_dogshrine_6101": "* (Not enough G.)/%",
  "SCR_TEXT_dogshrine_6106": "* (There's enough.)/%",
  "SCR_TEXT_dogshrine_6112": "* (Nothing was put inside.)/%",
  "blt_sizebone_115": " THIS IS AN ERROR& MESSAGE^1.& REALLY!!!/%%",
  "blt_sizebone_118": " YOU'RE TOO WEAK!!& I WAS EASILY ABLE& TO CAPTURE YOU!!!/",
  "blt_sizebone_119": " I WILL NOW SEND& YOU TO THE& CAPTURE ZONE!!/",
  "blt_sizebone_120": " OR^1, AS SANS& CALLS IT^1.../",
  "blt_sizebone_121": " OUR GARAGE???/",
  "blt_sizebone_122": " YOU'RE IN THE& DOGHOUSE NOW!/",
  "blt_sizebone_123": " NYEH HEH HEH HEH& HEH HEH HEH!!!/%%",
  "blt_sizebone_127": " WELL!!^1! YOU MAY& HAVE CLEVERLY& ESCAPED FROM& JAIL BEFORE.../",
  "blt_sizebone_128": " BUT THIS TIME^1,& I'VE UPGRADED& THE FACILITIES./",
  "blt_sizebone_129": " NOT ONLY WILL& YOU BE& TRAPPED.../",
  "blt_sizebone_130": " BUT YOU WON'T& EVEN WANT& TO LEAVE!!!/",
  "blt_sizebone_131": " NYEH HEH HEH HEH& HEH HEH HEH!!!/%%",
  "blt_sizebone_136": " YOU ARE...& PERSISTENT!/",
  "blt_sizebone_137": " BUT^1!& IT JUST WON'T& WORK ON ME!/",
  "blt_sizebone_138": " I AM THE& PERSISTENTEST!/",
  "blt_sizebone_139": " AND IF YOU& THINK YOU ARE& PERSISTENESTER.../",
  "blt_sizebone_140": " THAT IS WRONG^1!& GRAMATICALLY& WRONG!/",
  "blt_sizebone_141": " BECAUSE THE& CORRECT FORM& WOULD BE.../",
  "blt_sizebone_142": " NOT AS& PERSISTENTEST AS& PAPYRUS^1, THE& PERSISTENTESTEST!/\"",
  "blt_sizebone_143": " I HOPE YOU& ENJOYED THIS& LESSON./",
  "blt_sizebone_144": " NYEH HEH HEH HEH& HEH HEH HEH!!!/%%",
