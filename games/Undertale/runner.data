  "obj_tordogcall_112": "* (...)/",
  "obj_tordogcall_113": "* Bark^1!&* Bark!/",
  "obj_tordogcall_114": "* Bark..^1.&* Bark!/",
  "obj_tordogcall_115": "* (You hear a distant voice.)\\TT/",
  "obj_tordogcall_116": "* Stop^1, please!/",
  "obj_tordogcall_117": "* Come back here with my&  CELLPHONE!/",
  "obj_tordogcall_118": "\\TS \\F0 \\T0 %",
  "obj_tordogcall_119": "* Click.../%%",
  "obj_tordogcall_150": "* Ring.../",
  "obj_tordogcall_151": "* (...)/",
  "obj_tordogcall_152": "* (Snore..^1. snore...)/",
  "obj_tordogcall_153": "* (It sounds like a small^1,&  white dog is sleeping on&  the cell phone.)/",
  "obj_tordogcall_154": "* (You hear a distant voice.)\\TT/",
  "obj_tordogcall_155": "* Helloooo^1?&* Little puppy...?/",
  "obj_tordogcall_156": "* Where are you...?/",
  "obj_tordogcall_157": "* I will give you a nice pat&  on the head!\\T0/",
  "obj_tordogcall_158": "* (The snoring stops.)\\TT/",
  "obj_tordogcall_159": "* ... if you return my CELLPHONE.\\T0/",
  "obj_tordogcall_160": "* (The snoring resumes.)/",
  "obj_tordogcall_161": "\\TS \\F0 \\T0 %",
  "obj_tordogcall_162": "* Click.../%%",
  "obj_tordogcall_176": "* Ring.../",
  "obj_tordogcall_177": "* (...)/",
  "obj_tordogcall_178": "* (Snore..^1. snore...)/",
  "obj_tordogcall_179": "* (Achoo!)/",
  "obj_tordogcall_180": "* (It sounds like a small^1,&  white dog sneezing in its&  sleep.)/",
  "obj_tordogcall_181": "* (You hear a distant voice.)\\TT/",
  "obj_tordogcall_182": "* Here^1, pup-pup-puppy!/",
  "obj_tordogcall_183": "* Oh dear^1, I should not keep&  my guest waiting any longer./",
  "obj_tordogcall_184": "* ... Oh no^1, how long has it&  been since I have talked to&  them...?/",
  "obj_tordogcall_185": "* Perhaps they have been calling&  the phone^1, and...?/",
  "obj_tordogcall_186": "* ... here^1, puppy!/",
  "obj_tordogcall_187": "\\TS \\F0 \\T0 %",
  "obj_tordogcall_188": "* Click.../%%",
  "obj_tordogcall_203": "* Ring.../",
  "obj_tordogcall_204": "* (...)/",
  "obj_tordogcall_205": "* (Snore..^1. snore...)/",
  "obj_tordogcall_206": "* (Yawn...)/",
  "obj_tordogcall_207": "* (Blink blink.)/",
  "obj_tordogcall_208": "* (Yawn...)/",
  "obj_tordogcall_209": "* (Snore..^1. snore...)/",
  "obj_tordogcall_210": "* (You hear a tired voice.)\\TT/",
  "obj_tordogcall_211": "* Doggie..^1.&* Here^1, doggie.../",
  "obj_tordogcall_212": "* Oh dear.../",
  "obj_tordogcall_213": "* I do wonder how they are.../",
  "obj_tordogcall_214": "\\TS \\F0 \\T0 %",
  "obj_tordogcall_215": "* Click.../%%",
  "obj_tordogcall_230": "* Ring.../",
  "obj_tordogcall_231": "* (Snore..^1. snore...)/",
  "obj_tordogcall_232": "\\TS \\F0 \\T0 %",
  "obj_tordogcall_233": "* Click.../%%",
  "obj_toriel_friendc_70": "* Hello^1, Frisk^1.&* Alphys upgraded my&  phone./",
  "obj_toriel_friendc_71": "* I am having a lot&  of fun with the&  \"texting\" feature./",
  "obj_toriel_friendc_72": "* Sans^1, \"check out\" this&  one./",
  "obj_toriel_friendc_74": "* oh man^1, tori.../",
  "obj_toriel_friendc_75": "\\E1* that's brutal./",
  "obj_toriel_friendc_77": "I CAN'T BELIEVE&THE QUEEN HAS&RETURNED.../",
  "obj_toriel_friendc_78": "\\E4AND ALSO THAT&SHE'S A HUGE&DORK!!!/",
  "obj_toriel_friendc_79": "YOU TWO ARE TWO&FEET AWAY FROM&EACH OTHER!!!/",
  "obj_toriel_friendc_80": "WHY ARE YOU&TEXTING!!!/",
  "obj_toriel_friendc_82": "* Worry not^1, Papyrus^1.&* We are texting for&  a good reason./",
  "obj_toriel_friendc_84": "WHY IS THAT./",
  "obj_toriel_friendc_86": "* well./",
  "obj_toriel_friendc_87": "\\E2* cause we're huge&  dorks./",
  "obj_toriel_friendc_89": "* Sans^1, please do&  not say that./",
  "obj_toriel_friendc_90": "* You are not a dork./",
  "obj_toriel_friendc_91": "\\E0* You are more of&  a bonehead!/",
  "obj_toriel_friendc_93": "HAHAHA^1, WOW!/",
  "obj_toriel_friendc_94": "\\E0THOSE PUNS ARE&EVEN LESS FUNNY&COMING FROM HER!/",
  "obj_toriel_friendc_96": "* then why are you&  smiling?/",
  "obj_toriel_friendc_98": "IT'S A PITY&SMILE!!!/%%",
  "obj_toriel_friendc_103": "* Frisk^1, do not feel&  left out./",
  "obj_toriel_friendc_104": "* I have been writing&  messages to you as&  well!/",
  "obj_toriel_friendc_105": "\\W* You still have \\Ymy&  phone number\\W after&  all this time.../",
  "obj_toriel_friendc_106": "* Do you not?/%%",
  "obj_toriel_friendc_111": "* Frisk^1, how about&  you go look around&  before we all go?/",
  "obj_toriel_friendc_112": "* Seeing how many good&  friends you've made&  here.../",
  "obj_toriel_friendc_113": "* I am almost certain&  you must have made&  some more./%%",
  "obj_torielboss_366": " .....",
  "obj_torielboss_367": " .....& .....",
  "obj_torielboss_368": " .....& .....& .....",
  "obj_torielboss_369": " ...?",
  "obj_torielboss_370": " What are& you& doing?",
  "obj_torielboss_371": " Attack& or run& away!",
  "obj_torielboss_372": " What are& you& proving& this way?",
  "obj_torielboss_373": " Fight me& or& leave!",
  "obj_torielboss_374": " Stop it.",
  "obj_torielboss_376": " Stop& looking& at me& that way.",
  "obj_torielboss_377": " Go away!",
  "obj_torielboss_378": " ...",
  "obj_torielboss_380": " ...& ...",
  "obj_torielboss_388": "I know you want&to go home^1, but...",
  "obj_torielboss_390": "But please... go&upstairs now.",
  "obj_torielboss_391": "I promise I will&take good care&of you here.",
  "obj_torielboss_392": "I know we do not&have much^1, but...",
  "obj_torielboss_393": "We can have a&good life here.",
  "obj_torielboss_395": "Why are you&making this so&difficult?",
  "obj_torielboss_397": "Please^1, go upstairs.",
  "obj_torielboss_399": ".....",
  "obj_torielboss_401": "Ha ha...",
  "obj_torielboss_402": "Pathetic^1, is it not^2?&I cannot save even&a single child.",
  "obj_torielboss_403": "...",
  "obj_torielboss_416": "No^1, I understand./",
  "obj_torielboss_417": "You would just be&unhappy trapped&down here./",
  "obj_torielboss_418": "The RUINS are very&small once you&get used to them./",
  "obj_torielboss_419": "It would not be&right for you to&grow up in a&place like this./",
  "obj_torielboss_420": "My expectations...&My loneliness...&My fear.../",
  "obj_torielboss_421": "For you^1, my child...&I will put them aside./%%",
  "obj_torielboss_445": "\\E0Urgh.../",
  "obj_torielboss_446": "\\E0You are stronger&than I thought.../",
  "obj_torielboss_447": "Listen to me^1,& small one.../",
  "obj_torielboss_448": "If you go beyond&this door,/",
  "obj_torielboss_449": "Keep walking as&far as you can./",
  "obj_torielboss_450": "Eventually you will&reach an exit./",
  "obj_torielboss_451": "\\E1..^1.&..../",
  "obj_torielboss_452": "\\RASGORE\\X..^1.&Do not let \\RASGORE\\X &take your soul./",
  "obj_torielboss_453": "His plan&cannot be allowed&to succeed./",
  "obj_torielboss_454": "\\E2....../",
  "obj_torielboss_455": "Be good^1,&won't you?/",
  "obj_torielboss_456": "\\E3My child.      %%",
  "obj_torielboss_460": "Y... you...&really hate me&that much?/",
  "obj_torielboss_461": "Now I see who I&was protecting by&keeping you here./",
  "obj_torielboss_462": "Not you.../",
  "obj_torielboss_463": "\\E5But them!/",
  "obj_torielboss_464": "\\E3Ha... ha... %%",
  "obj_torielboss_469": "\\E4You.../",
  "obj_torielboss_470": "... at my most&vulnerable&moment.../",
  "obj_torielboss_471": "To think I was&worried you&wouldn't fit&in out there.../",
  "obj_torielboss_472": "\\E5Eheheheh!!!&You really are&no different than&them!/",
  "obj_torielboss_473": "\\E3Ha... ha... %%",
  "obj_torielboss_803": "* Toriel prepares a magical&  attack.",
  "obj_torielboss_804": "* Toriel looks through you.",
  "obj_torielboss_805": "* Toriel is acting aloof.",
  "obj_torielboss_806": "* Toriel takes a deep breath.",
  "obj_torielboss_809": "* ...",
  "obj_torielboss_834": "* TORIEL - ATK 80 DEF 80&* Knows best for you./^",
  "obj_torielboss_843": "* You couldn't think of&  any conversation&  topics./^",
  "obj_torielboss_847": "* You tried to think&  of something to say&  again^1, but.../^",
  "obj_torielboss_848": "* Ironically^1, talking does not&  seem to be the solution&  to this situation./^",
  "obj_torielboss_850": "* You thought about telling&  Toriel that you saw&  her die./",
  "obj_torielboss_851": "* But...&* That's creepy./",
  "obj_torielboss_852": "* Can you show mercy without&  fighting or running&  away...?/^",
  "obj_torielboss_854": "* Can you show mercy&  without running away...?/^",
  "obj_torielboss_855": "* Not worth talking to./^",
  "obj_torielcall1_90": "* Ring..\\E0.\\TT /",
  "obj_torielcall1_91": "\\F1 %",
  "obj_torielcall1_92": "* Hello?&* This is TORIEL./",
  "obj_torielcall1_93": "\\E1* You have not left&  the room^1, have you?/",
  "obj_torielcall1_94": "* There are a few puzzles&  ahead that I have&  yet to explain./",
  "obj_torielcall1_95": "* It would be dangerous&  to try to solve them&  yourself./",
  "obj_torielcall1_96": "* Be good^1, alright?/",
  "obj_torielcall1_97": "\\TS \\F0 \\T0 %",
  "obj_torielcall1_98": "* Click.../%%",
  "obj_torielcall1_102": "* Ring..\\E1.\\TT /",
  "obj_torielcall1_103": "\\F1 %",
  "obj_torielcall1_104": "* Hello^1? Hello^1?&* This is TORIEL./",
  "obj_torielcall1_105": "* My apologies^1.&* A strange dog&  kidnapped my phone./",
  "obj_torielcall1_106": "* So if you called^1, I&  could not have helped&  you./",
  "obj_torielcall1_107": "\\E0* However^1, I have&  recovered it./",
  "obj_torielcall1_108": "* And you are still in&  that room^1, are you not?/",
  "obj_torielcall1_109": "* What a good child you&  are./",
  "obj_torielcall1_110": "\\E1* There are a few puzzles&  ahead that I have&  yet to explain./",
  "obj_torielcall1_111": "* It would be dangerous&  to try to solve them&  yourself./",
  "obj_torielcall1_112": "\\E1* Be good^1, alright?/",
  "obj_torielcall1_113": "\\TS \\F0 \\T0 %",
  "obj_torielcall1_114": "* Click.../%%",
  "obj_torielcall3_88": "* Ring..\\E0.\\TT /",
  "obj_torielcall3_89": "\\F1 %",
  "obj_torielcall3_90": "* Hello?&* This is TORIEL./",
  "obj_torielcall3_91": "\\E1* You do not DISLIKE&  butterscotch^1, do you?/",
  "obj_torielcall3_92": "\\E1* You do not DISLIKE&  cinnamon^1, do you?/",
  "obj_torielcall3_93": "* I know what your&  preference is^1, but.../",
  "obj_torielcall3_94": "* Would you turn up your&  nose if you found&  it on your plate?/",
  "obj_torielcall3_95": "* Right^1, right^1, I&  understand./",
  "obj_torielcall3_96": "\\E0* Thank you for being&  patient^1, by the way./",
  "obj_torielcall3_97": "\\TS \\F0 \\T0 %",
  "obj_torielcall3_98": "* Click.../%%",
  "obj_torielcall4_88": "* Ring..\\E0.\\TT /",
  "obj_torielcall4_89": "\\F1 %",
  "obj_torielcall4_90": "* Hello?/",
  "obj_torielcall4_91": "\\E1* You do not have&  any allergies^1, do&  you?/",
  "obj_torielcall4_92": "* Huh^1?&* Why am I asking?/",
  "obj_torielcall4_93": "\\E0* No reason..^1.&* No reason at all./",
  "obj_torielcall4_94": "\\TS \\F0 \\T0 %",
  "obj_torielcall4_95": "* Click.../%%",
  "obj_torielcall5_90": "* Ring..\\E0.\\TT /",
  "obj_torielcall5_91": "\\F1 %",
  "obj_torielcall5_92": "* Hello?/",
  "obj_torielcall5_93": "\\E1* I just realized that it&  has been a while since&  I have cleaned up./",
  "obj_torielcall5_94": "\\E0* I was not expecting to&  have company so soon./",
  "obj_torielcall5_95": "* There are probably a lot&  of things lying about&  here and there./",
  "obj_torielcall5_96": "* You can pick them up^1,&  but do not carry more&  than you need./",
  "obj_torielcall5_97": "* Someday you might see&  something you really&  like./",
  "obj_torielcall5_98": "* You will want to leave&  room in your pockets&  for that./",
  "obj_torielcall5_99": "\\TS \\F0 \\T0 %",
  "obj_torielcall5_100": "* Click.../%%",
  "obj_torielcall5_104": "* Ring..\\E0.\\TT /",
  "obj_torielcall5_105": "\\F1 %",
  "obj_torielcall5_106": "* Hello?/",
  "obj_torielcall5_107": "\\E1* I have a question./",
  "obj_torielcall5_108": "* You like things other&  than butterscotch or&  cinnamon^1, too.../",
  "obj_torielcall5_109": "* Do you not?/",
  "obj_torielcall5_110": "\\E0* ..^1. oh^1, what am I&  asking./",
  "obj_torielcall5_111": "* I will keep looking./%%",
  "obj_torielcall5_112": "\\TS \\F0 \\T0 %",
  "obj_torielcall5_113": "* Click.../%%",
  "obj_torieltrigger10_77": "* Every human that falls&  down here meets&  the same fate./",
  "obj_torieltrigger10_78": "* I have seen it&  again and again./",
  "obj_torieltrigger10_79": "* They come./",
  "obj_torieltrigger10_80": "* They leave./",
  "obj_torieltrigger10_81": "* They die./",
  "obj_torieltrigger10_82": "* You naive child..^1.&* If you leave the&  RUINS.../",
  "obj_torieltrigger10_83": "\\W* They..^1.&* \\RASGORE\\W..^1.&* Will kill you./",
  "obj_torieltrigger10_84": "* I am only protecting&  you^1, do you understand?/",
  "obj_torieltrigger10_85": "* ... go to your room./%%",
  "obj_torieltrigger11_79": "* Do not try to stop me./",
  "obj_torieltrigger11_80": "* This is your final&  warning./%%",
  "obj_torieltrigger12_86": "\\E0* Goodbye^1, my child./%%",
  "obj_torieltrigger12_149": "\\E2* That is right./",
  "obj_torieltrigger12_150": "* Go upstairs./%%",
  "obj_torieltrigger12_183": "\\E2* If you truly wish to&  leave the RUINS.../",
  "obj_torieltrigger12_184": "* I will not stop you./",
  "obj_torieltrigger12_185": "\\E2* However^1, when you&  leave.../",
  "obj_torieltrigger12_186": "\\E1* Please do not come&  back./",
  "obj_torieltrigger12_187": "\\E2* I hope you understand./%%",
  "obj_torieltrigger12_325": "* You want to leave&  so badly?/",
  "obj_torieltrigger12_326": "\\E6* Hmph./",
  "obj_torieltrigger12_327": "* You are just like&  the others./",
  "obj_torieltrigger12_328": "\\E7* There is only one&  solution to this./",
  "obj_torieltrigger12_329": "* Prove yourself.../",
  "obj_torieltrigger12_330": "* Prove to me you&  are strong enough&  to survive./%%",
  "obj_torieltrigger12_336": "* Prove to me you&  are strong enough&  to survive!/",
  "obj_torieltrigger12_337": "\\E6* ... wait./",
  "obj_torieltrigger12_338": "* ... why are you looking&  at me like that?/",
  "obj_torieltrigger12_339": "* Like you have seen&  a ghost./",
  "obj_torieltrigger12_340": "\\E7* Do you know something&  that I do not?/",
  "obj_torieltrigger12_341": "* No...&* That is impossible./%%",
  "obj_torieltrigger12_346": "* Prove to me that you&  are.../",
  "obj_torieltrigger12_347": "\\E1* Hey^1, let me finish%%",
  "obj_torieltrigger12_353": "* Already?/",
  "obj_torieltrigger12_354": "* What will it take&  for you to learn&  your lesson?/%%",
  "obj_torieltrigger5_185": "* How did you get&  here^1, my child^1?&* Are you hurt?/",
  "obj_torieltrigger5_186": "* Not a scratch..^1.&*\\E0 Impressive^1!&*\\E1 But still.../",
  "obj_torieltrigger5_187": "* There^1, there^1, I will&  heal you./",
  "obj_torieltrigger5_189": "* Who did this to you^2?\\E5 &* You will get an apology./",
  "obj_torieltrigger5_190": "\\E1* I should not have&  left you alone&  for so long./",
  "obj_torieltrigger5_191": "* It was irresponsible&  to try to surprise&  you like this./",
  "obj_torieltrigger5_192": "\\E8* Err.../",
  "obj_torieltrigger5_193": "\\E0* Well^1, I suppose I&  cannot hide it&  any longer./",
  "obj_torieltrigger5_194": "* Come^1, small one!/%%",
  "obj_torieltrigger5_260": "* Oh dear^1, that took&  longer than I&  thought it would./%%",
  "obj_torieltrigger6_39": "* Do you smell that^1?/",
  "obj_torieltrigger6_40": "* Surprise!/",
  "obj_torieltrigger6_41": "* It is a butterscotch-&  cinnamon pie./",
  "obj_torieltrigger6_42": "* I thought we might&  celebrate your&  arrival./",
  "obj_torieltrigger6_43": "* I want you to have&  a nice time living&  here./",
  "obj_torieltrigger6_44": "* So I will hold off&  on snail pie for&  tonight./",
  "obj_torieltrigger6_45": "* Here^1, I have another&  surprise for you./%%",
  "obj_torieltrigger6_49": "* Do you smell that^1?/",
  "obj_torieltrigger6_50": "\\E1* Er^1, I assume that&  expression means you&  do./",
  "obj_torieltrigger6_51": "\\E0* S..^1. surprise!/",
  "obj_torieltrigger6_52": "* I have baked a snail&  pie./",
  "obj_torieltrigger6_53": "* I thought we might&  celebrate your&  arrival./",
  "obj_torieltrigger6_54": "* I want you to have&  a nice time living&  here./",
  "obj_torieltrigger6_55": "\\E1* So I.../",
  "obj_torieltrigger6_56": "\\E0* Here^1, I have another&  surprise for you./%%",
  "obj_torieltrigger7_41": "* This is it.../%%",
  "obj_torieltrigger7_77": "* Is something burning...?&* Um^1, make yourself&  at home!/%%",
  "obj_torieltrigger7_243": "* A room of your own.&* I hope you like it!/%%",
  "obj_torieltrigger8_77": "* I think you should&  play upstairs&  instead./%%",
  "obj_torieltrigger8_78": "* It is dangerous&  to play here./%%",
  "obj_torieltrigger8_79": "* It is drafty here.&* You will catch&  a cold./%%",
  "obj_torieltrigger8_80": "* It is dusty here.&* You will catch&  a cough./%%",
  "obj_torieltrigger8_81": "* There is nothing&  to see here./%%",
  "obj_torieltrigger8_82": "* Do you want to&  read a book?/%%",
  "obj_torieltrigger8_83": "\\E7* I do not like&  the game you&  are playing./%%",
  "obj_torieltrigger8_84": "\\E0* Why not go for&  a walk in the&  yard?/%%",
  "obj_torieltrigger8_85": "* Really now./%%",
  "obj_torieltrigger8_86": "\\E4* .../%%",
  "obj_torieltrigger8_90": "* Hey^1, do not go down&  here./",
  "obj_torieltrigger8_91": "* I have something&  to show you&  upstairs./%%",
  "obj_torieltrigger9_77": "* You wish to know how&  to return \"home,\"&  do you not?/",
  "obj_torieltrigger9_78": "* Ahead of us lies the&  end of the RUINS./",
  "obj_torieltrigger9_79": "* A one-way exit to the&  rest of the underground./",
  "obj_torieltrigger9_80": "* I am going to destroy&  it./",
  "obj_torieltrigger9_81": "* No one will ever&  be able to leave&  again./",
  "obj_torieltrigger9_82": "* Now be a good child&  and go upstairs./%%",
  "obj_torinteractable7_82": "* Do not worry about&  me./",
  "obj_torinteractable7_83": "* Someone has to take&  care of these flowers./%%",
  "obj_torinteractable7_93": "* Don't worry about&  me./",
  "obj_torinteractable7_94": "* Someone has to take&  care of these flowers./%%",
  "obj_torinteractable7_99": "* Frisk^1, please leave&  me alone./",
  "obj_torinteractable7_100": "\\E3* I can't come back^1.&* I just can't^1, OK?/%%",
  "obj_torinteractable7_106": "\\E7* I don't want to break&  their hearts all over&  again./",
  "obj_torinteractable7_107": "* It's better if they&  never see me./%%",
  "obj_torinteractable7_113": "\\E7* ... why are you still&  here?/",
  "obj_torinteractable7_114": "* Are you trying to keep&  me company?/",
  "obj_torinteractable7_115": "\\E0* Frisk.../",
  "obj_torinteractable7_116": "* .../",
  "obj_torinteractable7_117": "\\E7* Hey./",
  "obj_torinteractable7_118": "\\E0* Let me ask you a&  question./",
  "obj_torinteractable7_119": "* Frisk..^1.&* Why did you come&  here?/",
  "obj_torinteractable7_120": "* Everyone knows the&  legend^1, right...?/",
  "obj_torinteractable7_121": "* \"Travellers who climb&  Mt. Ebott are said&  to disappear.\"/",
  "obj_torinteractable7_122": "\\E7* .../",
  "obj_torinteractable7_123": "* Frisk./",
  "obj_torinteractable7_124": "*\\E0 Why would you ever&  climb a mountain&  like that?/",
  "obj_torinteractable7_125": "\\E7* Was it foolishness?/",
  "obj_torinteractable7_126": "\\E0* Was it fate?/",
  "obj_torinteractable7_127": "\\E1* Or was it..^1.&* Because you...?/",
  "obj_torinteractable7_128": "\\E7* Well./",
  "obj_torinteractable7_129": "\\E0* Only you know the&  answer^1, don't you...?/%%",
  "obj_torinteractable7_135": "\\E2* I know why \\[C]&  climbed the mountain./",
  "obj_torinteractable7_136": "\\E7* It wasn't for a&  very happy reason./",
  "obj_torinteractable7_137": "\\E2* Frisk^1.&* I'll be honest with&  you./",
  "obj_torinteractable7_138": "\\E7* \\[C] hated humanity./",
  "obj_torinteractable7_139": "\\E2* Why they did^1, they&  never talked about&  it./",
  "obj_torinteractable7_140": "\\E1* But they felt very&  strongly about&  that./%%",
  "obj_torinteractable7_146": "\\E2* Frisk..^1.&* You really ARE different&  from \\[C]./",
  "obj_torinteractable7_147": "\\E0* In fact^1, though you&  have similar^1, uh^1,&  fashion choices.../",
  "obj_torinteractable7_148": "* I don't know why I&  ever acted like you&  were the same person./",
  "obj_torinteractable7_149": "\\E7* Maybe..^1.&* The truth is.../",
  "obj_torinteractable7_150": "\\E1* \\[C] wasn't really&  the greatest person./",
  "obj_torinteractable7_151": "\\E7* While^1, Frisk.../",
  "obj_torinteractable7_152": "\\E0* You're the type of&  friend I wish I&  always had./",
  "obj_torinteractable7_153": "\\E7* So maybe I was kind&  of projecting a&  little bit./",
  "obj_torinteractable7_154": "\\E0* Let's be honest^1.&* I did some weird&  stuff as a flower./%%",
  "obj_torinteractable7_160": "\\E2* There's one last&  thing I feel like&  I should tell you./",
  "obj_torinteractable7_161": "* Frisk^1, when \\[C]&  and I combined our&  SOULs together.../",
  "obj_torinteractable7_162": "* The control over our&  body was actually split&  between us./",
  "obj_torinteractable7_163": "* They were the one&  that picked up their&  own empty body./",
  "obj_torinteractable7_164": "* And then^1, when we&  got to the village.../",
  "obj_torinteractable7_165": "\\E2* They were the one&  that wanted to.../",
  "obj_torinteractable7_166": "\\E1* ... to use our full&  power./",
  "obj_torinteractable7_167": "\\E2* I was the one that&  resisted./",
  "obj_torinteractable7_168": "\\E7* And then^1, because of&  me^1, we.../",
  "obj_torinteractable7_169": "\\E1* Well^1, that's why I&  ended up a flower./",
  "obj_torinteractable7_170": "\\E2* Frisk.../",
  "obj_torinteractable7_171": "* This whole time^1, I've&  blamed myself for&  that decision./",
  "obj_torinteractable7_172": "* That's why I adopted&  that horrible view&  of the world./",
  "obj_torinteractable7_173": "* \"Kill or be killed.\"/",
  "obj_torinteractable7_174": "\\E7* But now..^1.&* After meeting you.../",
  "obj_torinteractable7_175": "\\E0* Frisk^1, I don't regret&  that decision anymore./",
  "obj_torinteractable7_176": "\\E4* I did the right&  thing./",
  "obj_torinteractable7_177": "* If I killed those&  humans.../",
  "obj_torinteractable7_178": "* We would have had to&  wage war against all&  of humanity./",
  "obj_torinteractable7_179": "\\E0* And in the end^1,&  everyone went free^1,&  right?/",
  "obj_torinteractable7_180": "\\E7* I still feel kind&  of sad knowing how&  long it took.../",
  "obj_torinteractable7_181": "\\E0* ... so maybe it&  wasn't a perfect&  decision./",
  "obj_torinteractable7_182": "* But you can't regret&  hard choices your&  whole life^1, right?/",
  "obj_torinteractable7_183": "\\E7* Well^1, not that I&  have much of a life&  left./",
  "obj_torinteractable7_184": "\\E0* But that's besides&  the point./%%",
  "obj_torinteractable7_190": "* Frisk^1, thank you&  for listening to me./",
  "obj_torinteractable7_191": "* You should really go&  be with your friends&  now^1, OK?/",
  "obj_torinteractable7_192": "* Oh^1, and^1, please.../",
  "obj_torinteractable7_193": "\\E7* In the future^1, if you&  uh^1, see me.../",
  "obj_torinteractable7_194": "* Don't think of it as&  me^1, OK?/",
  "obj_torinteractable7_195": "\\E0* I just want you to&  remember me like this./",
  "obj_torinteractable7_196": "\\E0* Someone that was your&  friend for a little&  while./",
  "obj_torinteractable7_197": "\\E2* Oh^1, and Frisk.../",
  "obj_torinteractable7_198": "\\E0* Be careful in the&  outside world^1, OK?/",
  "obj_torinteractable7_199": "* Despite what everyone&  thinks^1, it's not as&  nice as it is here./",
  "obj_torinteractable7_200": "\\E7* There are a lot of&  Floweys out there./",
  "obj_torinteractable7_201": "\\E2* And not everything can&  be resolved by just&  being nice./",
  "obj_torinteractable7_202": "\\E0* Frisk.../",
  "obj_torinteractable7_203": "* Don't kill^1, and&  don't be killed^1,&  alright?/",
  "obj_torinteractable7_204": "* That's the best you&  can strive for./",
  "obj_torinteractable7_205": "* Well^1, see you./%%",
  "obj_torinteractable7_212": "\\E7* Frisk.../",
  "obj_torinteractable7_213": "\\E6* Don't you have&  anything better to&  do?/%%",
  "obj_torn_note_63": " error/%%",
  "obj_torn_note_67": "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/",
  "obj_torn_note_68": "* \"elevator..^1. lost power..^1.\"&* \"enter the center door...\"/",
  "obj_torn_note_69": "* (That's all you could read.)/%%",
  "obj_torn_note_74": "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/",
  "obj_torn_note_75": "* \"drain..^1. dropped it...\"/",
  "obj_torn_note_76": "* (That's all you could read.)/%%",
  "obj_torn_note_81": "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/",
  "obj_torn_note_82": "* \"cold...\"/",
  "obj_torn_note_83": "* (That's all you could read.)/%%",
  "obj_torn_note_88": "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/",
  "obj_torn_note_89": "* \"curtain...\"/",
  "obj_torn_note_90": "* (That's all you could read.)/%%",
  "obj_torn_note_95": "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/",
  "obj_torn_note_96": "* \"under..^1. sheets...\"/",
  "obj_torn_note_97": "* (That's all you could read.)/%%",
  "obj_townnpc_bear1_70": "* This town doesn't have a&  mayor./",
  "obj_townnpc_bear1_71": "* But if there's ever a problem^1,&  a skeleton will tell a fish&  lady about it./",
  "obj_townnpc_bear1_72": "* Thaaaaaat's politics!/%%",
  "obj_townnpc_bear1_73": "* Politics./%%",
  "obj_townnpc_bear1_77": "* What if I ran for mayor...?/",
  "obj_townnpc_bear1_78": "* I don't think I would do&  a good job^1, and I hate&  responsibility.../",
  "obj_townnpc_bear1_79": "* But I love politics^1.&* So I might be a perfect&  match./%%",
  "obj_townnpc_bear1_85": "* I heard Dr. Alphys told&  the king and queen the&  awful things she'd done./",
  "obj_townnpc_bear1_86": "* The king felt so bad&  that he didn't know^1.&* He gave her a big hug./",
  "obj_townnpc_bear1_87": "* Then the queen fired her./",
  "obj_townnpc_bear1_88": "* Now we don't have a Royal&  Scientist anymore.../",
  "obj_townnpc_bear1_89": "* Thaaaaat's politics!/%%",
  "obj_townnpc_bear1_93": "* Too bad there are no&  politics on the surface./%%",
  "obj_townnpc_bear1_99": "* Hmmm^1, usually that skeleton&  goes to meet with Undyne&  about now./",
  "obj_townnpc_bear1_100": "* Where is he...^1?&* I can feel our political&  system crumbling apart.../%%",
  "obj_townnpc_beartree_70": "* Awful teens tormented&  a local monster by decorating&  its tree-like horns./",
  "obj_townnpc_beartree_71": "* So we started giving that&  monster presents to make it&  feel better./",
  "obj_townnpc_beartree_72": "* Now it's a tradition to put&  presents underneath a decorated&  tree./%%",
  "obj_townnpc_beartree_74": "* Guess it was a good thing&  those teens tormented that&  monster...?/%%",
  "obj_townnpc_beartree_78": "* Hmm^1?&* Adjusting the presents is&  my responsibility./",
  "obj_townnpc_beartree_79": "* Nah^1, to be honest^1, I&  just keep looking to see&  if I've gotten one.../%%",
  "obj_townnpc_beartree_84": "* It'll be nice to show humans&  our presents-under-the-tree&  tradition./",
  "obj_townnpc_beartree_85": "* They'll probably be weirded&  out by it./%%",
  "obj_townnpc_beartree_90": "* You know what's cute?/",
  "obj_townnpc_beartree_91": "* Those two married dogs&  always put presents under&  the tree for each other./",
  "obj_townnpc_beartree_92": "* It's always the same^1.&* A single bone./",
  "obj_townnpc_beartree_93": "* But every time^1, they act&  like it's the first time&  they've gotten it./",
  "obj_townnpc_beartree_94": "* Then Papyrus comes to take&  his bones back./",
  "obj_townnpc_beartree_95": "* Anyway^1, where are those&  two...?/%%",
  "obj_townnpc_beartree_100": "* That's strange^1.&* There was a present here&  for Papyrus.../",
  "obj_townnpc_beartree_101": "* Now it's gone^1.&* Did someone steal it?/%%",
  "obj_townnpc_bunboy_70": "* That lady over there.../",
  "obj_townnpc_bunboy_71": "* Something about her disturbs&  me./%%",
  "obj_townnpc_bunboy_72": "* I think I've figured it out^1.&* ... no^1, nevermind./%%",
  "obj_townnpc_bunboy_76": "* That lady over there's&  been going for a walk&  for a while now./",
  "obj_townnpc_bunboy_77": "* ... but she hasn't moved&  an inch from where she's&  standing./",
  "obj_townnpc_bunboy_78": "* W-well^1, I haven't either^1,&  but I don't want her to&  notice me over here.../%%",
  "obj_townnpc_bunboy_83": "* Uhhh.../",
  "obj_townnpc_bunboy_84": "* Is anyone else weirded out&  by those giant shambling&  amalgamates^1, or...?/%%",
  "obj_townnpc_bunboy_85": "* ....../%%",
  "obj_townnpc_bunboy_90": "* That lady over there&  seems happy today./",
  "obj_townnpc_bunboy_91": "* Don't know why^1, but it's&  sending shivers down my&  spine.../%%",
  "obj_townnpc_bunlady_70": "* Isn't my little Cinnamon&  just the cutest?/",
  "obj_townnpc_bunlady_71": "* Bun-buns are so adorable..^1.&* Tee hee!/%%",
  "obj_townnpc_bunlady_73": "* Bun-bun-bun-bun-bun.../%%",
  "obj_townnpc_bunlady_77": "* Huh^1? Yes^1, I'm taking&  my bunny for a walk./",
  "obj_townnpc_bunlady_78": "* It's just a very slow one./%%",
  "obj_townnpc_bunlady_83": "* That kid over there told&  me that it's weird that&  I have a pet bunny./",
  "obj_townnpc_bunlady_84": "* First^1, there'd be nothing&  weird about it^1.&* It's cute!/",
  "obj_townnpc_bunlady_85": "* Second..^1.&* What?/",
  "obj_townnpc_bunlady_86": "* It's normal to walk your&  younger brother on a&  leash^1, right?/%%",
  "obj_townnpc_bunlady_91": "* Ah^1, it's so peaceful&  and quiet.../",
  "obj_townnpc_bunlady_92": "* Usually one of those dogs&  chases my little Cinnamon&  around./%%",
  "obj_townnpc_bunlady_97": "* Ah^1, it's so peaceful&  and quiet.../",
  "obj_townnpc_bunlady_98": "* Usually one of those&  skeletons chases my little&  Cinnamon around./%%",
  "obj_townnpc_hatescity_70": "* The capital's getting pretty&  crowded^1, so I've heard they're&  going to start moving here./",
  "obj_townnpc_hatescity_71": "* Hmmm..^1.&* I don't want to see the&  erasure of our local culture./",
  "obj_townnpc_hatescity_72": "* But I definitely want to see&  some city slickers slip onto&  their butts!/%%",
  "obj_townnpc_hatescity_73": "* Yeah^1, bring 'em on!/%%",
  "obj_townnpc_hatescity_77": "* What will happen to&  Grillby's if everyone&  moves in...?/",
  "obj_townnpc_hatescity_78": "* We're gonna have to have&  chairs to the ceiling./%%",
  "obj_townnpc_hatescity_83": "* Hey^1! People won't have to&  move in from the city&  anymore!/",
  "obj_townnpc_hatescity_84": "* Seems like we won't have&  to lose our local culture./",
  "obj_townnpc_hatescity_85": "* ... except we're all moving&  out of here^1, huh./",
  "obj_townnpc_hatescity_86": "* Oh well^1. Guess it can't be&  all punk-peaches and punk-&  cream./%%",
  "obj_townnpc_hatescity_91": "* The capital's getting pretty&  crowded^1, so I've heard they're&  going to start moving here./",
  "obj_townnpc_hatescity_92": "* ... who knows^1.&* Maybe we'll have room./%%",
  "obj_townnpc_icewolf_71": "* Ice Wolf no longer has to&  throw Ice./",
  "obj_townnpc_icewolf_72": "* Ice Wolf can take a break to&  buy some pants now./%%",
  "obj_townnpc_icewolf_74": "* Ice Wolf thinking of changing&  their name to Jimmy Hotpants./%%",
  "obj_townnpc_innlady_114": "* Error./%%",
  "obj_townnpc_innlady_199": "* Hiya^1!&* You look like you&  had a great sleep./",
  "obj_townnpc_innlady_200": "* Which is incredible^1, because&  you were only up there for&  about two minutes.../",
  "obj_townnpc_innlady_203": "* Here's your money back^1.&* You can pay me if you're&  going to stay overnight./%%",
  "obj_townnpc_innlady_207": "* Feel free to come back&  if you get tired./%%",
  "obj_townnpc_monsterkid1_80": "* Yo^1!&* You're a kid too^1, right?/",
  "obj_townnpc_monsterkid1_81": "* I can tell 'cause you're&  wearing a striped shirt./%%",
  "obj_townnpc_monsterkid1_82": "* I wonder if that weird skeleton&  is an adult or a kid./%%",
  "obj_townnpc_monsterkid1_88": "* Yo..^1.&* There you are!/",
  "obj_townnpc_monsterkid1_89": "* I've been kinda worried&  about you since you&  ran away./",
  "obj_townnpc_monsterkid1_90": "* ... but now I'm just kinda&  mad^1, ha ha./",
  "obj_townnpc_monsterkid1_91": "* If Undyne hadn't saved me^1,&  that woulda been bad.../%%",
  "obj_townnpc_monsterkid1_93": "* .../%%",
  "obj_townnpc_monsterkid1_97": "* Yo..^1.&* Uh.../",
  "obj_townnpc_monsterkid1_98": "* Don't talk to me./%%",
  "obj_townnpc_monsterkid1_100": "* .../%%",
  "obj_townnpc_monsterkid1_104": "* Yo!!^1!&* What's up!?/",
  "obj_townnpc_monsterkid1_105": "* I've been kinda^1, doing&  some thinking.../",
  "obj_townnpc_monsterkid1_106": "* Maybe Undyne...&* Isn't actually as cool as&  we thought./",
  "obj_townnpc_monsterkid1_107": "* She's just kinda..^1. mean./",
  "obj_townnpc_monsterkid1_108": "* But YO!!^1!&* I just found out about&  someone WAYYY cooler!!!/",
  "obj_townnpc_monsterkid1_109": "* Nyeh heh heh!!!/%%",
  "obj_townnpc_monsterkid1_111": "* Nyeh heh heh^1, dude./%%",
  "obj_townnpc_monsterkid1_117": "* Yo^1, everyone ran away and&  hid somewhere./",
  "obj_townnpc_monsterkid1_118": "* Man^1, adults can be so&  dumb sometimes^1, haha.../",
  "obj_townnpc_monsterkid1_119": "* Don't they know we've&  got Undyne to protect us!?/%%",
  "obj_townnpc_monsterkid1_122": "* Yo^1!&* Are you sneaking out to&  see her^1, too?/",
  "obj_townnpc_monsterkid1_123": "* Awesome..^1.&* She's the coolest^1, right!?/",
  "obj_townnpc_monsterkid1_124": "* I wanna be just like her&  when I grow up.../",
  "obj_townnpc_monsterkid1_125": "* Hey^1, don't tell my parents&  I'm here^1.&* Ha ha./%%",
  "obj_townnpc_monsterkid1_127": "* OK^1, I'm ready when you&  are./%%",
  "obj_townnpc_monsterkid1_129": "* Yo^1!&* Where were you going...?/",
  "obj_townnpc_monsterkid1_130": "* My parents didn't tell you&  to come here^1, did they?/%%",
  "obj_townnpc_monsterkid1_132": "* You know where you're&  going^1, right...?/",
  "obj_townnpc_monsterkid1_133": "* I was just gonna follow&  you..^1.&* Ha ha./%%",
  "obj_townnpc_monsterkid1_141": "* Yo^1, this ledge is way&  too steep.../%%",
  "obj_townnpc_monsterkid1_147": "* Hmmm..../%%",
  "obj_townnpc_monsterkid1_161": "* Yo^1, you aren't going to&  be able to climb with&  an umbrella./%%",
  "obj_townnpc_reddemon_70": "* We all know the underground&  has problems^1, but we&  smile anyway./",
  "obj_townnpc_reddemon_71": "* Why?/",
  "obj_townnpc_reddemon_72": "* We can't do anything^1, so&  why be morose about it?/%%",
  "obj_townnpc_reddemon_73": "* Smile smile./%%",
  "obj_townnpc_reddemon_83": "* Maybe I'll try frowning&  for once./",
  "obj_townnpc_reddemon_84": "* ... no^1.&* I just can't do it./%%",
  "obj_townnpc_reddemon_89": "* Oh^1?&* We're free?/",
  "obj_townnpc_reddemon_90": "* Finally..^1.&* I'll be able to stop&  smiling./%%",
  "obj_townnpc_reddemon_95": "* Just now^1, I felt my smile&  falter for a moment./",
  "obj_townnpc_reddemon_96": "* What's wrong?/%%",
  "obj_townnpc_slimedad_70": "* Ah^1, to be young again^1.&* The world sure felt boundless./%%",
  "obj_townnpc_slimedad_74": "* You like to wander^1.&* You must be young./%%",
  "obj_townnpc_slimedad_79": "* Seems like this is the&  beginning of a brand-new^1,&  boundless world.../",
  "obj_townnpc_slimedad_80": "* Wah-ha^1!&* This adventurous spirit^1!&* I'm like a kid again!/",
  "obj_townnpc_slimedad_81": "* And my children are like..^1.&* Double-children./%%",
  "obj_townnpc_slimedad_86": "* I've sent the kids inside./",
  "obj_townnpc_slimedad_87": "* It feels unsafe here today./%%",
  "obj_townnpc_slimedaughter_80": "* You aren't gonna make me&  be the human again^1, are you?/%%",
  "obj_townnpc_slimedaughter_84": "* Can we PLEASE play something&  else...?/%%",
  "obj_townnpc_slimedaughter_89": "* Hmmm..^1.&* When humans play Monsters&  and Humans.../",
  "obj_townnpc_slimedaughter_90": "* Do they just call it&  Humans and Humans?/%%",
  "obj_townnpc_slimeson_75": "* Let's play Monsters and Humans!/%%",
  "obj_townnpc_slimeson_79": "* Let's continue to play&  Monsters and Humans!/%%",
  "obj_townnpc_slimeson_84": "* Now we can play Monsters&  and Humans with REAL humans!/%%",
  "obj_townnpc_unfunny_70": "* Everyone is always laughing&  and cracking jokes^1, trying&  to forget our modern crises.../",
  "obj_townnpc_unfunny_71": "* Dreariness^1.&* Crowding^1.&* Lack of sunlight./",
  "obj_townnpc_unfunny_72": "* I would join them^1, but I'm&  just not very funny./%%",
  "obj_townnpc_unfunny_73": "* At least I'm not making puns./%%",
  "obj_townnpc_unfunny_77": "* Wait^1!&* I've got a joke!/",
  "obj_townnpc_unfunny_78": "* Knock knock!/",
  "obj_townnpc_unfunny_79": "* ... Uh^1.&* That's all I've thought of./%%",
  "obj_townnpc_unfunny_85": "* Looks like I don't have&  to worry about cracking&  jokes anymore./",
  "obj_townnpc_unfunny_86": "* .../",
  "obj_townnpc_unfunny_87": "* I was going to say a joke&  here^1, but I really don't&  have one./%%",
  "obj_townnpc_unfunny_92": "* It just feels like..^1.&* Like everything is getting&  worse and worse./%%",
  "obj_townnpc_weirdfish_72": "* I \"put out a line\" for some&  girls today./",
  "obj_townnpc_weirdfish_73": "* Someone told me that there&  are plenty of fish in the&  sea.../",
  "obj_townnpc_weirdfish_74": "* Well^1, I'm taking that&  seriously./",
  "obj_townnpc_weirdfish_75": "* I'm literally going to make&  out with a fish./%%",
  "obj_townnpc_weirdfish_76": "* I guess I could ask out Undyne^1.&* But I think she likes someone&  already./%%",
  "obj_townnpc_weirdfish_80": "* Did I catch anyone yet^1?&* I can't bear to look.../%%",
  "obj_townnpc_weirdfish_85": "* Sans is the most regular&  regular of all./",
  "obj_townnpc_weirdfish_86": "* He hasn't been showing up&  as much recently though./%%",
  "obj_townnpc_weirdfish_91": "* Where the heck is Sans?/",
  "obj_townnpc_weirdfish_92": "* He told me he had some&  bait I could use./",
  "obj_townnpc_weirdfish_93": "* Though it was probably&  some kind of prank./",
  "obj_townnpc_weirdfish_94": "* But I wanted to know what&  the prank was!/%%",
  "obj_townnpc_weirdfish_99": "* In the end^1, I never caught&  any girls on my fishing&  line./",
  "obj_townnpc_weirdfish_100": "* So kid^1, take it from me.../",
  "obj_townnpc_weirdfish_101": "* Don't try to catch hot&  people with a fishing rod./",
  "obj_townnpc_weirdfish_102": "* (Somewhere^1, you hear a whinny&  of dismay.)/%%",
  "obj_treadmill_event_103": "HEY^1, SANS^1, HAVE&YOU SEEN MY.../",
  "obj_treadmill_event_104": "\\E0OH, HELLO^1.&YOU AREN'T SANS./",
  "obj_treadmill_event_105": "\\E3WAIT A SECOND./",
  "obj_treadmill_event_106": "\\E0WHY WERE YOU USING&A TREADMILL IN&THE DARK?/",
  "obj_treadmill_event_107": "\\E3IS SANS PRANKING&YOU ACROSS TIME&AND SPACE?/",
  "obj_treadmill_event_108": "\\E1I HATE IT WHEN&HE DOES THAT!/",
  "obj_treadmill_event_109": "\\E1HOW IMMATURE CAN&YOU GET?/",
  "obj_treadmill_event_110": "\\E3ALSO^1, HAVE YOU&SEEN MY ACTION&FIGURES?/",
  "obj_treadmill_event_111": "\\E0WAIT^1!&I KNOW WHERE TO&LOOK!!!/",
  "obj_treadmill_event_112": "IN MY COLLECTION^1!&NYEH HEH HEH!!!/",
  "obj_treadmill_event_113": "SOMETIMES^1, I'M A&GENIUS^1.&ALL THE TIME./%%",
  "obj_triswitchevent_120": "* Ring.../",
  "obj_triswitchevent_121": "\\TS \\E3 \\F6 \\TA %",
  "obj_triswitchevent_122": "\\E6* OK^1!&* Now press the third&  one!!!/%%",
  "obj_triswitchevent_123": "\\TS \\F0 \\E0 \\T0 %",
  "obj_triswitchevent_124": "* (Click...)/%%",
  "obj_triswitchevent_147": "\\E1* ............./",
  "obj_triswitchevent_148": "\\E2* ............./",
  "obj_triswitchevent_149": "\\E0* H-h-hey!/",
  "obj_triswitchevent_150": "\\E5* Looks like you!!!^1 &* Only needed to press^1!&* Two of them!!!/",
  "obj_triswitchevent_151": "\\TS \\F0 \\E0 \\T0 %",
  "obj_triswitchevent_152": "* (Click...)/%%",
  "obj_triswitchevent_213": "* Ring.../",
  "obj_triswitchevent_214": "\\TS \\E4 \\F6 \\TA %",
  "obj_triswitchevent_215": "\\E3* H-h-hey^1!&* You did it!/",
  "obj_triswitchevent_216": "\\E4* I was worried I&  messed it up&  there.../",
  "obj_triswitchevent_217": "\\E0* But I guess we&  make a pretty good&  team!/%%",
  "obj_triswitchevent_218": "\\TS \\F0 \\E0 \\T0 %",
  "obj_triswitchevent_219": "* (Click...)/%%",
  "obj_truechara_94": "Greetings./",
  "obj_truechara_95": "I^2 am \\[C]./%%",
  "obj_truechara_111": "Thank you./",
  "obj_truechara_112": "Your power awakened&me from death./",
  "obj_truechara_113": "My \"human soul.\"/",
  "obj_truechara_114": "My \"determination.\"/",
  "obj_truechara_115": "They were not mine^1,&but YOURS./",
  "obj_truechara_116": "At first^1, I&was so confused./",
  "obj_truechara_117": "Our plan had failed^1,&hadn't it?/",
  "obj_truechara_118": "Why was I brought&back to life?/",
  "obj_truechara_119": ".../",
  "obj_truechara_120": "You./",
  "obj_truechara_121": "With your guidance./",
  "obj_truechara_122": "I realized the purpose&of my reincarnation./",
  "obj_truechara_123": "Power./",
  "obj_truechara_124": "Together^1, we eradicated&the enemy and became&strong./",
  "obj_truechara_125": "HP. ATK. DEF.&GOLD. EXP. LV./",
  "obj_truechara_126": "Every time a number&increases^1, that&feeling.../",
  "obj_truechara_127": "That's me./",
  "obj_truechara_128": "\"\\[C].\"/",
  "obj_truechara_129": "Now./",
  "obj_truechara_130": "Now, we have reached&the absolute./",
  "obj_truechara_131": "There is nothing&left for us here./",
  "obj_truechara_132": "Let us erase this&pointless world^1, and&move on to the next./%%",
  "obj_truechara_136": "\"\\[C].\"/",
  "obj_truechara_137": "The demon that comes&when people call&its name./",
  "obj_truechara_138": "It doesn't matter when./",
  "obj_truechara_139": "It doesn't matter where./",
  "obj_truechara_140": "Time after time,&I will appear./",
  "obj_truechara_141": "And, with your help./",
  "obj_truechara_142": "We will eradicate the&enemy and become&strong./",
  "obj_truechara_143": "HP. ATK. DEF.&GOLD. EXP. LV./",
  "obj_truechara_144": "Every time a number&increases^1, that&feeling.../",
  "obj_truechara_145": "That's me./",
  "obj_truechara_146": "\"\\[C].\"/",
  "obj_truechara_147": ".../",
  "obj_truechara_148": "But./",
  "obj_truechara_149": "You and I are not&the same^1, are we?/",
  "obj_truechara_150": "This SOUL resonates&with a strange&feeling./",
  "obj_truechara_151": "There is a reason&you continue to&recreate this world./",
  "obj_truechara_152": "There is a reason&you continue to&destroy it./",
  "obj_truechara_153": "You./",
  "obj_truechara_154": "You are wracked with&a perverted&sentimentality./",
  "obj_truechara_155": "Hmm./",
  "obj_truechara_156": "I cannot understand&these feelings&any more./",
  "obj_truechara_157": "Despite this./",
  "obj_truechara_158": "I feel obligated to&suggest./",
  "obj_truechara_159": "Should you choose to&create this world&once more./",
  "obj_truechara_160": "Another path would&be better suited./",
  "obj_truechara_161": "Now, partner./",
  "obj_truechara_162": "Let us send this&world back into the&abyss./%%",
  "obj_truechara_186": "Right^1. You are a&great partner./",
  "obj_truechara_187": "We'll be together&forever^1, won't we?/%%",
  "obj_truechara_209": "No...?/",
  "obj_truechara_210": "Hmm.../",
  "obj_truechara_211": "How curious./",
  "obj_truechara_212": "You must have&misunderstood./",
  "obj_truechara_213": "SINCE WHEN WERE YOU&THE ONE IN CONTROL?/%%",
  "obj_truechara_217": "No...?/",
  "obj_truechara_218": "Hmm...&This feeling you have./",
  "obj_truechara_219": "This is what I&spoke of./",
  "obj_truechara_220": "Unfortunately,&regarding this.../",
  "obj_truechara_221": "YOU MADE YOUR CHOICE&LONG AGO./%%",
  "obj_tsunderplane_235": "It's not&like I&LIKE&you.",
  "obj_tsunderplane_236": "Id...&Idiot!",
  "obj_tsunderplane_237": "Hmph!&Don't&get in&my way.",
  "obj_tsunderplane_238": ">_<...&Human&...",
  "obj_tsunderplane_242": "...&H-human&...&...?",
  "obj_tsunderplane_243": "Id...&Idiot!",
  "obj_tsunderplane_250": "Eeeeh?&H-human&...?",
  "obj_tsunderplane_251": "Human,&I...",
  "obj_tsunderplane_256": "Huh!?&Y-you&sicko!",
  "obj_tsunderplane_257": "Ah...&Is that&true...?",
  "obj_tsunderplane_262": "No way!&Why&would I&like YOU",
  "obj_tsunderplane_263": "Human,&I...",
  "obj_tsunderplane_266": "%%%",
  "obj_tsunderplane_465": "* Tsunderplane looks over^1,&  then turns up its nose.",
  "obj_tsunderplane_466": "* Tsunderplane shakes its&  nose dimissively at you.",
  "obj_tsunderplane_467": "* Tsunderplane \"accidentally\"&  bumps you with its wing.",
  "obj_tsunderplane_468": "* Tsunderplane gives you a&  condescending barrel roll.",
  "obj_tsunderplane_469": "* Smells like an airport&  perfume counter.",
  "obj_tsunderplane_470": "* Tsunderplane is looking away&  shyly.",
  "obj_tsunderplane_471": "* Tsunderplane's body is smoking.",
  "obj_tsunderplane_490": "* TSUNDERPLANE - ATK 25 DEF 26&* Seems mean^1, but does&  it secretly like you?/^",
  "obj_tsunderplane_499": "* You tell Tsunderplane it has&  an impressive wingspan./^",
  "obj_tsunderplane_501": "* You tell Tsunderplane it has&  an impressive wingspan./^",
  "obj_tsunderplane_502": "* You tell Tsunderplane it has&  nice turbines./^",
  "obj_tsunderplane_503": "* You tell Tsunderplane it has&  a powerful rudder./^",
  "obj_tsunderplane_504": "* You tell Tsunderplane that&  you like its taste in&  movies and books./^",
  "obj_tsunderplane_505": "* You tell Tsunderplane that&  it has cute winglets./^",
  "obj_tsunderplane_515": "* You get close to Tsunderplane^1.&* But not too close./^",
  "obj_tsunderplanenpc_75": "* Hey^1!&* Watch where you stand^1,&  jerk!/",
  "obj_tsunderplanenpc_76": "* Th-though^1, I guess if&  there's nowhere else^1, you&  can stand closer.../%%",
  "obj_tsunderplanenpc_79": "* Standing so spicey./%%",
  "obj_tsunderplanenpc_83": "* A-ah..^1. H-human..^1.&* You're leaving?/",
  "obj_tsunderplanenpc_84": "* I have..^1.&* Something to say to you./",
  "obj_tsunderplanenpc_85": "* Admittedly^1, I may have had&  limerent feelings for you&  before./",
  "obj_tsunderplanenpc_86": "* However^1, upon examining my&  own actions^1, I now&  realize.../",
  "obj_tsunderplanenpc_87": "* I did not love YOU./",
  "obj_tsunderplanenpc_88": "* I was merely infatuated&  with the CONCEPT of love./",
  "obj_tsunderplanenpc_89": "* The idea of romance^1, the&  concept of sharing affection&  with another.../",
  "obj_tsunderplanenpc_90": "* Through these desires^1, I&  built a false concept of&  you in my head./",
  "obj_tsunderplanenpc_91": "* Such a relationship would&  not have ended well./",
  "obj_tsunderplanenpc_92": "* In closing^1, I believe it&  is better that I chose to&  say nothing./",
  "obj_tsunderplanenpc_93": "* Y..^1. y-you i-idiot./%%",
  "obj_tsunderplanenpc_96": "* I'm not saying it again./%%",
  "obj_tsunderplanenpc_103": "* H-hey^1, why do you keep&  following me!!!&* You jerk!!!/",
  "obj_tsunderplanenpc_104": "* Eeeeh^1?&* You're walking in the&  opposite direction...?/",
  "obj_tsunderplanenpc_105": "* H-hey^1, you think you're too&  good for me^1, huh...?/%%",
  "obj_tsunderplanenpc_107": "* N-not spicey enough for you^1,&  h-huh.../%%",
  "obj_tsunderplanenpc_111": "* I..^1. I'm thinking of going&  to the surface.../",
  "obj_tsunderplanenpc_112": "* Eeeeeh^1?&* You're going to go there&  too?/",
  "obj_tsunderplanenpc_113": "* Idiot..^1.&* Quit following me!/%%",
  "obj_umbrellabox_62": "* NO!/%%",
  "obj_umbrellabox_135": "* (The cavern is too narrow&  for an umbrella.)/%%",
  "obj_undyne1_154": "\\TP %",
  "obj_undyne1_155": "\\M5H..^1. HI^1, UNDYNE!&I'M HERE WITH MY&DAILY REPORT.../",
  "obj_undyne1_156": "UHHH... REGARDING THAT&HUMAN I CALLED YOU&ABOUT EARLIER.../",
  "obj_undyne1_157": "\\M0I THINK^1, UH...&HOW DO I.../",
  "obj_undyne1_158": "\\M1.\\M6.. HUH^1?&DID I FIGHT THEM?/",
  "obj_undyne1_159": "\\M4Y-YES^1!&OF COURSE I DID!/",
  "obj_undyne1_160": "\\M4I FOUGHT THEM&VALIANTLY!/",
  "obj_undyne1_161": "\\M5...WHAT^1?\\M1 &DID I CAPTURE THEM...?/",
  "obj_undyne1_162": "\\M0W-W-WELL.../",
  "obj_undyne1_163": "\\M1NO./",
  "obj_undyne1_164": "\\M1I TRIED VERY HARD^1,&UNDYNE^1, BUT IN THE&END.../",
  "obj_undyne1_165": "\\M0I FAILED./",
  "obj_undyne1_166": "\\M6... W-WHAT?/",
  "obj_undyne1_167": "\\M1YOU'RE GOING TO TAKE&THE HUMAN'S SOUL&YOURSELF.../",
  "obj_undyne1_168": "\\M5BUT UNDYNE^1, YOU DON'T&H-HAVE TO DESTROY&THEM^1! \\M0YOU SEE.../",
  "obj_undyne1_169": "\\M1YOU SEE.../%%",
  "obj_undyne1_170": "\\M6..^1.&.../",
  "obj_undyne1_171": "... I UNDERSTAND./",
  "obj_undyne1_172": "I'LL HELP YOU IN&ANY WAY I CAN./",
  "obj_undyne1_173": "\\TS %",
  "obj_undyne1_174": "* Click.../%%",
  "obj_undyne1_217": "\\M0.../",
  "obj_undyne1_218": "\\M1... I UNDERSTAND./",
  "obj_undyne1_219": "I'LL HELP YOU IN&ANY WAY I CAN./%%",
  "obj_undyne1_537": "* Yo..^1. did you see the&  way she was staring at&  you...?/",
  "obj_undyne1_538": "* That.../",
  "obj_undyne1_539": "* ... was AWESOME!/",
  "obj_undyne1_540": "* I'm SOOOO jealous!/",
  "obj_undyne1_541": "* What'd you do to get her&  attention...^1?&* Ha ha./",
  "obj_undyne1_542": "* C'mon^1!&* Let's go watch her beat&  up some bad guys!/%%",
  "obj_undyne1_546": "* Yo..^1. did you see the&  way she was staring at&  you...?/",
  "obj_undyne1_547": "* That.../",
  "obj_undyne1_548": "* ... was AWESOME!/",
  "obj_undyne1_549": "* I'm SOOOO jealous!/",
  "obj_undyne1_550": "* She was just standing there&  waiting FOREVER^1, and&  then you just...!!!/",
  "obj_undyne1_551": "* C'mon^1!&* Let's go watch her beat&  up some bad guys!/%%",
  "obj_undyne_echoflower_96": "* Behind you./%%",
  "obj_undyne_echoflower_102": "* You aren't gonna tell my&  parents about this^1, are you?/%%",
  "obj_undyne_echoflower_299": "* Undyne!!^1!&* I'll help you fight!!!/%%",
  "obj_undyne_echoflower_348": "* YO!!!!/",
  "obj_undyne_echoflower_349": "* You did it!!^1!&* Undyne is RIGHT in front&  of you!!!/",
  "obj_undyne_echoflower_350": "* You've got front row seats&  to her fight!!!/%%",
  "obj_undyne_echoflower_388": "* ... wait./",
  "obj_undyne_echoflower_389": "* Who's she fighting???/%%",
  "obj_undyne_echoflower_419": "* H^1-hey!/",
  "obj_undyne_echoflower_420": "* You aren't gonna tell my&  parents about this^1, are you?/%%",
  "obj_undyne_ex_781": "* The wind is howling...",
  "obj_undyne_ex_808": "* UNDYNE THE UNDYING 99ATK 99DEF&* Heroine reformed by her own&  DETERMINATION to save Earth./^",
  "obj_undyne_ex_863": "Damn it.../",
  "obj_undyne_ex_864": "So even THAT&power..^1.&It wasn't enough...?/",
  "obj_undyne_ex_865": ".../",
  "obj_undyne_ex_866": "\\E1Heh.../",
  "obj_undyne_ex_867": "Heheheh.../",
  "obj_undyne_ex_868": "\\E2If you..^1./",
  "obj_undyne_ex_869": "If you think I'm&gonna give up hope^1,&you're wrong./",
  "obj_undyne_ex_870": "Cause I've..^1.&Got my friends&behind me./",
  "obj_undyne_ex_871": "\\E3Alphys told me that&she would watch me&fight you.../",
  "obj_undyne_ex_872": "\\E4And if anything went&wrong^1, she would..^1.&evacuate everyone./",
  "obj_undyne_ex_873": "\\E5By now she's called&ASGORE and told him&to absorb the 6&human SOULs./%%",
  "obj_undyne_ex_881": "And with that&power.../%%",
  "obj_undyne_ex_893": "This world will&live on...!/%%",
  "obj_undyne_friendc_76": "* Hey^1, punk^1!&* What's up!?/",
  "obj_undyne_friendc_77": "\\E1* A-ACHOO!/",
  "obj_undyne_friendc_78": "\\E2* Papyrus^1, how can you&  stand this cold?/",
  "obj_undyne_friendc_80": "I HAVE NO SKIN./",
  "obj_undyne_friendc_82": "* So why don't we&  stand in Grillby's&  instead?/",
  "obj_undyne_friendc_84": "BECAUSE I HATE&GREASE./",
  "obj_undyne_friendc_86": "* But you don't have&  a stomach!!/",
  "obj_undyne_friendc_88": "NO^1, BUT I HAVE&STANDARDS!!!/%%",
  "obj_undyne_friendc_92": "* Papyrus.../",
  "obj_undyne_friendc_93": "\\E1* Why do you live&  in an icy wasteland?/",
  "obj_undyne_friendc_95": "THE RENT'S CHEAP./",
  "obj_undyne_friendc_97": "* Really^1?&* Don't you live in&  a huge house?/",
  "obj_undyne_friendc_99": "YEAH^1, BUT MY&BROTHER PAYS&FOR IT./",
  "obj_undyne_friendc_101": "* Where's your brother&  get the money to&  pay for it...?/",
  "obj_undyne_friendc_103": "OH^1, THAT'S SIMPLE./",
  "obj_undyne_friendc_104": "\\E0IT'S A MYSTERY./%%",
  "obj_undyne_friendc_112": "* So^1? What are you&  waiting for?/",
  "obj_undyne_friendc_113": "* The sooner you get&  it over with^1, the&  better!/%%",
  "obj_undyne_friendc_121": "* Hey^1, you sure&  are carrying a&  lot of things./",
  "obj_undyne_friendc_122": "* If someone needed&  to give you a thing^1,&  they sure couldn't!/%%",
  "obj_undyne_friendc_127": "* What^1?&* You LOST the letter!?/",
  "obj_undyne_friendc_128": "* What the HECK!^1?&* How!^1? Why!?/",
  "obj_undyne_friendc_129": "\\E7* Ughhh..^1.&* This is unbelievable./",
  "obj_undyne_friendc_130": "* I should be really&  disappointed in you./",
  "obj_undyne_friendc_131": "\\E9* But^1, uh^1, to tell&  you the truth^1, I'm&  kind of relieved!/",
  "obj_undyne_friendc_132": "\\E1* While you were gone^1,&  I actually wrote&  a WAY BETTER letter!/",
  "obj_undyne_friendc_133": "\\E6* And this time^1, you&  WON'T lose it!!!/",
  "obj_undyne_friendc_134": "\\E2* I guarantee it!!!/",
  "obj_undyne_friendc_135": "\\TS \\F0 \\T0 %",
  "obj_undyne_friendc_136": "* (You got the Undyne Letter&  EX.)/%%",
  "obj_undyne_friendc_149": "* Hey^1, I have something&  to give you.../",
  "obj_undyne_friendc_150": "\\E2* But you're carrying&  way too much!!!/%%",
  "obj_undyne_friendc_155": "* Um^1, so^1, I have a&  favor to ask you./",
  "obj_undyne_friendc_156": "\\E0* Uuuuh^1, I..^1.&* I need you to deliver&  this letter./",
  "obj_undyne_friendc_157": "\\E9* To Dr. Alphys./",
  "obj_undyne_friendc_158": "\\E1* Huh!^1?&* Why don't I do it&  myself...?/",
  "obj_undyne_friendc_159": "\\E8* ... um^1.&* W-well.../",
  "obj_undyne_friendc_160": "\\E9* I-it's kind of&  personal^1, but we're&  friends..^1. so.../",
  "obj_undyne_friendc_161": "\\E8* I'll t-tell you.../",
  "obj_undyne_friendc_162": "\\E6* Hotland SUUUUCKS!!^1!&* I don't wanna have&  to go over there!!!/",
  "obj_undyne_friendc_163": "\\E3* So here you go./",
  "obj_undyne_friendc_164": "\\TS \\F0 \\T0 %",
  "obj_undyne_friendc_165": "* (You got the Undyne's Letter.)/",
  "obj_undyne_friendc_167": "* Oh^1, and if you&  read it.../",
  "obj_undyne_friendc_168": "\\E2* I'll KILL you./",
  "obj_undyne_friendc_169": "\\E9* Thanks so much^1!&* You're the best!!/%%",
  "obj_undyne_friendc_187": "* Hey^1, Alphys^1!&* Alphys!/",
  "obj_undyne_friendc_188": "\\E1* Do you think we&  can watch something&  with fighting next?/",
  "obj_undyne_friendc_189": "\\E9* Oh^1, and then...&* Something..^1.&* With princesses!?/",
  "obj_undyne_friendc_190": "\\E2* Or FIGHTING&  princesses!?/",
  "obj_undyne_friendc_192": "\\E5* I-I'll see if I&  can manage to find&  any like that^1, Undyne./",
  "obj_undyne_friendc_194": "\\E6* Yayyyyy!/%%",
  "obj_undyne_friendc_199": "\\E0* Hey Frisk^1, why don't&  you go say hi to&  Napstablook?/",
  "obj_undyne_friendc_200": "\\E1* Oh^1, tell them I&  said hi^1, too!/%%",
  "obj_undyne_lettercall_113": "* Ring.../",
  "obj_undyne_lettercall_115": "\\E0* Hey...^1!&* Uh^1, this is&  Undyne.../",
  "obj_undyne_lettercall_116": "\\E2* (Shut up^1, Papyrus^1!)&* (This was YOUR idea!)/",
  "obj_undyne_lettercall_117": "\\E1* HUMAN^1!&* You have to deliver&  something for me!/",
  "obj_undyne_lettercall_118": "\\E9* Uh^1, please?/",
  "obj_undyne_lettercall_119": "\\E0* I'm at Snowdin&  in front of&  Papyrus's./",
  "obj_undyne_lettercall_120": "\\E6* See ya^1, punk!/",
  "obj_undyne_lettercall_121": "\\TS \\F0 \\T0 %",
  "obj_undyne_lettercall_122": "* Click.../%%",
  "obj_undynebattle2_275": "...",
  "obj_undynebattle2_278": "Show me what&you've got!",
  "obj_undynebattle2_282": "Do your worst!",
  "obj_undynebattle2_286": "What's the&matter, scared?",
  "obj_undynebattle2_290": "\\E6What the hell&is the holdup?",
  "obj_undynebattle2_293": "COME ON ALREADY!",
  "obj_undynebattle2_295": "IT'S GETTING&HOT IN HERE!",
  "obj_undynebattle2_299": "%%%",
  "obj_undynebattle2_488": "* Undyne is letting you make&  the first attack.",
  "obj_undynebattle2_520": "* UNDYNE - ATK 41 DEF 21&* This time^1, don't hold&  anything back!/^",
  "obj_undynebattle2_530": "* You pretend to swing at&  UNDYNE with all your might./%%",
  "obj_undynebattle2_578": "I've been&defeated..^1.&My house is in&shambles.../",
  "obj_undynebattle2_579": "I even failed to&befriend you./",
  "obj_undynebattle2_580": "That's it./",
  "obj_undynebattle2_581": "\\E8I don't care if&you're my guest&anymore./",
  "obj_undynebattle2_582": "\\E6One final rematch^1!&All out on both&sides!!!/",
  "obj_undynebattle2_583": "IT'S THE ONLY WAY&I CAN REGAIN MY&LOST PRIDE!!!/",
  "obj_undynebattle2_584": "NOW COME ON^1!&HIT ME WITH&ALL YOU'VE GOT!&NGAHHHH!!!/%%",
  "obj_undynebattle2_599": "* Undyne is letting you make&  the first attack.",
  "obj_undynebattle2_645": "What./",
  "obj_undynebattle2_646": "\\E2That's the best&you can manage?/",
  "obj_undynebattle2_647": "\\E3Even attacking at&full force.../",
  "obj_undynebattle2_648": "You just can't&muster any intent&to hurt me^1,&huh?/",
  "obj_undynebattle2_649": "\\E4.../",
  "obj_undynebattle2_650": "\\E7Heh^1, you know&what?/%%",
  "obj_undynebattle2_670": "I don't actually&want to hurt you&either./",
  "obj_undynebattle2_671": "At first^1, I hated&your stupid&saccharine&schtick^1, but.../",
  "obj_undynebattle2_672": "\\E3The way you hit&me right now^1,&it.../",
  "obj_undynebattle2_673": "\\E4Reminded me of&someone I used&to train with./",
  "obj_undynebattle2_674": "\\E7Now I know you&aren't just some&wimpy loser./",
  "obj_undynebattle2_678": "\\E9You're a wimpy&loser with a&big heart!/",
  "obj_undynebattle2_679": "\\E4Just like him.../",
  "obj_undynebattle2_680": "\\E7.../",
  "obj_undynebattle2_681": "\\E3Listen^1, human./",
  "obj_undynebattle2_682": "\\E2It seems that you&and ASGORE are&fated to fight./",
  "obj_undynebattle2_683": "\\E3But knowing him.../",
  "obj_undynebattle2_684": "\\E4He probably&doesn't want to./",
  "obj_undynebattle2_685": "\\E2Talk to him./",
  "obj_undynebattle2_686": "\\E1I'm sure you can&persuade him to&let you go home./",
  "obj_undynebattle2_687": "\\E3Eventually^1, some&mean human will&fall down here.../",
  "obj_undynebattle2_688": "\\E3And I'll take&THEIR soul instead./",
  "obj_undynebattle2_689": "\\E1That makes sense^1,&right^1?&Fuhuhu./",
  "obj_undynebattle2_690": "\\E2Oh^1, and if you&DO hurt ASGORE.../",
  "obj_undynebattle2_691": "\\E7I'll take the&human souls..^1.&Cross the barrier.../",
  "obj_undynebattle2_692": "\\E6And beat the&hell out of you!/",
  "obj_undynebattle2_693": "\\E9That's what friends&are for^1, right?/",
  "obj_undynebattle2_694": "\\E9Fuhuhu!/",
  "obj_undynebattle2_695": "\\E9Now let's get the&hell out of this&flaming house!/%%",
  "obj_undyneboss_401": "Ngahhh!",
  "obj_undyneboss_402": "Bring&it on!",
  "obj_undyneboss_403": "C'mon!",
  "obj_undyneboss_404": "Fuhuhu!",
  "obj_undyneboss_405": "Ngahh!!",
  "obj_undyneboss_406": "Urahhh!!",
  "obj_undyneboss_410": "\\E1  You're strong...&  But not strong&  enough!",
  "obj_undyneboss_411": "\\E4  You're a pain in&  the neck, huh?",
  "obj_undyneboss_412": "\\E5  DIE ALREADY, YOU&  LITTLE BRAT!",
  "obj_undyneboss_416": "%%%",
  "obj_undyneboss_427": "  \\XAs long as you're&  \\GGREEN\\X you \\RCAN'T&  ESCAPE\\X!/",
  "obj_undyneboss_428": "  \\XUnless you learn&  to \\Rface danger&  head-on\\X.../",
  "obj_undyneboss_429": "  You won't last&  a SECOND against&  ME!/%%",
  "obj_undyneboss_437": "  You^1?&  Sparing ME^1?&  Fuhuhuhu!/",
  "obj_undyneboss_438": "  How insulting^1!&  I'd NEVER&  surrender to the&  likes of you!/%%",
  "obj_undyneboss_439": "  Not bad^1!&  Then how about&  THIS!?/%%",
  "obj_undyneboss_442": "\\E0  I wanted this to&  be a fair fight./",
  "obj_undyneboss_443": "\\E1  I thought if I&  beat you like&  this.../",
  "obj_undyneboss_444": "  It'd truly show&  how strong&  monsters can be./",
  "obj_undyneboss_445": "\\E4  BUT NOW???/",
  "obj_undyneboss_446": "\\E5  I DON'T CARE!/",
  "obj_undyneboss_447": "  I'M NOT YOUR&  FREAKING&  KINDERGARTEN&  TEACHER!/",
  "obj_undyneboss_448": "\\E1  Unless your&  kindergarten&  teacher.../",
  "obj_undyneboss_449": "\\E5  DOES THIS!/%%",
  "obj_undyneboss_459": "\\E5  WHAT ARE YOU&  DOING?/",
  "obj_undyneboss_460": "  JUST FACE&  UPWARDS!!!/",
  "obj_undyneboss_461": "  IT'S NOT HARD!/",
  "obj_undyneboss_462": "\\E0 %%",
  "obj_undyneboss_470": "\\E4  Look./",
  "obj_undyneboss_471": "\\E4  I gave you a&  spear to block&  the bullets with./",
  "obj_undyneboss_472": "\\E4  Do I have to&  explain this&  any more&  clearly?/",
  "obj_undyneboss_473": "\\E0 %%",
  "obj_undyneboss_481": "\\E1  \\XWhen I said&  \\Rface towards&  danger\\X.../",
  "obj_undyneboss_482": "\\E4  I meant face&  towards the&  bullets!/",
  "obj_undyneboss_483": "\\E0 %%",
  "obj_undyneboss_496": "  For years,&  we've dreamed&  of a happy&  ending...",
  "obj_undyneboss_501": "  And now,&  sunlight is&  just within&  our reach!",
  "obj_undyneboss_506": "  I won't let&  you snatch it&  away from&  us!",
  "obj_undyneboss_510": "\\E1  NGAHHH!&  Enough warming&  up!/%%",
  "obj_undyneboss_515": "  Heh...&  You're tough!",
  "obj_undyneboss_519": "  Mercy^1!&  Ha!/",
  "obj_undyneboss_520": "  I still can't&  believe YOU&  want to spare&  ME!/%%",
  "obj_undyneboss_528": "  But even if&  you could&  beat me...",
  "obj_undyneboss_530": "  But even if&  I spared&  YOU...",
  "obj_undyneboss_538": "\\X  No human has&  EVER made it&  past&  \\RASGORE\\X!",
  "obj_undyneboss_546": "  Honestly^1,&  killing you&  now is an act&  of mercy...!",
  "obj_undyneboss_554": "  ...",
  "obj_undyneboss_563": "  Honestly, I'm&  doing you&  a favor...",
  "obj_undyneboss_570": "\\X  No human has&  EVER made it&  past&  \\RASGORE\\X!",
  "obj_undyneboss_577": "\\E1  Killing you&  now is an act&  of mercy!",
  "obj_undyneboss_582": "\\E4  So STOP being&  so damn&  resilient!/%%",
  "obj_undyneboss_587": "  What the&  hell are&  humans made&  out of!?",
  "obj_undyneboss_593": "  Anyone else&  would be DEAD&  by now!",
  "obj_undyneboss_599": "  Alphys told me&  humans were&  determined...",
  "obj_undyneboss_605": "  I see now what&  she meant by&  that!",
  "obj_undyneboss_611": "  But I'm&  determined,&  too!",
  "obj_undyneboss_616": "  Determined to&  end this&  RIGHT NOW!",
  "obj_undyneboss_622": "  ... RIGHT NOW!",
  "obj_undyneboss_628": "  ... RIGHT...&  ...&  ... NOW!!",
  "obj_undyneboss_634": "  Ha...&  Ha...",
  "obj_undyneboss_639": "\\E5  NGAHHH!!!&  DIE ALREADY, YOU&  LITTLE BRAT!/%%",
  "obj_undyneboss_656": "  YOU'RE GETTING&  IN MY WAY!",
  "obj_undyneboss_658": "  I WILL NEVER&  TAKE MERCY FROM&  THE LIKES OF YOU!",
  "obj_undyneboss_664": "  I WILL NOT&  BE DEFEATED!",
  "obj_undyneboss_666": "  YOU! WILL!&  NEVER! SPARE! ME!",
  "obj_undyneboss_672": "\\X  YOU'LL NEVER \\RESCAPE\\X&  FROM ME!!!",
  "obj_undyneboss_682": "  Come on^1, is that&  all you've got!?/%%",
  "obj_undyneboss_686": "  ... pathetic./",
  "obj_undyneboss_687": "  You're going to&  have to try&  harder than that!/%%",
  "obj_undyneboss_691": "  S-see how strong&  we are when we&  believe in&  ourselves?/%%",
  "obj_undyneboss_695": "  H... heh.../",
  "obj_undyneboss_696": "  Had enough yet?/%%",
  "obj_undyneboss_700": "\\E7  .../",
  "obj_undyneboss_701": "  ... I won't..^1.&  ... give up.../%%",
  "obj_undyneboss_705": "\\E7.../%%",
  "obj_undyneboss_1085": "* The wind is howling...",
  "obj_undyneboss_1086": "* Undyne flips her spear&  impatiently.",
  "obj_undyneboss_1087": "* Flower pollen drifts in&  front of you.",
  "obj_undyneboss_1088": "* Water rushes around you.",
  "obj_undyneboss_1089": "* The spears pause for a&  moment.",
  "obj_undyneboss_1094": "* Undyne points heroically&  towards the sky.",
  "obj_undyneboss_1095": "* Undyne flips her spear&  impatiently.",
  "obj_undyneboss_1096": "* Undyne suplexes a huge&  boulder^1, just because&  she can.",
  "obj_undyneboss_1097": "* Undyne bounces impatiently.",
  "obj_undyneboss_1098": "* Undyne flashes a menacing&  smile.",
  "obj_undyneboss_1099": "* Undyne draws her finger&  across her neck.",
  "obj_undyneboss_1100": "* Undyne holds her fist in&  front of her and shakes&  her head.",
  "obj_undyneboss_1101": "* Undyne towers threateningly.",
  "obj_undyneboss_1102": "* Undyne thinks of her friends&  and pounds the ground&  with her fists.",
  "obj_undyneboss_1103": "* Smells like sushi.",
  "obj_undyneboss_1107": "* Undyne's eye is twitching&  involuntarily.",
  "obj_undyneboss_1108": "* Undyne is smashing spears&  on the ground.",
  "obj_undyneboss_1109": "* Undyne's eyes dart around&  to see if this is&  a prank.",
  "obj_undyneboss_1110": "* Undyne is hyperventilating.",
  "obj_undyneboss_1111": "* Smells like angry fish.",
  "obj_undyneboss_1118": "* Undyne is smiling as if&  nothing is wrong.",
  "obj_undyneboss_1119": "* Undyne's body is wavering.",
  "obj_undyneboss_1120": "* Undyne's body is losing&  its shape.",
  "obj_undyneboss_1121": "* Undyne's body...",
  "obj_undyneboss_1122": "* ...",
  "obj_undyneboss_1145": "* UNDYNE - ATK 50 DEF 20&* The heroine that NEVER gives&  up./^",
  "obj_undyneboss_1168": "* You tell UNDYNE her attacks&  are too easy^1.&* She doesn't care./^",
  "obj_undyneboss_1174": "* You tell UNDYNE her attacks&  are too easy^1.&* The bullets get faster./^",
  "obj_undyneboss_1176": "* You tell UNDYNE her attacks&  are too easy^1.&* The bullets get unfair./^",
  "obj_undyneboss_1182": "* Didn't work./^",
  "obj_undyneboss_1195": "* Hamburger Helpers./^",
  "obj_undyneboss_1205": "* You told Undyne you didn't&  want to fight^1.&* But nothing happened./^",
  "obj_undyneboss_1209": "* You told Undyne you just&  want to be friends.&* She remembers someone.../",
  "obj_undyneboss_1210": "* Her attacks became a little&  less extreme./^",
  "obj_undyneboss_1215": "* Didn't work./^",
  "obj_undyneboss_1278": "En guarde!/%%",
  "obj_undyneboss_1281": "\\E1  You won't get&  away from me&  this time!/%%",
  "obj_undyneboss_1286": "\\E4  You've escaped&  from me for&  the LAST time!/%%",
  "obj_undyneboss_1292": "\\E5  STOP RUNNING&  AWAY!!!/%%",
  "obj_undyneboss_1298": "\\E5  COME BACK HERE^1,&  YOU LITTLE&  PUNK!!/%%",
  "obj_undyneboss_1310": "* Undyne attacks!",
  "obj_undyneboss_1336": "Ngahhh.../",
  "obj_undyneboss_1337": "You were stronger...&Than I thought.../",
  "obj_undyneboss_1338": "So then..^1.&... this is where..^1.&... it ends.../",
  "obj_undyneboss_1339": ".../%%",
  "obj_undyneboss_1365": "  No.../%%",
  "obj_undyneboss_1386": "NO!/",
  "obj_undyneboss_1387": "I won't die!/",
  "obj_undyneboss_1388": "Alphys..^1.&Asgore..^1.&Papyrus.../",
  "obj_undyneboss_1389": "Everyone is counting&on me to protect&them!/",
  "obj_undyneboss_1390": "NNNNGAH!/%%",
  "obj_undyneboss_1401": "Human!/",
  "obj_undyneboss_1402": "In the name of&everybody's hopes&and dreams.../",
  "obj_undyneboss_1403": "I WILL DEFEAT YOU!/%%",
  "obj_undyneboss_1410": "* Undyne looks determined.",
  "obj_undyneboss_1424": ".../",
  "obj_undyneboss_1425": "Ha..^1. ha.../",
  "obj_undyneboss_1426": "... Alphys.../",
  "obj_undyneboss_1427": "This is what I&  was afraid of.../",
  "obj_undyneboss_1428": "This is why I&  never told you.../",
  "obj_undyneboss_1429": ".../%%",
  "obj_undyneboss_1438": "No..^1.&No!/",
  "obj_undyneboss_1439": "Not yet!/",
  "obj_undyneboss_1440": "I won't die!/%%",
  "obj_undyneboss_1449": "NGAHHHHHHHH!!^2! %%",
  "obj_undyneboss_1460": " I WON'T DIE^3! %%",
  "obj_undyneboss_1470": " I WON'T DIE^3! %%",
  "obj_undyneboss_1480": " I WON'T DIE^3! %%",
  "obj_undyneboss_1490": " I^2 WON'T^2 %%",
  "obj_undynedate_afterward_114": "* Well^1, that was&  fun^1, huh?/",
  "obj_undynedate_afterward_115": "\\E6* We'll have to hang&  out again another&  time...!/",
  "obj_undynedate_afterward_116": "\\E9* But^1, uh^1, somewhere&  else I guess./",
  "obj_undynedate_afterward_117": "\\E0* In the meantime^1,&  I guess I'll go&  hang with Papyrus./",
  "obj_undynedate_afterward_118": "* So if you need&  me^1, drop by Snowdin^1,&  OK!?/",
  "obj_undynedate_afterward_119": "\\E1* OH^1!&* And if you ever&  need help.../",
  "obj_undynedate_afterward_120": "\\E9* Just give Papyrus a&  ring^1, ok?/",
  "obj_undynedate_afterward_121": "\\E0* Since we're in the&  same spot^1, I'll be&  able to talk too!/",
  "obj_undynedate_afterward_122": "\\E6* Well^1, see ya&  later^1, punk!!/%%",
  "obj_undynedate_afterward_140": "* Well^1, that was&  fun^1, huh?/",
  "obj_undynedate_afterward_141": "\\E6* We'll have to hang&  out again another&  time...!/",
  "obj_undynedate_afterward_142": "\\E9* But^1, uh^1, somewhere&  else I guess./",
  "obj_undynedate_afterward_143": "\\E0* In the meantime^1,&  I guess I'll go&  hang with Papyrus./",
  "obj_undynedate_afterward_144": "* So if you need&  me^1, drop by Snowdin^1,&  OK!?/",
  "obj_undynedate_afterward_145": "\\E1* OH^1!&* And if you ever&  need help.../",
  "obj_undynedate_afterward_146": "\\E9* Just give Papyrus a&  ring^1, ok?/",
  "obj_undynedate_afterward_147": "\\E0* Since we're in the&  same spot^1, I'll be&  able to talk too!/",
  "obj_undynedate_afterward_148": "\\E6* Well^1, see ya&  later^1, punk.../",
  "obj_undynedate_afterward_149": "\\E1* OH!!^1!&* WAIT!!/",
  "obj_undynedate_afterward_150": "\\E0* This is sudden^1, but.../",
  "obj_undynedate_afterward_151": "\\E9* Can you deliver&  something for me?/",
  "obj_undynedate_afterward_152": "\\E0* Papyrus suggested&  that I ask you./",
  "obj_undynedate_afterward_153": "\\E3* But he told me when&  I still hated you^1,&  so.../",
  "obj_undynedate_afterward_154": "\\E1* Uh^1! Anyway!!^1!&* Here^1! Just take it!/",
  "obj_undynedate_afterward_155": "\\TS \\F0 \\T0 %",
  "obj_undynedate_afterward_156": "* (You got the Undyne's&  Letter.)/",
  "obj_undynedate_afterward_158": "* Well^1, what are you&  waiting for!?/",
  "obj_undynedate_afterward_159": "\\E1* Go deliver it!!!/",
  "obj_undynedate_afterward_160": "* .../",
  "obj_undynedate_afterward_161": "\\E9* Uhhhh..^1.&* Oh^1, yeah.../",
  "obj_undynedate_afterward_162": "* It's addressed to&  Dr. Alphys./",
  "obj_undynedate_afterward_163": "\\E6* OK^1, see you!!/%%",
  "obj_undynedate_afterward_169": "* Well^1, that was&  fun^1, huh?/",
  "obj_undynedate_afterward_170": "\\E6* We'll have to hang&  out again another&  time...!/",
  "obj_undynedate_afterward_171": "\\E9* But^1, uh^1, somewhere&  else I guess./",
  "obj_undynedate_afterward_172": "\\E0* In the meantime^1,&  I guess I'll go&  hang with Papyrus./",
  "obj_undynedate_afterward_173": "* So if you need&  me^1, drop by Snowdin^1,&  OK!?/",
  "obj_undynedate_afterward_174": "\\E1* OH^1!&* And if you ever&  need help.../",
  "obj_undynedate_afterward_175": "\\E9* Just give Papyrus a&  ring^1, ok?/",
  "obj_undynedate_afterward_176": "\\E0* Since we're in the&  same spot^1, I'll be&  able to talk too!/",
  "obj_undynedate_afterward_177": "\\E6* Well^1, see ya&  later^1, punk.../",
  "obj_undynedate_afterward_178": "\\E1* OH!!^1!&* WAIT!!/",
  "obj_undynedate_afterward_179": "\\E0* This is sudden^1, but.../",
  "obj_undynedate_afterward_180": "* Can you.../",
  "obj_undynedate_afterward_181": "\\E1* Hey^1, wait^1!&* Your inventory's&  full./",
  "obj_undynedate_afterward_182": "\\E9* Uh^1, well^1, I'll be&  at Papyrus's./",
  "obj_undynedate_afterward_183": "\\E6* Come see me when&  you have less&  stuff!/%%",
  "obj_undynedate_inside_120": "HERE^1, UNDYNE./",
  "obj_undynedate_inside_121": "MY FRIEND BROUGHT&A GIFT FOR YOU^1,&ON THEIR OWN!/%%",
  "obj_undynedate_inside_143": "* Uhhh..^1. thanks./%%",
  "obj_undynedate_inside_177": "* I'll^1, uh^1, put it&  with the others./%%",
  "obj_undynedate_inside_236": "* So are we ready&  to start?/%%",
  "obj_undynedate_inside_250": "WHOOPSY DOOPSY^1!&I JUST REMEMBERED!/",
  "obj_undynedate_inside_251": "I HAVE TO GO&TO THE BATHROOM!!/",
  "obj_undynedate_inside_252": "\\E0YOU TWO HAVE&FUN!!!/%%",
  "obj_undynedate_inside_335": "DANG^1!&WHAT A SHAME.../",
  "obj_undynedate_inside_336": "\\E2I THOUGHT UNDYNE&COULD BE FRIENDS&WITH YOU./",
  "obj_undynedate_inside_337": "\\E3BUT I GUESS.../",
  "obj_undynedate_inside_338": "\\E3I OVERESTIMATED&HER./",
  "obj_undynedate_inside_339": "\\E3SHE'S JUST NOT&UP TO THE&CHALLENGE./%%",
  "obj_undynedate_inside_351": "* CHALLENGE!^1?&* What!?/",
  "obj_undynedate_inside_352": "\\E0* Papyrus^1!&* Wait a second...!/%%",
  "obj_undynedate_inside_367": "* Darnit!/",
  "obj_undynedate_inside_368": "* He thinks I can't&  be friends with&  YOU!?/",
  "obj_undynedate_inside_369": "\\E6* Fuhuhu^1!&* What a joke!/",
  "obj_undynedate_inside_370": "* I could make friends&  with a wimpy loser&  like you any day!/",
  "obj_undynedate_inside_371": "\\E2* I'll show him!/",
  "obj_undynedate_inside_372": "\\E3* Listen up^1, human./",
  "obj_undynedate_inside_373": "\\E2* We're not just&  going to be&  friends./",
  "obj_undynedate_inside_374": "\\E3* We're going to&  be.../",
  "obj_undynedate_inside_375": "\\M1* BESTIES./",
  "obj_undynedate_inside_376": "* I'll make you&  like me so much.../",
  "obj_undynedate_inside_377": "\\E1* You won't be able&  to think of anyone&  else!!!/",
  "obj_undynedate_inside_378": "\\E3* Fuhuhuhu^1!&* It's the PERFECT&  REVENGE!!/",
  "obj_undynedate_inside_379": "* .../",
  "obj_undynedate_inside_380": "\\E9* Why don't you&  have a seat?/%%",
  "obj_undynedate_inside_415": "* Oh^1, leaving so soon?/",
  "obj_undynedate_inside_416": "\\E3* No^1.&* No you're not./%%",
  "obj_undynedate_inside_471": "* Comfortable?/",
  "obj_undynedate_inside_472": "* I'll get you&  something to drink./%%",
  "obj_undynedate_inside_561": "* All set^1!&* What would you like?/%%",
  "obj_undynedate_inside_604": "* HEY!!^1!&* DON'T GET UP!!!/",
  "obj_undynedate_inside_605": "* YOU'RE THE GUEST!^1!&* SIT DOWN AND ENJOY&  YOURSELF!!!/",
  "obj_undynedate_inside_606": "* .../%%",
  "obj_undynedate_inside_614": "\\E9* Um^1, why not just&  point to what you&  want?/",
  "obj_undynedate_inside_615": "* You can use the&  spear!/%%",
  "obj_undynedate_inside_643": "\\E4* Y'know^1, I was a&  pretty hotheaded&  kid./",
  "obj_undynedate_inside_644": "* Once^1, to prove I was&  the strongest^1, I tried&  to fight ASGORE./",
  "obj_undynedate_inside_645": "\\E1* Emphasis on TRIED./",
  "obj_undynedate_inside_646": "\\E0* I couldn't land&  a single blow&  on him!/",
  "obj_undynedate_inside_647": "\\E4* And worse^1, the whole&  time^1, he refused&  to fight back!/",
  "obj_undynedate_inside_648": "\\E7* I was so&  humiliated.../",
  "obj_undynedate_inside_649": "\\E0* Afterwards^1, he&  apologized and said&  something goofy.../",
  "obj_undynedate_inside_650": "* \"Excuse me^1, do you&  want to know how&  to beat me?\"/",
  "obj_undynedate_inside_651": "\\E0* I said yes^1, and&  from then on^1, he&  trained me./",
  "obj_undynedate_inside_652": "\\E4* One day^1, during&  practice^1, I finally&  knocked him down./",
  "obj_undynedate_inside_653": "\\E7* I felt..^1. bad./",
  "obj_undynedate_inside_654": "\\E9* But he was&  beaming.../",
  "obj_undynedate_inside_655": "\\E6* I had never seen&  someone more proud to&  get their butt kicked./",
  "obj_undynedate_inside_656": "\\E1* ... oh!/",
  "obj_undynedate_inside_657": "\\E9* I almost forgot&  about your tea!/",
  "obj_undynedate_inside_658": "* Just a moment!/%%",
  "obj_undynedate_inside_696": "* Wait a second./",
  "obj_undynedate_inside_697": "* Papyrus..^1.&* His cooking lesson.../",
  "obj_undynedate_inside_698": "\\M2* HE WAS SUPPOSED&  TO HAVE THAT RIGHT&  NOW!!!/",
  "obj_undynedate_inside_699": "\\E3* And if HE's not&  here to have it.../",
  "obj_undynedate_inside_700": "\\E2* YOU'LL HAVE TO&  HAVE IT FOR HIM!!!/%%",
  "obj_undynedate_inside_833": "* That's right!!!/",
  "obj_undynedate_inside_834": "\\E1* NOTHING has brought&  Papyrus and I&  closer than cooking!/",
  "obj_undynedate_inside_835": "\\E3* Which means that if&  I give you his&  lesson.../",
  "obj_undynedate_inside_836": "\\E2* WE'LL BECOME CLOSER&  THAN YOU CAN&  EVER IMAGINE!!!/",
  "obj_undynedate_inside_837": "\\E6* Fuhuhu!!^1! Afraid!^1?&* We're gonna be best&  friends!!!/%%",
  "obj_undynedate_inside_1000": "* Ready!^1?&* It's spaghetti time!/",
  "obj_undynedate_inside_1001": "* Let's start with the&  sauce!!/%%",
  "obj_undynedate_inside_1128": "* Uhh^1, we'll just scrape&  this into a bowl&  later./",
  "obj_undynedate_inside_1129": "\\E1* But for NOW!/%%",
  "obj_undynedate_inside_1235": "* Alright^1!&* Now it's time&  to stir the pasta!/",
  "obj_undynedate_inside_1236": "* As a general rule&  of thumb^1, the more&  you stir.../",
  "obj_undynedate_inside_1237": "\\E1* THE BETTER IT IS!/",
  "obj_undynedate_inside_1238": "\\E0* Ready^1?&* Let's do it!/%%",
  "obj_undynedate_inside_1326": "\\M0* Fuhuhuhu^1!&* That's the stuff!/",
  "obj_undynedate_inside_1328": "\\E0* Alright^1, now for&  the final step:/",
  "obj_undynedate_inside_1329": "\\E1* TURN UP THE HEAT!/",
  "obj_undynedate_inside_1330": "\\E0* Let the stovetop&  symbolize your&  passion!/",
  "obj_undynedate_inside_1331": "\\E1* Let your hopes and&  dreams turn into&  burning fire!/",
  "obj_undynedate_inside_1332": "\\E2* READY^1?&* Don't hold anything&  back!!!/%%",
  "obj_undynedate_inside_1444": "* Ah./",
  "obj_undynedate_inside_1445": "* Man^1, no wonder&  Papyrus sucks at&  cooking./%%",
  "obj_undynedate_inside_1465": "* So what's next^1?&* Scrapbooking^1?&* Friendship bracelets?/",
  "obj_undynedate_inside_1466": "* .../%%",
  "obj_undynedate_inside_1475": "* ... oh^1, who am I&  kidding./",
  "obj_undynedate_inside_1476": "* I really screwed this&  up^1, didn't I?/",
  "obj_undynedate_inside_1477": "\\E4* I can't force you to&  like me^1, human./",
  "obj_undynedate_inside_1478": "\\E4* Some people just&  don't get along&  with each other./",
  "obj_undynedate_inside_1479": "\\E7* I understand if&  you feel that&  way about me./",
  "obj_undynedate_inside_1480": "\\E4* And if we can't&  be friends.../",
  "obj_undynedate_inside_1481": "\\E7* That's okay./",
  "obj_undynedate_inside_1482": "\\E7* Because..^1.&* If we're not&  friends.../%%",
  "obj_undynedate_inside_1490": "\\E2*\\M2 IT MEANS I CAN&  DESTROY YOU WITHOUT&  REGRET!/%%",
  "obj_undynedate_inside_1641": "* It'll take a moment&  for the water to&  boil./%%",
  "obj_undynedate_inside_1671": "* Okay^1, it's all&  done!/%%",
  "obj_undynedate_inside_1771": "* Here we are./%%",
  "obj_undynedate_inside_1833": "* Careful^1, it's hot./%%",
  "obj_undynedate_inside_1850": "* It's not THAT hot!^1!&* Just drink it already!/",
  "obj_undynedate_inside_1851": "\\TS \\F0 \\T0 %",
  "obj_undynedate_inside_1852": "* (You take a sip of the&  tea.^1)&* (It's burning...)/",
  "obj_undynedate_inside_1853": "* (But other than that^1,&  it's pretty good.)/",
  "obj_undynedate_inside_1855": "* It's pretty good^1,&  right?/",
  "obj_undynedate_inside_1856": "\\E6* Nothing but the best&  for my ABSOLUTELY&  PRECIOUS FRIEND!!/%%",
  "obj_undynedate_inside_1873": "\\E9* Hey.../",
  "obj_undynedate_inside_1874": "\\E9* You know...&* It's kind of strange&  you chose THAT tea./",
  "obj_undynedate_inside_1875": "\\E4* Golden flower tea.../",
  "obj_undynedate_inside_1876": "\\E0* That's ASGORE's&  favorite kind./",
  "obj_undynedate_inside_1877": "\\E4* Actually^1, now that&  I think about it.../",
  "obj_undynedate_inside_1878": "\\E9* You kind of remind&  me of him./",
  "obj_undynedate_inside_1879": "\\E6* You're both TOTAL&  weenies!!!/",
  "obj_undynedate_inside_1880": "\\E7* ... sort of./%%",
  "obj_undynedate_inside_1898": "\\E4* Y'know^1, I was a&  pretty hotheaded&  kid./",
  "obj_undynedate_inside_1899": "* Once^1, to prove I was&  the strongest^1, I tried&  to fight ASGORE./",
  "obj_undynedate_inside_1900": "\\E1* Emphasis on TRIED./",
  "obj_undynedate_inside_1901": "\\E0* I couldn't land&  a single blow&  on him!/",
  "obj_undynedate_inside_1902": "\\E4* And worse^1, the whole&  time^1, he refused&  to fight back!/",
  "obj_undynedate_inside_1903": "\\E7* I was so&  humiliated.../",
  "obj_undynedate_inside_1904": "\\E0* Afterwards^1, he&  apologized and said&  something goofy.../",
  "obj_undynedate_inside_1905": "* \"Excuse me^1, do you&  want to know how&  to beat me?\"/",
  "obj_undynedate_inside_1906": "\\E0* I said yes^1, and&  from then on^1, he&  trained me./",
  "obj_undynedate_inside_1907": "\\E4* One day^1, during&  practice^1, I finally&  knocked him down./",
  "obj_undynedate_inside_1908": "\\E7* I felt..^1. bad./",
  "obj_undynedate_inside_1909": "\\E9* But he was&  beaming.../",
  "obj_undynedate_inside_1910": "\\E6* I had never seen&  someone more proud to&  get their butt kicked./",
  "obj_undynedate_inside_1911": "\\E4* Anyway^1, long story&  short^1, he kept training&  me.../",
  "obj_undynedate_inside_1912": "\\E0* And now I'm the&  head of the Royal&  Guard!/",
  "obj_undynedate_inside_1913": "\\E6* So I'm the one&  who gets to train&  dorks to fight!/",
  "obj_undynedate_inside_1914": "\\E9* ... like^1, uh^1, Papyrus./%%",
  "obj_undynedate_inside_1935": "\\E4* But^1, um^1, to be&  honest.../",
  "obj_undynedate_inside_1936": "\\E9*... I don't know if.../",
  "obj_undynedate_inside_1937": "\\E7* I can ever let&  Papyrus into the&  Royal Guard./",
  "obj_undynedate_inside_1938": "\\E1* Don't tell him I&  said that!/",
  "obj_undynedate_inside_1939": "\\E4* He's just..^1.&* Well.../",
  "obj_undynedate_inside_1940": "\\E9* I mean^1, it's not&  that he's weak./",
  "obj_undynedate_inside_1941": "\\E1* He's actually&  pretty freaking&  tough!/",
  "obj_undynedate_inside_1942": "\\E7* It's just that..^1.&* He's.../",
  "obj_undynedate_inside_1943": "\\E1* He's too innocent&  and nice!!!/",
  "obj_undynedate_inside_1944": "\\E7* I mean^1, look^1, he&  was SUPPOSED to&  capture you.../",
  "obj_undynedate_inside_1945": "\\E5* And he ended up&  being FRIENDS with&  you instead!/",
  "obj_undynedate_inside_1946": "\\E1* I could NEVER send&  him into battle!/",
  "obj_undynedate_inside_1947": "\\E7* He'd get ripped&  into little smiling&  shreds./",
  "obj_undynedate_inside_1948": "\\E7* That's part of why.../",
  "obj_undynedate_inside_1949": "\\E9* I started teaching&  him how to cook^1,&  you know?/",
  "obj_undynedate_inside_1950": "\\E7* So^1, um^1, maybe he&  can do something&  else with his life./%%",
  "obj_undynedate_inside_1978": "\\E1* Oh^1, sorry^1, I was&  talking for so&  long.../",
  "obj_undynedate_inside_1979": "\\E9* You're out of tea^1,&  aren't you?/",
  "obj_undynedate_inside_1980": "\\E0* I'll get you some&  more./%%",
  "obj_undynedate_outside_155": "PSST./",
  "obj_undynedate_outside_156": "\\E0MAKE SURE TO&GIVE HER THIS!/%%",
  "obj_undynedate_outside_173": "SHE LOVES THESE!/%%",
  "obj_undynedate_outside_241": "* Hi^1, Papyrus!/",
  "obj_undynedate_outside_243": "* Ready for your extra-&  private^1, one-on-one&  training?/",
  "obj_undynedate_outside_245": "YOU BET I AM!/",
  "obj_undynedate_outside_246": "AND I BROUGHT&A FRIEND!/%%",
  "obj_undynedate_outside_276": "* Hi^1, I don't think&  we've.../",
  "obj_undynedate_outside_277": "\\E2* .../",
  "obj_undynedate_outside_278": "\\M9* .../",
  "obj_undynedate_outside_280": "\\M0.../",
  "obj_undynedate_outside_282": "\\E1* Why don't^1.&* You two^1.&* Come in?/%%",
  "obj_undynedate_outside_364": "* (You hear someone shouting&  a whisper at you from&  inside the house.)/",
  "obj_undynedate_outside_366": "NO^1!&YOU CAN'T ESCAPE&FRIENDSHIP!!/%%",
  "obj_undyneencounter2_329": "* Yo..^1. did you see that!?/",
  "obj_undyneencounter2_330": "* Undyne just.../",
  "obj_undyneencounter2_331": "* ... TOUCHED ME!/",
  "obj_undyneencounter2_332": "* I'm never washing my face&  ever again...!/",
  "obj_undyneencounter2_333": "* Man^1, are you unlucky./",
  "obj_undyneencounter2_334": "* If you were standing just&  a LITTLE bit to the left...!/",
  "obj_undyneencounter2_335": "* Yo^1, don't worry^1!&* I'm sure we'll see her&  again!/%%",
  "obj_undyneencounter2_338": "* ... yo^1, did you notice^1?&* She seemed really mad&  about something!/",
  "obj_undyneencounter2_339": "* She looked liked she was&  gonna blast me to pieces!/",
  "obj_undyneencounter2_340": "* But..^1. sigh..^1.&* Then she decided to put&  me down.../",
  "obj_undyneencounter2_341": "* Yo^1!&* There's always next time^1,&  right^1? Let's go!/%%",
  "obj_undyneencounter4_255": "It sounds like it&came from over&here.../",
  "obj_undyneencounter4_256": "Oh^1! You've fallen&down^1, haven't you.../",
  "obj_undyneencounter4_257": "Are you okay?/",
  "obj_undyneencounter4_258": "Here^1, get up.../",
  "obj_undyneencounter4_259": ".../",
  "obj_undyneencounter4_260": "\\[C]^1, huh?/",
  "obj_undyneencounter4_261": "That's a nice name./%%",
  "obj_undyneencounter4_275": " My name is     %%",
  "obj_undynefall_99": "* (Someone has meticulously&  cleaned all the slime off of&  this snail.)/%%",
  "obj_undynetrash_69": "* (The trashcan is full&  of broken spears.)/%%",
  "obj_undynetrash_72": "* (The trashcan is empty.)/%%",
  "obj_undynetrash_76": "* (You found a trashcan.)/",
  "obj_undynetrash_77": "* (Inside the trashcan&  was a key^1, barely visible&  to the naked eye...)/",
  "obj_undynetrash_78": "* (You take it.)/%%",
  "obj_undynetrash_87": "* (A garbage can.^1)&* (But it's pretty cute.)/%%",
  "obj_undynetrash_88": "* (It's too dark to see&  near the walls.)/%%",
  "obj_undynetrash_91": "* (There's a message crumpled&  up in the trash can.)/",
  "obj_undynetrash_92": "* (It's in a strange kind&  of handwriting.)/",
  "obj_undynetrash_93": "* (It says...)/",
  "obj_undynetrash_94": "* (I KNOW WHAT YOU DID.)/%%",
  "obj_undynetrigger_boss_157": "* Seven./",
  "obj_undynetrigger_boss_158": "\\W* Seven human souls^1, and&  \\RKing ASGORE\\W will become&  a god./",
  "obj_undynetrigger_boss_159": "* Six./",
  "obj_undynetrigger_boss_160": "* That's how many we have&  collected thus far./",
  "obj_undynetrigger_boss_161": "* Understand?/",
  "obj_undynetrigger_boss_162": "* Through your seventh and&  final soul^1, this world will&  be transformed./",
  "obj_undynetrigger_boss_163": "* First^1, however^1, as is customary&  for those who make it this&  far.../",
  "obj_undynetrigger_boss_164": "* I shall tell you the tragic&  tale of our people./",
  "obj_undynetrigger_boss_165": "* It all started^1, long ago.../%%",
  "obj_undynetrigger_boss_190": "* .../",
  "obj_undynetrigger_boss_191": "* No^1, you know what?/%%",
  "obj_undynetrigger_boss_199": "* SCREW IT^3! %%",
  "obj_undynetrigger_boss_206": "* WHY SHOULD I TELL THAT STORY^1  %%",
  "obj_undynetrigger_boss_213": "* WHEN YOU'RE ABOUT TO DIE!?^1!   %%",
  "obj_undynetrigger_boss_220": "* NGAAAAAHHHHHHHHHHHHHHHHH^1! %%",
  "obj_undynetrigger_boss_325": "* YOU!/",
  "obj_undynetrigger_boss_326": "* You're standing in&  the way of everybody's&  hopes and dreams!/",
  "obj_undynetrigger_boss_327": "\\E4* Alphys's history books&  made me think&  humans were cool.../",
  "obj_undynetrigger_boss_328": "\\E0* ... with their giant&  robots and flowery&  swordswomen./",
  "obj_undynetrigger_boss_329": "\\E1* BUT YOU?/",
  "obj_undynetrigger_boss_330": "\\E2* You're just a coward!/",
  "obj_undynetrigger_boss_331": "\\E3* Hiding behind that kid&  so you could run away&  from me again!/",
  "obj_undynetrigger_boss_332": "* You abandoned your&  friend just so you&  could run away!/",
  "obj_undynetrigger_boss_335": "\\E2* And let's not forget&  your wimpy goody-two-&  shoes-schtick!/",
  "obj_undynetrigger_boss_336": "\\E6* Oooh^1! I'm making such a&  difference by hugging&  random strangers!/",
  "obj_undynetrigger_boss_337": "*\\E3 You know what would&  be more valuable&  to everyone?/",
  "obj_undynetrigger_boss_338": "*\\E1 IF YOU WERE DEAD!!!/",
  "obj_undynetrigger_boss_339": "\\E0* That's right^1, human^1!&* Your continued&  existence is a crime!/",
  "obj_undynetrigger_boss_340": "* Your life is all&  that stands between&  us and our freedom!/",
  "obj_undynetrigger_boss_341": "* Right now^1, I can&  feel everyone's hearts&  pounding together!/",
  "obj_undynetrigger_boss_342": "\\E0* Everyone's been&  waiting their whole&  lives for this moment!/",
  "obj_undynetrigger_boss_343": "\\E0* But we're not&  nervous at all./",
  "obj_undynetrigger_boss_344": "\\E1* When everyone puts&  their hearts together^1,&  they can't lose!/",
  "obj_undynetrigger_boss_345": "\\E5* Now^1, human^1!&* Let's end this^1,&  right here^1, right now./",
  "obj_undynetrigger_boss_346": "\\E0* I'll show you how&  determined monsters&  can be!/",
  "obj_undynetrigger_boss_347": "\\E0* Step forward when&  you're ready^1!&* Fuhuhuhu!/%%",
  "obj_undynetrigger_boss_351": "\\E1* And^1! And!/",
  "obj_undynetrigger_boss_352": "\\E7*... and something's&  been bothering me^1,&  too./",
  "obj_undynetrigger_boss_353": "\\E4* The whole time I was&  chasing after you.../",
  "obj_undynetrigger_boss_354": "\\E7* I felt something..^1.&* Strange./",
  "obj_undynetrigger_boss_355": "* The echoes of something&  warm^1, something.../",
  "obj_undynetrigger_boss_356": "\\E9* Something like \"I miss&  being friends with you.\"/",
  "obj_undynetrigger_boss_357": "\\E2* BUT THAT'S RIDICULOUS!/",
  "obj_undynetrigger_boss_358": "\\E6I WOULD NEVER GET&  CHUMMY WITH A COWARD&  LIKE YOU!/",
  "obj_undynetrigger_boss_359": "\\E1* You^1!&* You must have been&  mind-controlling me!/",
  "obj_undynetrigger_boss_360": "\\E6* Manipulating people to&  make them like you..^1.&* What a Grade-A FREAK!/",
  "obj_undynetrigger_boss_361": "\\E1* Now enough^1!&* For everyone's hopes^1!&* For everyone's dreams!/",
  "obj_undynetrigger_boss_362": "\\E2* And for my own&  freaking dignity!/",
  "obj_undynetrigger_boss_363": "\\E3* I^1, UNDYNE^1, will&  knock you down!/%%",
  "obj_undynetrigger_boss_369": "* YOU!/",
  "obj_undynetrigger_boss_370": "* You're standing in&  the way of everybody's&  hopes and dreams!/",
  "obj_undynetrigger_boss_371": "\\E4* Alphys's history books&  made me think humans&  were compassionate.../",
  "obj_undynetrigger_boss_372": "\\E1* BUT YOU?/",
  "obj_undynetrigger_boss_373": "\\E5* You're just a&  remorseless criminal!/",
  "obj_undynetrigger_boss_374": "* You wander through the&  caverns^1, attacking&  anyone in your path./",
  "obj_undynetrigger_boss_375": "\\E4* Self-defense^1?&* Please./",
  "obj_undynetrigger_boss_376": "* You didn't kill them&  because you had to./",
  "obj_undynetrigger_boss_377": "\\E5* You killed them&  because it was&  easy for you./",
  "obj_undynetrigger_boss_378": "* Because it was fun&  for you./",
  "obj_undynetrigger_boss_379": "\\E4* Do you think it&  was fun when I&  found out...?/",
  "obj_undynetrigger_boss_381": "* Do you think it's&  fun when people's&  family members.../",
  "obj_undynetrigger_boss_382": "* ... never come home^1?&* Is that fun?/",
  "obj_undynetrigger_boss_386": "* Shyren^1, who was&  just learning to&  sing.../",
  "obj_undynetrigger_boss_387": "* ... was dead^1, because&  of the whims of&  a single human?/",
  "obj_undynetrigger_boss_392": "* A teenage comedian&  who fell in with&  the wrong crowd.../",
  "obj_undynetrigger_boss_393": "* ... was dead^1, because&  of the whims of&  a single human?/",
  "obj_undynetrigger_boss_399": "* Doggo^1, who always&  made me laugh.../",
  "obj_undynetrigger_boss_400": "* ... was dead^1, because&  of the whims of&  a single human?/",
  "obj_undynetrigger_boss_405": "* Those two sweet dogs^1,&  who always took care&  of each other.../",
  "obj_undynetrigger_boss_406": "* ... were dead^1, because&  of the whims of&  a single human?/",
  "obj_undynetrigger_boss_412": "* That big dog^1, who&  wanted nothing more&  than to play.../",
  "obj_undynetrigger_boss_413": "* ... was dead^1, because&  of the whims of&  a single human?/",
  "obj_undynetrigger_boss_419": "* Lesser Dog^1, who&  wanted nothing more&  than affection.../",
  "obj_undynetrigger_boss_420": "* ... was dead^1, because&  of the whims of&  a single human?/",
  "obj_undynetrigger_boss_425": "* The Snowdin Canine&  Unit had been&  completely decimated./",
  "obj_undynetrigger_boss_426": "* My troops and friends^1,&  destroyed..^1.&* Is that fun?/",
  "obj_undynetrigger_boss_429": "\\E5* No./",
  "obj_undynetrigger_boss_430": "\\E3* But your time's up^1,&  villain!/",
  "obj_undynetrigger_boss_431": "\\E0* You won't hurt anyone&  else./",
  "obj_undynetrigger_boss_432": "* A knight in shining&  armor has appeared./",
  "obj_undynetrigger_boss_433": "\\E4* And all the pain&  you inflicted on&  the fallen.../",
  "obj_undynetrigger_boss_434": "* Every hope^1, every&  dream you've turned&  to dust.../",
  "obj_undynetrigger_boss_435": "\\E0* She's gonna send&  right back through&  her spear!/",
  "obj_undynetrigger_boss_436": "\\E1* NGAHHH!!!/",
  "obj_undynetrigger_boss_437": "\\E0* I'll show you how&  determined monsters&  truly are!/",
  "obj_undynetrigger_boss_438": "* Come on^1!&* Step forward and&  let's end this!/%%",
  "obj_undynetrigger_boss_468": "* .../",
  "obj_undynetrigger_boss_469": "* Forget it./%%",
  "obj_undynetrigger_boss_490": "* Look./",
  "obj_undynetrigger_boss_491": "* Papyrus didn't come&  to his meeting&  today./",
  "obj_undynetrigger_boss_492": "* Say what you want&  about him./",
  "obj_undynetrigger_boss_493": "* He's weird^1, he's&  naive^1, he's self-&  absorbed.../",
  "obj_undynetrigger_boss_494": "\\E5* But Papyrus has&  NEVER missed a&  meeting./",
  "obj_undynetrigger_boss_495": "\\E4* And no matter what&  time you call him&  on the phone.../",
  "obj_undynetrigger_boss_496": "* Night^1, day^1, afternoon^1,&  morning.../",
  "obj_undynetrigger_boss_497": "\\E5* He ALWAYS answers&  within the first&  two rings./",
  "obj_undynetrigger_boss_498": "\\E4* .../",
  "obj_undynetrigger_boss_499": "* But now he's gone./",
  "obj_undynetrigger_boss_500": "* And his brother&  isn't around^1,&  either./",
  "obj_undynetrigger_boss_501": "\\E5* .../",
  "obj_undynetrigger_boss_502": "* What did you do&  to him?/",
  "obj_undynetrigger_boss_503": "* What did you DO&  TO HIM?/",
  "obj_undynetrigger_boss_504": "\\E4* Papyrus^1, who I have&  trained every day.../",
  "obj_undynetrigger_boss_505": "* Even though I KNOW&  he's too goofy to&  ever hurt anyone.../",
  "obj_undynetrigger_boss_506": "\\E5* .../",
  "obj_undynetrigger_boss_507": "\\E4* Go ahead^1.&* Prepare however you&  want./",
  "obj_undynetrigger_boss_508": "\\E5* But when you step&  forward.../",
  "obj_undynetrigger_boss_509": "\\E1* I will KILL you./%%",
