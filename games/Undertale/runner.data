  "item_use_0": "＊ エラー！/%%",
  "item_use_1": "＊ モンスターあめを　たべた。",
  "item_use_10": "＊ スパイダーサイダーを　のんだ。",
  "item_use_11": "＊ バタースコッチパイを　たべた。&＊ HPが　まんタンになった。/",
  "item_use_11_asgore1": "＊ パイのかおりで　アズゴアは&　 なにかを　おもいだした…/",
  "item_use_11_asgore2": "＊ アズゴアの　こうげきりょくと&　 ぼうぎょりょくが　さがった！/%%",
  "item_use_11_toriel": "＊ パイのかおりで　まよえる&　 タマシイは　なにかを&　 おもいだした…/%%",
  "item_use_12": "＊ リボンを　そうびした。/%",
