  "obj_bara01_542": "* 01's breathing intensifies.",
  "obj_bara01_558": "* RG 01 - ATK 30 DEF 20&* Royal Guard member with&  shining^1, polished armor./^",
  "obj_bara01_561": "* I see two lovers staring over&  the edge of the cauldron of&  hell./^",
  "obj_bara01_571": "* You attempt to touch RG 01's&  armor^1.&* Your hands slip off./^",
  "obj_bara01_581": "* You tell RG 01 to be honest&  with his feelings./^",
  "obj_bara01_615": "D-dude&.../",
  "obj_bara01_616": "I can't&.../",
  "obj_bara01_617": "I can't&take&this&anymore!/",
  "obj_bara01_618": "Not like&this!!/%%",
  "obj_bara01_632": "Like^1, 02!&I like.../",
  "obj_bara01_633": "I like^1, LIKE you^1,&bro!/",
  "obj_bara01_634": "The way you fight..^1.&The way you talk.../",
  "obj_bara01_635": "I love doing team&attacks with you./",
  "obj_bara01_636": "I love standing here&with you^1, bouncing&and waving our&weapons in sync.../",
  "obj_bara01_637": "02..^1.&I^1, like^1, want to stay&like this forever.../%%",
  "obj_bara01_650": "^1.^1../",
  "obj_bara01_651": "^1.^1.^1.^1./%%",
  "obj_bara01_663": "Uh.../",
  "obj_bara01_664": "I mean,&uh.../",
  "obj_bara01_665": "Psyche!&Gotcha,&bro!!!&Haha!/%%",
  "obj_bara01_668": "Whew,&bro!&That&human,/",
  "obj_bara01_669": "Put me&under,&uh, mind&control!/",
  "obj_bara01_670": "What was&I just&saying?/",
  "obj_bara01_671": "It's all&a blur,&dude!!&Whoops!/%%",
  "obj_bara01_687": "... 01./%%",
  "obj_bara01_699": "Y-yeah,&bro??/%%",
  "obj_bara01_716": ".../",
