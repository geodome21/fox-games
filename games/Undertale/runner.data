  "obj_latchkey_71": "* (You took the key and&  put it on your phone's&  key-chain.)/%%",
  "obj_lemonbread_175": "But&nobody&came.",
  "obj_lemonbread_176": "Do you&think&I'm&pretty?",
  "obj_lemonbread_177": "That's&what&they all&say.",
