  "SCR_TEXT_1048": "* (You're carrying too much.)/",
  "SCR_TEXT_1049": "* (You aren't ready for the&  responsibility.)/%%",
  "SCR_TEXT_1053": "* (The quiche was left all&  alone...)/%%",
  "SCR_TEXT_1060": "* (There's a tutu lying on&  the ground here.)/",
  "SCR_TEXT_1061": "* (Will you take it?)& &         Take it     Leave it  \\C ",
  "SCR_TEXT_1062": " ",
  "SCR_TEXT_1065": "* Nothing's here!!!/%%",
  "SCR_TEXT_1081": "* (You got the Old Tutu.)/%%",
  "SCR_TEXT_1084": "* (You're carrying too much.)/%%",
  "SCR_TEXT_1088": " %%",
  "SCR_TEXT_1096": "* (The box contains \\[1] cards.)/",
  "SCR_TEXT_1097": "* (Two bugs in the box are&  playing a \\[1]-card game.)/",
  "SCR_TEXT_1098": "* (There's a smiley face made&  of \\[1] cards in the box.)/",
  "SCR_TEXT_1099": "* (A house made of \\[1] cards&  sits in the box.)/",
  "SCR_TEXT_1100": "* (The box is overstuffed with&  cards.)/",
  "SCR_TEXT_1101": "* (Take a card?)& &         Take        Leave \\C ",
  "SCR_TEXT_1102": " ",
  "SCR_TEXT_1105": "* (It's a box for storing Punch&  Cards^1.)&* (It's empty right now.)/%%",
  "SCR_TEXT_1120": "* (You got a Punch Card.)/%%",
  "SCR_TEXT_1121": "* (All games must end one day.^1)&* (You got a Punch Card.)/%%",
  "SCR_TEXT_1122": "* (Happiness is fleeting.^1)&* (You got a Punch Card.)/%%",
  "SCR_TEXT_1123": "* (The house collapses.^1)&* (You got a Punch Card.)/%%",
  "SCR_TEXT_1124": "* (You got a Punch Card.)/%%",
