  "obj_pyropenpc_94": "* PSYYYYCHE^1!&* That'd NEVER happen!/%%",
  "obj_pyropenpc_97": "* I'm too spicey to have&  any friends./%%",
  "obj_questionasker_119": "ERROR? %%",
  "obj_questionasker_130": "HAHAHA, YOU WISH!&WRONG!",
  "obj_questionasker_132": "WRONG! IF ONLY ALPHYS&COULD HELP!",
  "obj_questionasker_134": "NOPE! TOO BAD ALPHYS&CAN'T HELP!",
  "obj_questionasker_136": "WRONG!!! WRONG!!!&WROOOOOOOONG!!",
  "obj_questionasker_138": "COMPLETELY UTTERLY&WRONG!!!!!!",
  "obj_questionasker_140": "BOY, THAT'S&EMBARRASSING, HUH?",
  "obj_questionasker_142": "TIME'S UP!&GUESS THAT'S A NO?? ",
  "obj_questionasker_144": "NO NO NO!&CAN'T YOU READ!?",
  "obj_questionasker_151": "RIGHT! SOUNDS LIKE&YOU GET IT!",
  "obj_questionasker_153": "CORRECT! WHAT A&TERRIFIC ANSWER!",
  "obj_questionasker_155": "TOO EASY FOR&YOU, HUH??????????",
  "obj_questionasker_157": "WONDERFUL! I'M&ASTOUNDED, FOLKS!",
  "obj_questionasker_159": "CORRECT! YOU'RE SO&LUCKY TODAY!!!",
  "obj_questionasker_161": "I'M SO FLATTERED YOU&REMEMBERED!",
  "obj_questionasker_163": "GREAT ANSWER!&I LOVE IT!!!!!!!",
  "obj_questionasker_165": "OF COURSE THAT&WAS EASY FOR YOU!",
  "obj_questionasker_176": "* The quiz show continues.",
  "obj_questionasker_538": "OH^1! OH^1! I KNOW&THIS ONE!!!&IT'S SNAIL ICE&CREAM!!!!!!!^1!%",
  "obj_questionasker_539": "IN THE FOURTH&CHAPTER EVERYONE&GOES TO THE&BEACH!!!%",
  "obj_questionasker_540": "AND SHE BUYS&ICE CREAM FOR&ALL OF HER&FRIENDS!!!!%",
  "obj_questionasker_541": "BUT IT'S SNAIL&FLAVOR AND SHE'S&THE ONLY ONE&WHO WANTS IT!!!!!!%",
  "obj_questionasker_542": "IT'S ONE OF MY&FAVORITE PARTS&OF THE GAME&BECAUSE%",
  "obj_questionasker_543": "IT'S ACTUALLY A&VERY POWERFUL&message abou^1t&friendshi^1p and..^2.%%",
  "obj_questionasker_566": "ALPHYS^1,&ALPHYS^1,&ALPHYS./",
  "obj_questionasker_567": "YOU AREN'T HELPING&OUR CONTESTANT,&ARE YOU?/",
  "obj_questionasker_568": "OOOOOOH!!!&YOU SHOULD HAVE&TOLD ME./",
  "obj_questionasker_569": "I'LL ASK A&QUESTION.../",
  "obj_questionasker_570": "YOU'LL BE SURE&TO KNOW THE&ANSWER TO!/%%",
  "obj_questionasker_598": "ALPHYS^1, ALPHYS^1,&ALPHYS./",
  "obj_questionasker_599": "YOU AREN'T HELPING&OUR CONTESTANT,&ARE YOU?/",
  "obj_questionasker_600": "OOOOOOH!!!&YOU SHOULD HAVE&TOLD ME./",
  "obj_questionasker_601": "I'LL ASK A&QUESTION.../",
  "obj_questionasker_602": "YOU'LL BE SURE&TO KNOW THE&ANSWER TO!/%%",
  "obj_questionasker_607": "SEE, ALPHYS?&I TOLD YOU IT&WAS OBVIOUS./",
  "obj_questionasker_608": "EVEN THE HUMAN&FIGURED IT OUT./",
  "obj_questionasker_609": "YES, SHE SCRAWLS&HER NAME IN THE&MARGINS OF HER&NOTES./",
  "obj_questionasker_610": "SHE NAMES PROGRAMMING&VARIABLES AFTER&HER./",
  "obj_questionasker_613": "SHE EVEN WRITES&STORIES OF THEM&TOGETHER.../",
  "obj_questionasker_614": "SHARING A DOMESTIC&LIFE./",
  "obj_questionasker_615": "PROBABILITY OF&CRUSH:&101 PERCENT./",
  "obj_questionasker_616": "MARGIN OF ERROR.&ONE PERCENT./%%",
  "obj_questionasker_624": "WHY WOULD SOMEONE&OUTFIT AN&AMUSEMENT ROBOT.../",
  "obj_questionasker_625": "WITH BRUTAL COMBAT&CAPABILITIES?/",
  "obj_questionasker_626": "SIMPLE./",
  "obj_questionasker_627": "TO IMPRESS MR.&ASGORE DREEMURR,&OF COURSE!/",
  "obj_questionasker_628": "OR AS ALPHYS&CALLS HIM.../",
  "obj_questionasker_629": "\"MR. DREAMY.\"/",
  "obj_questionasker_630": "THOSE STRONG ARMS.../",
  "obj_questionasker_631": "THAT LUSTROUS&BEARD.../",
  "obj_questionasker_632": "LIKE ALL THOSE WHO&CREATE WEAPONS./",
  "obj_questionasker_633": "SHE CRAVES THE&TENDER EMBRACE OF&A BURLY MAN./",
  "obj_questionasker_634": "CAN SHE TRULY&BE BLAMED?/%%",
  "obj_questionasker_642": "... SERIOUSLY?/",
  "obj_questionasker_643": "MY MY..^1.&HOW CONCEITED CAN&YOU GET...?/",
  "obj_questionasker_644": "I LOVE IT!/",
  "obj_questionasker_645": "AND WHILE YOU ARE&COMPLETELY WRONG^1,&YOU DESERVE SOME&CREDIT./",
  "obj_questionasker_646": "I'VE SEEN HER WATCH&YOU ON HER COMPUTER&SCREEN./",
  "obj_questionasker_647": "SMILING WHEN YOU&SUCCEED./",
  "obj_questionasker_648": "SHRIEKING WHEN YOU&FAIL./",
  "obj_questionasker_649": "AND ALWAYS, ALWAYS,&WHISPERING.../",
  "obj_questionasker_650": "\"NO! WRONG!&YOU HAVE TO&GO THAT WAY!\"/",
  "obj_questionasker_651": "IN ITS OWN WAY^1,&IS THIS NOT&LOVE??/%%",
  "obj_questionasker_657": "CORRECT./",
  "obj_questionasker_658": "DR. ALPHYS HAS&A CRUSH ON.../",
  "obj_questionasker_659": "THE UNKNOWABLE./",
  "obj_questionasker_660": "YOU SEE, ALPHYS&BELIEVES THERE IS&SOMEONE OUT THERE./",
  "obj_questionasker_661": "SOMEONE WATCHING HER./",
  "obj_questionasker_662": "SOMEONE SHE THINKS&IS \"CUTE\" AND&\"INTERESTING.\"/",
  "obj_questionasker_663": "HELLO, THEORETICAL&PERSON./",
  "obj_questionasker_664": "DR. ALPHYS LIKES&YOU./",
  "obj_questionasker_665": "TOO BAD YOU&ARE NOT REAL./",
  "obj_questionasker_666": "*DERISIVE&LAUGHTRACK*/%%",
  "obj_questionasker_691": "H-hey^1, I've done&research about this!/",
  "obj_questionasker_692": "There are alternate&universes out there!/",
  "obj_questionasker_693": "S-someday^1, maybe^1, I&could meet them.../%%",
  "obj_questionasker_704": "YOU SAID THE&EXACT SAME THING&ABOUT \"MEW MEW&KISSY CUTIE.\"/",
  "obj_questionasker_705": "BUT I'LL GIVE YOU&THE BENEFIT OF&THE DOUBT./",
  "obj_questionasker_706": "PERSON^1, IF YOU'RE&OUT THERE.../",
  "obj_questionasker_707": "HOW ABOUT GIVING US&A SIGN^1, RIGHT NOW?/%%",
  "obj_questionasker_725": "THAT SETTLES&THAT, DOESN'T IT?/%%",
  "obj_questionasker_745": "WELL WELL WELL./",
  "obj_questionasker_746": "WITH DR. ALPHYS&HELPING YOU.../",
  "obj_questionasker_747": "THE SHOW HAS NO&DRAMATIC TENSION!/",
  "obj_questionasker_748": "WE CAN'T GO ON&LIKE THIS!!/",
  "obj_questionasker_749": "BUT./",
  "obj_questionasker_750": "BUT!!!/",
  "obj_questionasker_751": "THIS WAS JUST THE&PILOT EPISODE!!/",
  "obj_questionasker_752": "NEXT UP, MORE&DRAMA!/",
  "obj_questionasker_753": "MORE ROMANCE!!!/",
  "obj_questionasker_754": "MORE BLOODSHED!!!/",
  "obj_questionasker_755": "UNTIL NEXT TIME,&DARLINGS...!!!/%%",
  "obj_readable_modernbook_59": "%%",
  "obj_readable_modernbook_60": "* (Here I am..^1.&* Writing this book.)/",
  "obj_readable_modernbook_61": "* (A person comes in and picks&  up the book...)/",
  "obj_readable_modernbook_62": "* (They start reading it...!)/",
  "obj_readable_modernbook_63": "* Oh^1, sorry^1.&* I'm still writing that one./%%",
  "obj_readable_modernbook_68": "* (Some unfinished book.)/%%",
  "obj_readable_room1_64": "%%",
  "obj_readable_room1_65": "* Only the fearless may proceed.&* Brave ones, foolish ones.&* Both walk not the middle road./%%",
  "obj_readable_room1_66": "* Stay on the path./%%",
  "obj_readable_room1_67": "* The western room is the&  eastern room's blueprint./%%",
  "obj_readable_room1_68": "* Three out of four grey rocks&  recommend you push them./%%",
  "obj_readable_room1_69": "* (There's an ant-sized frog in&  a crack in the wall...^1)&* (It waves at you.)/%%",
  "obj_readable_room1_69_console_1": "* (There's a small crack in the&  wall here.)/",
  "obj_readable_room1_69_console_2": "* (There's a frog inside...^2)&* (Wait^1! There are two!)/",
  "obj_readable_room1_69_console_3": "* (You had a wonderful,&  exclusive experience...)/",
  "obj_readable_room1_69_console_4": "* (... that only someone who&  saw two frogs could feel.)/%%",
  "obj_readable_room1_70": "* There is just one switch./%%",
  "obj_readable_room1_71": "* The far door is not an exit^1.&* It simply marks a rotation&  in perspective./%%",
  "obj_readable_room1_72": "* If you can read this^1,&  press the blue switch./%%",
  "obj_readable_room1_73": "* If you can read this^1,&  press the red switch./%%",
  "obj_readable_room1_74": "* If you can read this^1,&  press the green switch./%%",
  "obj_readable_room1_75": "* These books are worn...&* They must have been read&  many times./%%",
  "obj_readable_room1_78": "* (There's an old calendar from&  the end of 201X.^1)&* (A date is circled on it.)/%%",
  "obj_readable_room1_79": "\\R* (The date I came here.)/%%",
  "obj_readable_room1_81": "* The ends of the tools have&  been filed down to&  make them safer./%%",
  "obj_readable_room1_82": "* Seems like gardening tools./%%",
  "obj_readable_room1_83": "* Look at these cool toys^2!&* They don't interest you&  at all./%%",
  "obj_readable_room1_84": "* (Dusty toys.)/%%",
  "obj_readable_room1_86": "* Throne Room/%%",
  "obj_readable_room1_90": "* (It's a coffin.^1)&* (There's a name engraved on&  it.)/",
  "obj_readable_room1_91": "* (\"\\[C].\")/",
  "obj_readable_room1_92": "* (It's empty.)/%%",
  "obj_readable_room1_96": "* (The coffin is empty...?)/",
  "obj_readable_room1_97": "* (You didn't notice before^1,&  but there's something like...)/",
  "obj_readable_room1_98": "* (... mummy wrappings at the&  bottom of it.)/%%",
  "obj_readable_room1_103": "\\R* (It's as comfortable as it&  looks.)/%%",
  "obj_readable_room1_112": "* You peek inside..^2.&* Scandalous!/",
  "obj_readable_room1_113": "* It's TORIEL's sock&  collection./%%",
  "obj_readable_room1_114": "* You can't stop looking&  at the socks./%%",
  "obj_readable_room1_118": "* (You came all the way&  back here to look at&  Toriel's socks.)/",
  "obj_readable_room1_119": "* (You have great priorities&  in life.)/%%",
  "obj_readable_room1_125": "* It's a clothes drawer^1.&* There are robes^1, button-up&  shirts.../",
  "obj_readable_room1_126": "* ... and a pink^1, hand-knit&  sweater that says&  \"Mr. Dad Guy.\"/%%",
  "obj_readable_room1_130": "\\R* Still has that sweater./%%",
  "obj_readable_room1_134": "* (It's just a chair.)/%%",
  "obj_readable_room1_139": "* (It's a throne.)/%%",
  "obj_readable_room1_142": "* \"Room under renovations.\"/%%",
  "obj_readable_room1_143": "* \"Room under renovations.\"/%%",
  "obj_readable_room1_144": "* For some reason^1, there&  is a brand-name chocolate&  bar in the fridge./%%",
  "obj_readable_room1_147": "* (The fridge is full of&  unopened containers of&  snails.)/%%",
  "obj_readable_room1_151": "\\R* No chocolate./%%",
  "obj_readable_room1_154": "* ...!^1?&* There's a camera hidden&  in the bushes./%%",
  "obj_readable_room1_155": "* (His.)/%%",
  "obj_readable_room1_158": "* There's a switch hidden&  in the snow^1.&* Click!/%%",
  "obj_readable_room1_159": "* The switch is stuck now./%%",
  "obj_readable_room1_162": "* There's a switch here^1.&* It's been depressed with&  vines./%%",
  "obj_readable_room1_164": "* On the floor inside is&  a box of pomeraisins./%%",
  "obj_readable_room1_198": "* (It's a school report about&  monster funerals.)/",
  "obj_readable_room1_199": "* Monster funerals^1, technically&  speaking^2, are cool as heck./",
  "obj_readable_room1_200": "* When monsters get old and&  kick the bucket^1, they turn&  into dust./",
  "obj_readable_room1_201": "* At funerals^1, we take that&  dust and spread it on that&  person's favorite thing./",
  "obj_readable_room1_202": "* Then their essence will live&  on in that thing.../",
  "obj_readable_room1_203": "* Uhhh^1, am I at the page&  minimum yet^1?&* I'm kinda sick of writing this./%%",
  "obj_readable_room1_208": "\\W* Mom says that sleeping&  can recover your health&  \\Yabove your maximum HP\\W./",
  "obj_readable_room1_209": "* ... what's maximum HP?/%%",
  "obj_readable_room1_213": "* Mom says that we can&  go to the surface world&  now!/",
  "obj_readable_room1_214": "* ... what's so great about&  that^1, anyway^1?&* I don't wanna move./%%",
  "obj_readable_room1_219": "* (It's merely a decoy.)/%%",
  "obj_readable_room1_228": "* \"The power to take their&  SOULs.\"/",
  "obj_readable_room1_229": "* \"This is the power that&  the humans feared.\"/%%",
  "obj_readable_room1_235": "* (Ancient writing covers the&  walls..^1. you can just make&  out the words.)/",
  "obj_readable_room1_236": "* \"The War of Humans and&  Monsters.\"/%%",
  "obj_readable_room1_241": "* The northern room hides a&  great treasure./%%",
  "obj_readable_room1_247": "* Hurt, beaten, and fearful for&  our lives, we surrendered&  to the humans./",
  "obj_readable_room1_248": "* Seven of their greatest&  magicians sealed us underground&  with a magic spell./",
  "obj_readable_room1_249": "* Anything can enter through the&  seal, but only beings with a&  powerful SOUL can leave./%%",
  "obj_readable_room1_256": "* However...&* There is a prophecy./",
  "obj_readable_room1_257": "* The Angel...&* The One Who Has Seen The&  Surface.../",
  "obj_readable_room1_258": "* They will return.&* And the underground will go&  empty./%%",
  "obj_readable_room1_263": "* The ancient glyphs have been&  painted over with a list of&  21 different flavors./%%",
  "obj_readable_room1_269": "* Achoo^1!&* Tried to catch a bug^1, but&  I just caught a cold.../%%",
  "obj_readable_room1_274": "* The humans, afraid of our&  power^1, declared war on us./",
  "obj_readable_room1_275": "* They attacked suddenly, and&  without mercy./%%",
  "obj_readable_room1_280": "* Without candles or magic to&  guide them Home^1, the monsters&  used crystals to navigate./%%",
  "obj_readable_room1_292": "* (It's a beat-up figurine&  of a female human with&  cat ears.)/%%",
  "obj_readable_room1_293": "* (It's too dark to see&  near the walls.)/%%",
  "obj_readable_room1_299": "* (Scientific books.^1)&* (They seem very dusty.)/%%",
  "obj_readable_room1_304": "* (It's a fridge.^1)&* (It's strangely warm.)/%%",
  "obj_readable_room1_306": "* (It's too dark to see&  near the walls.)/%%",
  "obj_readable_room1_312": "* MILK^1? EGGS^1? IN THE FRIDGE?/",
  "obj_readable_room1_313": "* NO WAY^1, DARLING^1!&* THEY'D GET COLD!!!/%%",
  "obj_readable_room1_320": "* Ring.../",
  "obj_readable_room1_321": "\\TS \\E3 \\F6 \\TA %",
  "obj_readable_room1_322": "* Um^1, is it really&  a good idea to be&  getting a snack?/",
  "obj_readable_room1_323": "\\E8* Well^1, I guess I&  really shouldn't&  judge you.../",
  "obj_readable_room1_324": "\\E0* After all^1, I'm the&  one eating potato&  chips in my PJs!/",
  "obj_readable_room1_325": "\\E5* Uhhh^1, I mean..^1.&* H-hey^1, go over to&  the right!/%%",
  "obj_readable_room1_328": "* Ring.../",
  "obj_readable_room1_329": "\\TS \\E3 \\F6 \\TA %",
  "obj_readable_room1_330": "* H-hey^1!&* Head over to the&  right!/%%",
  "obj_readable_room1_347": "* I hate cold food./",
  "obj_readable_room1_349": "\\E0* So Alphys fixed up&  my fridge so it&  heats up food instead!/",
  "obj_readable_room1_350": "\\E6* Hot Fridge..^1.&* The world's greatest&  invention!/%%",
  "obj_readable_room1_354": "\\E6* Hot Fridge..^1.&* The world's greatest&  invention!/%%",
  "obj_readable_room1_360": "* This oven is some&  top-of-the-line&  MTT thing./",
  "obj_readable_room1_361": "\\E4* But^1, y'know^1, as much&  as technology&  advances.../",
  "obj_readable_room1_362": "\\E0* Nothing beats food&  home-cooked with&  fire magic./%%",
  "obj_readable_room1_369": "* (It looks like some sort of&  powerful bracelet...)/",
  "obj_readable_room1_370": "* (Wait.^1)&* (It's just a croissant...)/%%",
  "obj_readable_room1_375": "* (It's just a regular wall.)/%%",
  "obj_readable_room1_380": "* (East...)&* (The End.)/%%",
  "obj_readable_room1_385": "* (Solve this puzzle,&  and The End will open.)/%%",
  "obj_readable_room1_390": "* (Traverse the northern&  room^1, and The End will&  open.)/%%",
  "obj_readable_room1_395": "* (I cannot fight.)&* (I cannot think.)/",
  "obj_readable_room1_396": "* (But^1, with patience^1,&  I will make my way&  through.)/%%",
  "obj_readable_room1_401": "* (Get lost...)&* (And stay that way.)/%%",
  "obj_readable_room1_406": "* (Why not relax and have&  a nice snack?)/%%",
  "obj_readable_room1_416": "* (It's completely trashed.^1)&* (There's no way it could&  ever be repaired.)/%%",
  "obj_readable_room1_419": "* (It's out of batteries.)/%%",
  "obj_readable_room1_425": "* ENTRY NUMBER 1/",
  "obj_readable_room1_426": "* This is it..^1.&* Time to do what the King&  has asked me to do./",
  "obj_readable_room1_427": "* I will create the power to&  free us all./",
  "obj_readable_room1_428": "* I will unleash the power of&  the SOUL./%%",
