  "obj_undynetrash_77": "＊ (にくがんでは　ほとんど&　 みえないが^1　なかに&　 カギが　ある…)/",
  "obj_undynetrash_78": "＊ (カギをひろった)/%%",
  "obj_undynetrash_87": "＊ (ゴミばこだ^1)&＊ (なかなかカワイイ)/%%",
  "obj_undynetrash_88": "＊ (くらくて　よくみえない)/%%",
  "obj_undynetrash_91": "＊ (ゴミばこに&　 まるめた　かみが&　 すててある)/",
