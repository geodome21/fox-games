  "obj_lesserdoge_224": "%%%",
  "obj_lesserdoge_420": "* Lesser Dog cocks its head&  to one side.",
  "obj_lesserdoge_421": "* Lesser Dog thinks your&  weapon is a dog treat.",
  "obj_lesserdoge_422": "* Lesser Dog is really not&  paying attention.",
  "obj_lesserdoge_423": "* Smells like dog chow.",
  "obj_lesserdoge_424": "* Lesser Dog is barking&  excitedly.",
  "obj_lesserdoge_425": "* Lesser Dog is overstimulated.",
  "obj_lesserdoge_426": "* Lesser Dog shows no signs&  of stopping.",
  "obj_lesserdoge_427": "* Lesser Dog is lowering.",
  "obj_lesserdoge_428": "* Lesser Dog is learning&  to read.",
  "obj_lesserdoge_429": "* Lesser Dog is whining&  because it can't see&  you.",
  "obj_lesserdoge_430": "* Hello there.",
