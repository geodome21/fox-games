  "obj_chilldrake_246": "Brush my&teeth?&No way&in heck!",
  "obj_chilldrake_247": "NEVER do&your&homework&!!",
  "obj_chilldrake_248": "No&bedtime!&Only&DEADTIME",
  "obj_chilldrake_249": "*turns&music up&all the&way*",
  "obj_chilldrake_254": "Do you...&really&...",
  "obj_chilldrake_255": "I don't&think&you...",
  "obj_chilldrake_256": "To tell&you the&truth...",
  "obj_chilldrake_258": "You&don't&know my&cause!!",
  "obj_chilldrake_265": "Only&Snowy&can do&that.",
  "obj_chilldrake_266": "You&ain't&Snowy.",
  "obj_chilldrake_267": "Stick to&puns.&They're&better.",
  "obj_chilldrake_272": "WRONG!&Let's&fight&and die.",
  "obj_chilldrake_273": "Actually&...&Death?",
  "obj_chilldrake_274": "Defiance&can't be&defied!",
  "obj_chilldrake_279": "IT'S&JUST&LIKE&'EM",
  "obj_chilldrake_280": "HAHA&WOWEE",
  "obj_chilldrake_281": "YOU&NAILED&IT",
  "obj_chilldrake_286": "Where's&Snowy&right&now?",
  "obj_chilldrake_287": "Ha...&Ha...",
  "obj_chilldrake_288": "Nice&try,&laugh&Picasso.",
  "obj_chilldrake_296": "%%%",
  "obj_chilldrake_493": "* Chilldrake starts a one-&  monster riot.",
  "obj_chilldrake_494": "* Chilldrake is chanting an&  anarchist spell.",
  "obj_chilldrake_495": "* Chilldrake is eating its&  own homework.",
  "obj_chilldrake_496": "* It smells like \"Ice\"&  scented body-spray.",
  "obj_chilldrake_497": "* Chilldrake is wondering&  where Snowy went.",
  "obj_chilldrake_498": "* Chilldrake feels neutered&  by your agreement.",
  "obj_chilldrake_499": "* Chilldrake is laughing at&  your imitation of its&  cohort.",
  "obj_chilldrake_500": "* Chilldrake pretends not to&  care.",
  "obj_chilldrake_501": "* Chilldrake is puffed up..",
  "obj_chilldrake_502": "* Chilldrake is flaking&  apart.",
  "obj_chilldrake_518": "* CHILLDRAKE - ATK 12 DEF 7&* Rebels against everything!!&* Looking for its friend Snowy./^",
  "obj_chilldrake_527": "* You tell Chilldrake it's&  all wrong./^",
  "obj_chilldrake_539": "* You agree with Chilldrake&  before it gives its speech./^",
  "obj_chilldrake_540": "* You agree with Chilldrake^1.&* It seems to get very&  uncomfortable.../^",
  "obj_chilldrake_548": "* You make fun of Chilldrake./^",
  "obj_chilldrake_550": "* You make fun of Chilldrake./",
  "obj_chilldrake_551": "* The other monsters think&  it's hilarious.../^",
  "obj_chilldrakenpc_70": "* Heh..^1. us teens live&  self-sufficiently off&  the fat of the land.../",
  "obj_chilldrakenpc_71": "* Oh^1, and the box lunches my&  parents bring us every&  day./%%",
  "obj_chilldrakenpc_72": "* Besides Snowy^1.&* We have to share ours&  with him../%%",
  "obj_chilldrakenpc_76": "* Heh..^1.&* I guess we'll have to go to&  the surface./",
  "obj_chilldrakenpc_77": "* There are woods there we can&  live in^1, right?/%%",
  "obj_chilldrakenpc_82": "* Guh huh huh huh^1./",
  "obj_chilldrakenpc_83": "* Us teens rule these woods&  with a smaller-than-&  adult fist./%%",
  "obj_chilldrakenpc_87": "* I'm worried about getting&  older..^1.&* I'll stop being a teen./",
  "obj_chilldrakenpc_88": "* No^1! I refuse^1!&* I'll just invent new numbers^1,&  like twenty-teen!/%%",
  "obj_chipdoor_l_78": "* (The door is locked.)/%%",
  "obj_chipdoor_l_79": "* (This half of the door is&  unlocked.)/%%",
  "obj_chipdoor_l_82": "* (The door is open.)/%%",
  "obj_chipdoor_l_87": "* (The door is open.)/%%",
