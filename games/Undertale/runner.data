  "SCR_TEXT_6828": "   * Alphys \\W &",
  "SCR_TEXT_6829": "   \\Y* (Saved)\\W &",
  "SCR_TEXT_6831": "\\W   * Papyrus       * Sans \\W &",
  "SCR_TEXT_6832": "\\Y   * (Saved)       * (Saved)\\W &",
