  "obj_puzzlewall1_66": "\\E3DO YOU TREAT&YOUR MOTHER&THIS WAY.../",
  "obj_puzzlewall1_67": "WHEN SHE MAKES&YOU A PUZZLE&?!?!?/%%",
  "obj_puzzlewall1_71": "\\E3HUMANS.../%%",
  "obj_puzzlewall2_62": "SANS!!!^1!&THE HUMAN IS&ESCAPING!!!/",
  "obj_puzzlewall2_63": "YOU MADE THE&PUZZLE TOO&HARD!!/",
