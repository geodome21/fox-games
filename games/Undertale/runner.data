  "obj_pyrope_492": "* Pyrope is protected by its&  winsome smile.",
  "obj_pyrope_493": "* Pyrope is pretending to&  pull the fire alarm.",
  "obj_pyrope_494": "* Pyrope is chuckling through&  its teeth.",
  "obj_pyrope_495": "* Pyrope is pretending to be&  a candle.",
  "obj_pyrope_496": "* Smells like rope burn.",
  "obj_pyrope_497": "* Pyrope wants more heat.",
  "obj_pyrope_498": "* The room is sweltering!",
  "obj_pyrope_524": "* PYROPE - ATK 29 DEF 14&* This mischievous monster&  is never warm enough./^",
  "obj_pyrope_534": "* You blow on Pyrope.&* Its flames die down.&* Pyrope's ATTACK dropped!/^",
  "obj_pyrope_555": "* You crank up the thermostat.&* Pyrope begins to get&  excited./^",
  "obj_pyrope_556": "* You crank up the thermostat.&* It's super hot!&* Pyrope looks satisfied./^",
