  "obj_battlebomb_223": "Swish.",
  "obj_battlebomb_245": "%%%",
  "obj_battlebomb_485": "* The bomb is still active!",
  "obj_battlebomb_486": "* The dog is still active!",
  "obj_battlebomb_513": "* BOMB&* Could blow at any moment./^",
  "obj_battlebomb_514": "* ANNOYING DOG-BOMB&* It's blissfully unaware of&  its circumstances./^",
  "obj_battlebomb_515": "* EXTREMELY AGILE G.O.W.&* All things considered^1, it's an&  extremely agile glass of water./^",
  "obj_battlebomb_516": "* SCRIPT BOMB&* Like all modern blockbusters^1,&  it's full of explosions./^",
  "obj_battlebomb_517": "* BASKET BOMB&* Even if you explode^1, you'll&  at least look good./^",
  "obj_battlebomb_518": "* PRESENT BOMB&* Regardless^1, you'll have to&  write a thank-you letter./^",
  "obj_battlebomb_519": "* GAME BOMB&* You really should have rented&  it first./^",
