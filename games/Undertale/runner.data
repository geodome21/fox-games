  "scr_papcall_950": "まったく&あんぜん&で、&いっさい&キケンの&ない&エリアだ…/",
  "scr_papcall_951": "\\E0オレさまの&おかげ&だなッ^1！&ニャハハ！/%%",
  "scr_papcall_956": "ハ！！/%%",
  "scr_papcall_962": "＊ わたしが　おまえに&　 ヤリを　ガンガンなげた&　 ばしょだな…/",
  "scr_papcall_963": "\\E6＊ あーたのしかったーッ^1！&＊ また　やろうなッ！/%%",
  "scr_papcall_968": "＊ また“やろう”なッ^1！&＊ “ヤリ”　だけにッ！？/%%",
