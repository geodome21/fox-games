  "SCR_TEXT_xbox_0": "＊ (イヌコイン5まい　25G)&＊ (こうかんする？)&          する          しない \\C",
  "SCR_TEXT_xbox_1": "＊ (わずかな　コインを&　 てにいれた)/%",
  "SCR_TEXT_xbox_2": "＊ (このあたりで　てにはいる&　 コレクションコインは^1　ぜんぶ&　 てにいれて　しまったようだ)/",
  "SCR_TEXT_xbox_3": "＊ (さて　どうしよう…)/%",
  "SCR_TEXT_xbox_4": "＊ (せいかつ　ひつじゅひん^1…&　 たとえば　おカネ　などを　かう&　 しきんが　ふそく　している)/%",
  "SCR_TEXT_xbox_5": "＊ (この　コインは　ふつうのGを&　 コレクションコイン・マシンで&　 つぶしただけだ)/%",
  "SCR_TEXT_xbox_6": "＊ ゲットした　しょうひんを&　 しらべて^1　オイラに&　 はなしかけてくれ。/",
  "SCR_TEXT_xbox_7": "\\E1＊ がんばったヤツは&　 ちゃんと　コケにしてやる&　 のが　れいぎだからな。/%",
  "SCR_TEXT_xbox_8": "＊ どうした^1？&＊ しょうひん&　 ゲットできたか？/%",
  "SCR_TEXT_xbox_9": "＊ 「たかさ」で　おもいだし&　 たけど^1　おとうとが&　 シンクを　たかくしてさ。/",
  "SCR_TEXT_xbox_10": "\\E1＊ もとの　たかさじゃ&　 なんいどが&　 ひくすぎたらしい。/",
  "SCR_TEXT_xbox_11": "\\E2＊ あいつは　ちかみち&　 とかして　ラクする&　 タイプじゃないからな。/",
  "SCR_TEXT_xbox_12": "\\E0＊ たぶん　「ちかみちなんて&　 いらない」ってことを&　 いいたいんだろな。/",
  "SCR_TEXT_xbox_13": "\\E1＊ あいつなりの&　 めんどくさい&　 やりかたでさ。/%",
  "SCR_TEXT_xbox_14": "＊ フライドドッグフード^1？&＊ いやいや^1　あげものは&　 からだに　わるいぜ？/",
  "SCR_TEXT_xbox_15": "\\E2＊ フライドなんちゃらを&　 うりつけてくるヤツは&　 しんようするなよ。/%",
  "SCR_TEXT_xbox_16": "＊ ファストフード^1？&＊ あの^1　ホットランドにある&　 みせで　うってるヤツか？/",
  "SCR_TEXT_xbox_17": "\\E1＊ うまいバーガーなら&　 レストランのほうが&　 おすすめだぜ。/",
  "SCR_TEXT_xbox_18": "\\E0＊ ふんいきも　いいしな^1。&＊ あそこのステージで&　 おわらいライブもしたし。/",
  "SCR_TEXT_xbox_19": "\\E1＊ 王さまは　オイラが&　 ダジャレを　いったら&　 おおわらいしてさ。/",
  "SCR_TEXT_xbox_20": "\\E3＊ オイラは　つったったまま&　 王さまが　わらいおわる&　 のを　まってた。/",
  "SCR_TEXT_xbox_21": "\\E1＊ でも　わらいおわらない&　 から^1　そのうち　まくを&　 おろされちゃってさ。/",
  "SCR_TEXT_xbox_22": "\\E2＊ オイラしじょう&　 さいこうの&　 パフォーマンスだったな。/",
  "SCR_TEXT_xbox_23": "\\E0＊ ま^1　アンタが　あそこに&　 いくことが　あれ^1ば&　 なんか　おごってやるよ。/%",
  "SCR_TEXT_xbox_24": "＊ あー^1　そのリストな^1。&＊ だれが　つくったか&　 オイラ　しってるぜ。/",
  "SCR_TEXT_xbox_25": "＊ ともだちに　たのまれ^1て&　 ある女子に　オススメの&　 ゲームを　きいたんだ。/",
  "SCR_TEXT_xbox_26": "\\E1＊ さくもつだの^1　カタツムリ&　 だの^1　そだてたりする&　 ゆるゲー　とかな。/",
  "SCR_TEXT_xbox_27": "\\E0＊ でも　オイラも&　 うっかり しててさ…/",
  "SCR_TEXT_xbox_28": "\\E1＊ そいつ^1　じぶんが　いま&　 むちゅうに　なってるもの&　 しか　すすめないんだ。/",
  "SCR_TEXT_xbox_29": "\\E0＊ で^1　けっきょく　また&　 いつものRPGを&　 すすめられた。/",
  "SCR_TEXT_xbox_30": "\\E3＊ ハハ。/",
  "SCR_TEXT_xbox_31": "\\E2＊ だから^1「gamerboxばん&　 が　でたら　やるよ」&　 って　いっといたよ。/%",
  "SCR_TEXT_xbox_32": "＊ びようクリームだって^1？&＊ オイラは　えんりょ&　 しとくよ。/",
  "SCR_TEXT_xbox_33": "\\E1＊ どうせ　うちの&　 おとうとの　だろうしな。/",
  "SCR_TEXT_xbox_34": "\\E0＊ あいつは　おハダの&　 おていれマニアだ^1。&　 みれば　わかるだろ？/",
  "SCR_TEXT_xbox_35": "\\E1＊ 「おていれを&　 はじめてからというもの&　 ニキビしらず！^1」とか…/",
  "SCR_TEXT_xbox_36": "\\E0＊ 「このスベスベおハダで&　 ニンゲンを　こわがらせて&　 やる！^1」とか…/",
  "SCR_TEXT_xbox_37": "\\E1＊ 「オレさまは&　 せいしんと　キュウリの&　 へやに　はいるぞッ！」/",
  "SCR_TEXT_xbox_38": "\\E0＊ …とかいってるけ^1ど&　 どういうイミかは&　 さっぱりだ。/%",
  "SCR_TEXT_xbox_39": "＊ え^1？　その　ぼうしを&　 かぶれって？/",
  "SCR_TEXT_xbox_40": "\\E3＊ イヤだね^1。&　 だいたい…/",
  "SCR_TEXT_xbox_41": "\\E1＊ さっき　かみを&　 とかした　ばっかだしな。/",
  "SCR_TEXT_xbox_42": "\\E2＊ それに^1　オイラが&　 ぼうしなんか　かぶると&　 おもうか？/%",
  "SCR_TEXT_xbox_43": "＊ そのチケットは^1&　 METAグループの&　 ゲーム・ショーのだな。/",
  "SCR_TEXT_xbox_44": "\\E1＊ あれは　まいかい&　 ケッサクだぜ。/",
  "SCR_TEXT_xbox_45": "\\E0＊ あいつ　いつも&　 MODを　いれて^1　じぶんを&　 メインキャラにするんだ。/",
  "SCR_TEXT_xbox_46": "\\E1＊ …で^1も&　 アニメーションは&　 かわらないから…/",
  "SCR_TEXT_xbox_47": "\\E2＊ 舌の　ながい　トカゲの&　 キャラの　ときなんかは&　 かなり　わらえるぜ。/%",
  "SCR_TEXT_xbox_48": "＊ それは^1…&　 カメラか　なんかか？/",
  "SCR_TEXT_xbox_49": "\\E2＊ そうそう^1　パピルスは&　 さいきん　「セルフィー」&　 とやらに　はまってる。/",
  "SCR_TEXT_xbox_50": "\\E0＊ あいつ　「トレーニングの&　 せいか」が　でるまで&　 まちきれなくてさ。/",
  "SCR_TEXT_xbox_51": "\\E1＊ とった　しゃしんを&　 へんしゅうし^1て& 　キンニクをデカくしてる。/",
  "SCR_TEXT_xbox_52": "\\E2＊ でも　それは　ズルじゃ& 　なくて^1　「みらいの&　 さきどり」らしい。/%",
  "SCR_TEXT_xbox_53": "＊ gamerboxか^1。&＊ そりゃすごい。/",
  "SCR_TEXT_xbox_54": "\\E1＊ げんじつの　せかいで&　 そいつを　てに&　 いれるなんてな。/",
  "SCR_TEXT_xbox_55": "\\E0＊ いくら　それでしか&　 プレイできないゲームが&　 あったからって…/",
  "SCR_TEXT_xbox_56": "\\E2＊ じぶんで　プレイ&　 しなくても^1　どうが　とか&　 みれば　すむことだろ？/%",
  "SCR_TEXT_xbox_57": "＊ モンスターと&　 エナジーの&　 パーフェクトコンビだな。/",
  "SCR_TEXT_xbox_58": "＊ オイラの　しりあいの&　 とある女子が^1　いっつも&　 そいつを　のんでる。/",
  "SCR_TEXT_xbox_59": "＊ あきカン　あつめて&　 なんか　デカいもん&　 つくるって　いってたな…/",
  "SCR_TEXT_xbox_60": "＊ ちなみに^1　ゆうめいな&　 さくらんぼに　ちなんだ&　 あじらしいぜ。/%",
  "SCR_TEXT_xbox_61": "＊ あー^1…&　 わたぼこりが&　 すごいな。/",
  "SCR_TEXT_xbox_62": "\\E1＊ れいの　イヌが　きた&　 あとの　オイラんちは&　 いつも　こんなだけど。/",
  "SCR_TEXT_xbox_63": "\\E3＊ …で^1　パピルスが&　 ほうきを　もってき^1て&　 あしを　ふみならして…/",
  "SCR_TEXT_xbox_64": "\\E2＊ 「兄ちゃん^1　ぬけげを&　 ちらかすの　やめて！」&　 っていうんだ。/%",
  "SCR_TEXT_xbox_65": "＊ あー^1…&　 わたぼこりが&　 また　ふえたな。/",
  "SCR_TEXT_xbox_66": "\\E3＊ ゆきがふる^1と&　 パピルスは　まどに&　 かおを　くっつけて…/",
  "SCR_TEXT_xbox_67": "\\E0＊ 「兄ちゃん^1！　みて^1！&　 ゆきだよッ！　きれい&　 だね！？^1」っていう。/",
  "SCR_TEXT_xbox_68": "\\E0＊ だから　オイラは…/",
  "SCR_TEXT_xbox_69": "\\E1＊ ゆきなら　まいにち&　 ふってるぜ^1？&　 っていう。/",
  "SCR_TEXT_xbox_70": "\\E3＊ それでも　あいつは&　 そとへでて^1　ゆきの&　 うえに　たおれて…/",
  "SCR_TEXT_xbox_71": "\\E1＊ ついた　あとの&　 キンニクを^1　デカめに&　 しゅうせいするんだ。/%",
  "SCR_TEXT_xbox_72": "＊ あー…^1　まるで&　 ふぶき　だな。/",
  "SCR_TEXT_xbox_73": "＊ これほどの　おおゆきが&　 ふったことは^1　これまで&　 いちどしかない。/",
  "SCR_TEXT_xbox_74": "\\E3＊ めのまえの　ホネすら&　 みえないぐらいの&　 ひどい　ゆきだった。/",
  "SCR_TEXT_xbox_75": "\\E0＊ それでも　王さまは&　 あかと　しろの　ふくきて&　 そとに　でて…/",
  "SCR_TEXT_xbox_76": "\\E2＊ みんなへの　プレゼントを&　 ツリーの　したに&　 おいてた。/",
  "SCR_TEXT_xbox_77": "\\E3＊ パピルスにも^1　トナカイ&　 っぽいツノの　おんなのコ&　 と　そのアネキにも。/",
  "SCR_TEXT_xbox_78": "\\E2＊ おまけに　オイラにまで&　 プレゼントくれてさ。/",
  "SCR_TEXT_xbox_79": "\\E1＊ 王さまは　オイラを&　 よくしってるわけでも&　 ないのにさ。/",
  "SCR_TEXT_xbox_80": "\\E3＊ …/",
  "SCR_TEXT_xbox_81": "\\E0＊ アンタ^1　いずれ&　 王さまに　あわなきゃ&　 ダメなんだろ？/",
  "SCR_TEXT_xbox_82": "\\E1＊ そりゃ　きっと&　 すごいプレッシャーだな。/",
  "SCR_TEXT_xbox_83": "\\E0＊ オイラから&　 アドバイスするなら…/",
  "SCR_TEXT_xbox_84": "\\E3＊ 王さまだと&　 おもわなきゃいい。/",
  "SCR_TEXT_xbox_85": "\\E2＊ オイラに　くつしたくれた&　 ただの　おっさんだと&　 おもえばいいよ。/%",
  "SCR_TEXT_xbox_86": "＊ あれは　まだ　マジメに&　 くつしたコレクションを&　 はじめる　まえだった。/",
  "SCR_TEXT_xbox_87": "\\E3＊ しょうじき&　 みとめたくはないけど…/",
  "SCR_TEXT_xbox_88": "\\E2＊ あのころは&　 オイラも　まだまだ&　 かけだしでさ。/",
  "SCR_TEXT_xbox_89": "\\E1＊ ガチな　きょうそうの&　 きびしさを　まるで&　 わかってなかった。/",
  "SCR_TEXT_xbox_90": "\\E2＊ ま　いまのオイラに^1は&　 それも　なつかしい&　 おもいでだ。/%",
  "SCR_TEXT_xbox_91": "＊ よう。/",
  "SCR_TEXT_xbox_92": "\\E2＊ イヌポーカー&　 やってくか？/",
  "SCR_TEXT_xbox_93": "\\E0＊ いっかい10Gポッキリだ。& &\\>0やる\\>1やらない\\C",
  "SCR_TEXT_xbox_94": "＊ ポーカー　できなく^1て&　 こころに　ポーッカリ&　 あなが　あいたか？/",
  "SCR_TEXT_xbox_95": "\\E1＊ かわりといっちゃ&　 なんだけど…^1　しょうひん&　 ゲットしたらさ…/",
  "SCR_TEXT_xbox_96": "\\E0＊ そいつを　しらべ^1て&　 オイラに&　 はなしかけてくれ。/",
  "SCR_TEXT_xbox_97": "\\E2＊ がんばったヤツは&　 ちゃんと　コケにしてやる&　 のが　れいぎだからな。/%",
  "SCR_TEXT_xbox_98": "\\E0＊ おっと　ざんねん^1。&　 テーブルに　せが&　 とどかないみたいだ。/",
  "SCR_TEXT_xbox_99": "\\E1＊ オイラが　みんなより&　 せが　たかいってこと&　 つい　わすれがちでさ。/",
  "SCR_TEXT_xbox_100": "\\E0＊ これじゃ　ゲームは&　 ムリだな。/",
  "SCR_TEXT_xbox_101": "\\E2＊ こんどから　かんばんに&　 ちゅういがきを&　 しておかないとな。/%",
  "SCR_TEXT_xbox_102": "\\E2＊ ひょっとし^1て&　 このテーブルの　たかさに&　 ビビッたのか？/%",
  "SCR_TEXT_xbox_103": "＊ オレに　みてほしいものが&　 あるのか！？/%",
  "SCR_TEXT_xbox_104": "＊ なんだ^1　なんだ^1？　なんのようだ！^1？&＊ オレの　コメントが　ほしければ&　 モノを　しらべて　はなしかけろ！/%",
  "SCR_TEXT_xbox_105": "＊ これって　いままでで　いちばん&　 おカネが　かせげる&　 しごとだミュウ～！/",
  "SCR_TEXT_xbox_106": "＊ …っつっても^1　だれかが&　 おきゅうりょう　くれるわけじゃ&　 ないけどね…/",
  "SCR_TEXT_xbox_107": "＊ ちょうどいい　ばしょが　あったから&　 かってに　ここで　はたらくことに&　 しただけなんだけどね…/",
  "SCR_TEXT_xbox_108": "＊ …だが！^1　オレはイヌのおとしものを&　 みつけたのだ^1！　これを　ふやして&　 ジャンジャンうって^1　カネをかせぐ！/",
  "SCR_TEXT_xbox_109": "＊ かせいだカネで　フレークスをかう^1！&　 じめんに　まいて　ころげまわれ^1ば&　 からだじゅう　フレークスまみれだ！/",
  "SCR_TEXT_xbox_110": "＊ オレと^1　アニマトロニック&　 ボイスボックスの　わらいごえ^1が&　 みごとに　ユニゾンするだろう！/%",
  "SCR_TEXT_xbox_111": "＊ その　かんばん^1　よいだろう！？/%",
  "SCR_TEXT_xbox_112": "＊ その　かんばん^1　よいだろう！？&＊ オレが　じきじきに　みつけたのだ！/%",
  "SCR_TEXT_xbox_113": "＊ それは^1…&＊ ヒューマノイドの　にんぎょうか…？/",
  "SCR_TEXT_xbox_114": "＊ そう^1…　そうだ^1！　そうだとも^1！&＊ ちょうど　からだを　さがしてる&　 ナイスな　ぼうれい　しってるぞ！/",
  "SCR_TEXT_xbox_115": "＊ かおだけ　べつのに　こうかんすれば&　 よろこんで　やどるだろう！/",
  "SCR_TEXT_xbox_116": "＊ それだけ　うでが　ながけれ^1ば&　 ナイフだって　もちほうだい^1！&　 ミュウ！/",
  "SCR_TEXT_xbox_117": "＊ ナイフ^1！&＊ ホンモノの^1　ちゃんと&　 じったいのあるナイフ！/%",
  "SCR_TEXT_xbox_118": "＊ ファストフード…^1？&＊ それは　あの　ろくでもない&　 METAグループの　みせのか？/",
  "SCR_TEXT_xbox_119": "＊ いらん^1　いらん^1！&　 そんなものは　いらん！/",
  "SCR_TEXT_xbox_120": "＊ あそこの　てんいんは　キモすぎる^1！&　 マジキモすぎて　わらえん！/",
  "SCR_TEXT_xbox_121": "＊ あいつは　オレを　ジロジロみる^1！&＊ 「はじめてみたよ…^1　こんなカワイイ&　 おんなのこ…」/",
  "SCR_TEXT_xbox_122": "＊ 「…が^1　くびを　270ど&　 まわして…」/",
  "SCR_TEXT_xbox_123": "＊ 「メニューに　のってる&　 ボスの　しゃしんを&　 きりぬいて…」/",
  "SCR_TEXT_xbox_124": "＊ 「じぶんの　しゃしんと　いれかえる&　 ところなんて」^1　とでも&　 いいたげに！/",
  "SCR_TEXT_xbox_125": "＊ ふつうだろう^1！&　 おんなのこなら　ふつうに&　 やるだろう！/%",
  "SCR_TEXT_xbox_126": "＊ めいさくゲームだと^1？　それは&　 「みゅうみゅう2：オニかわ　ダークネス&　 ファッションモード」のことだな！？/",
  "SCR_TEXT_xbox_127": "＊ わたしに　オシャレさせるゲームを&　 つくってくれたひとが　いるんだ&　 ミュウ～！　オニかわいいミュウ～！/",
  "SCR_TEXT_xbox_128": "＊ いいか！　「せっていが　こうしきと&　 ズレてる」などという　たわごとには&　 みみを　かすな。/",
  "SCR_TEXT_xbox_129": "＊ そういうことを　いうヤツは　きまっ^1て&　 オレが　みゅうみゅうのキャラを&　 ほうかいさせている　などとぬかす。/",
  "SCR_TEXT_xbox_130": "＊ オレの　しゃべりかたが&　 こんなふうで^1　あるきかたが&　 あんなふうだと　いうだけで！/",
  "SCR_TEXT_xbox_131": "＊ むじゃきに　ナイフを&　 ちらつかせているだけでも&　 もんくを　いわれるしまつだ！/",
  "SCR_TEXT_xbox_132": "＊ いいか^1　よくきけ　マヌケども^1！&＊ オレが　みゅうみゅうだ^1！&　 いさぎよく　あきらめろ！/",
  "SCR_TEXT_xbox_133": "＊ どっかのイベントで　オレがくちから&　 けむりを　モクモクはいてる&　 すがたが　もくげき　されても…/",
  "SCR_TEXT_xbox_134": "＊ それが　みゅうみゅうの&　 こうしきせってい　ということだ！/",
  "SCR_TEXT_xbox_135": "＊ オレの　からだは　つくりが　ザツで&　 しょっちゅう　けむりが　でるからな！/%",
  "SCR_TEXT_xbox_136": "＊ びようクリームか^1！&＊ びようクリーム　だいすき^1　ニャ！/",
  "SCR_TEXT_xbox_137": "＊ もちろん^1　オレには　まだ&　 みかくは　そなわっていない^1。&　 が…/",
  "SCR_TEXT_xbox_138": "＊ クリームを　ガリガリかみくだく&　 かんしょくは　さいこうだ！/",
  "SCR_TEXT_xbox_139": "＊ とはいえ　METAブランドには&　 だまされるな^1！&＊ ぜったい^1　ぜったい^1！　ぜったいに！/",
  "SCR_TEXT_xbox_140": "＊ このまえ　あのファストフードの&　 みせに　いったら^1　れいの&　 てんいんが…/",
  "SCR_TEXT_xbox_141": "＊ また　オレを　ジロジロみやがった^1。&　 このクリームで　アイスクリームを&　 つくれと　たのんだだけなのに！/",
  "SCR_TEXT_xbox_142": "＊ もしも～し？^1　アタマだいじょ～ぶ&　 ですか～？^1　カラダから&　 はずれかけてませんか～？/",
  "SCR_TEXT_xbox_143": "＊ しかし　アタマを　ぐるぐるまわして&　 はめなおしてやろうとした^1ら&　 ヤツは　おびえた^1！　なぜだ！/%",
  "SCR_TEXT_xbox_144": "＊ そのぼうし^1　ぜったい　アンダインに&　 にあうと　おもうミュウ！/",
  "SCR_TEXT_xbox_145": "＊ うしろに　あなが　あいてるから&　 そこからポニーテールを　だせば&　 ばっちりミュウ！/",
  "SCR_TEXT_xbox_146": "＊ …ん^1？&＊ まてよ^1！&＊ ちょっとまて！/",
  "SCR_TEXT_xbox_147": "＊ その　ぼうしは　うしろむきだ^1！&＊ それでは　ダメだ^1！&＊ イミがない！/",
  "SCR_TEXT_xbox_148": "＊ ツバのうえに　あなを　あけろ！&　 アンダインのポニーテールを&　 だす　あなを！/%",
  "SCR_TEXT_xbox_149": "＊ チケット…？^1　…しらん^1。&　 そんなものは　オレはしらん！/",
  "SCR_TEXT_xbox_150": "＊ は？^1　「あれは　ブルっちの&　 だったんじゃないか」だと^1？&　 しらんといったら　しらん！/",
  "SCR_TEXT_xbox_151": "＊ だいたい^1　あんな　ヘンタイロボ^1は&　 ブルっちの　きょういくじょう&　 よろしくない！/",
  "SCR_TEXT_xbox_152": "＊ あのロボは^1…&＊ フテキセツだ^1…&＊ にくたいを　もってるし！/",
  "SCR_TEXT_xbox_153": "＊ そもそも^1！　からだを　さがすために&　 いえを　でてから^1　なんかきまずく&　 なってるのは　オレのせいじゃない…/",
  "SCR_TEXT_xbox_154": "＊ た…たとえ^1　となりに　すんでたこ^1と&　 ブルっちに　バレたくないというのが&　 オレの　ほんねだとしてもだ…/",
  "SCR_TEXT_xbox_155": "＊ とにかく！^1　きさまごときには&　 とうてい　りかいできん^1！&　 ミュウ！/%",
  "SCR_TEXT_xbox_156": "＊ にやぁ～ん^1！　それって^1　カメラ！？&＊ わたしと　いっしょ^1に&　 セルフィーとりたいミュウ？/",
  "SCR_TEXT_xbox_157": "＊ ダメだ^1！　オレのしゃしんが&　 ほしければ^1　カネをはらってもらう^1！&　 こちとら　にんきしょうばいだ！/",
  "SCR_TEXT_xbox_158": "＊ オレの　だんまくにも　ピンクの&　 いしょうを　きせるのだ^1！&　 それには　カネが　かかるのだ！/",
  "SCR_TEXT_xbox_159": "＊ きさまは　じぶんの　セルフィーでも&　 とって^1　とうこう　すればいい^1！&　 イイネして^1　シェアしてやる！/%",
  "SCR_TEXT_xbox_160": "＊ その　しろいハコと　このからだは&　 ごかんせいが　あるはずだ！/",
  "SCR_TEXT_xbox_161": "＊ 「キスみゅう」の　ゲームも&　 あそべるぞ^1。&　 コントローラーの　ボタンをおすと…/",
  "SCR_TEXT_xbox_162": "＊ このからだに　しこまれている&　 ボイスボックスが^1　グラフィックスに&　 あわせて　しゃべるのだ！/",
  "SCR_TEXT_xbox_163a": "＊ アルフィーも　そのゲームを&　 プレイして^1　このからだの　ありかを&　 つきとめようと　した！/",
  "SCR_TEXT_xbox_163b": "＊ …オレが^1　その^1…&　 からだを　のっとって&　 にげたときにな！/",
  "SCR_TEXT_xbox_164": "＊ Xボタンを　れんだしながら&　 せまってくる^1　アルフィーの&　 あしおと…/",
  "SCR_TEXT_xbox_165": "＊ オレは　かべの　かげに　みをひそ^1め&　 くちと　ボイスボックスを　ひっしに&　 ふさごうとした…^1　が…/",
  "SCR_TEXT_xbox_166": "＊ からだが　かってに　さけんで&　 しまうのだ！^1　「ここよ！　わたしは&　 ここにいるミュウ～！」^1と！/",
  "SCR_TEXT_xbox_167": "＊ やがて　アルフィーは^1　かべの&　 すぐ　うらまで　きた^1…&　 もう　にげられない…　みつかる…！/",
  "SCR_TEXT_xbox_168": "＊ …そう　おもったしゅんかん&　 オレは　とっさに　たちあがり&　 じごえで　こうさけんだのだ。/",
  "SCR_TEXT_xbox_169": "\\W＊ \\R「ここだ！^1　オレは&　 ここにいるミュウ！」\\W/",
  "SCR_TEXT_xbox_170": "＊ アルフィーは　きぜつした。/",
  "SCR_TEXT_xbox_171": "＊ おっしまい♪/%",
  "SCR_TEXT_xbox_172": "＊ なに^1？&　 エナジードリンクだと^1？/",
  "SCR_TEXT_xbox_173": "＊ オレに　ひつような&　 エナジードリンクは&　 「でんき」のみッ！/",
  "SCR_TEXT_xbox_174": "＊ なぜなら　ボイスボックスの&　 じゅうでんを　おこたると…/",
  "SCR_TEXT_xbox_175": "＊ オレの　たいないか^1ら &　 あくまじみた　ひくいこえの&　 ボイスが　ながれだすのだ！/",
  "SCR_TEXT_xbox_176": "＊ 「エサを　くれええぇぇぇ…&　 ミュウウゥゥゥゥ…！^1」と！/",
  "SCR_TEXT_xbox_177": "＊ だが^1　あのバーガーショップの&　 てんいんは^1　バッテリースムージーを&　 つくることを　こばむ…/",
  "SCR_TEXT_xbox_178": "＊ さっさと　オレのからだを　あけ^1て&　 ながしこめば　よいものを！/",
  "SCR_TEXT_xbox_179": "＊ あの　おとこ…^1　どういうつもりだ^1！&＊ アルフィーに　なきつくしかないのか…&　 それだけは　カンベンだ！^1　ミュウ！/%",
  "SCR_TEXT_xbox_180": "＊ にやぁ～ん^1　へやじゅう&　 イヌのけ　だらけミュウ～^1！&＊ でも　これって　ちょっと…/",
  "SCR_TEXT_xbox_181": "＊ だんまくっぽ～い！/",
  "SCR_TEXT_xbox_182": "＊ ねえ　おぼえてるミュウ？&　 わたしが　わたの　かたまりを&　 あなたに　ポンポン　なげたこと！/",
  "SCR_TEXT_xbox_183": "＊ それから^1　だんがんたちを&　 ぜんいん　クビにしたこと！/",
  "SCR_TEXT_xbox_184": "＊ なつかしいね～^1！&　 こんどは　いつやるぅ！？/%",
  "SCR_TEXT_xbox_185": "＊ わぁ～！^1　これって　も^1う&　 500パーティクルは&　 とんでニャい！？/",
  "SCR_TEXT_xbox_186": "＊ ああ…おもいだすぞ…^1　からだを&　 きりつけられ^1　そこらじゅうに&　 わたが　とびちった　ひの　ことを…/",
  "SCR_TEXT_xbox_187": "＊ 「だいじょうぶだ　アンダイン^1！&　 すぐに　しゅうりできるから&　 てかげんは　むようだ！」/",
  "SCR_TEXT_xbox_188": "＊ …オレは　そういいたい^1…&　 しかし…オレが　このからだと&　 ひとつに　なってしまえば…/",
  "SCR_TEXT_xbox_189": "＊ …アンダインとのトレーニングは&　 もう　できなくなる^1…&　 おおケガを　しかねないからだ…/",
  "SCR_TEXT_xbox_190": "＊ ええい^1！　いいのだ^1！　わかってる^1！&＊ この　からだは　オレのもの^1！&　 アンダインの　ものではない！！/",
  "SCR_TEXT_xbox_191": "＊ それでも…^1　かのじょに　さされて&　 おおケガをする　じぶんを&　 そうぞうすると…　オレは…/",
  "SCR_TEXT_xbox_192": "＊ 「じぶんの　ハートに　しょうじきに！&　 ミュウ！」/",
  "SCR_TEXT_xbox_193": "＊ があああ^1！&＊ また　ボイスボックスが&　 かってに…！！/%",
  "SCR_TEXT_xbox_194": "＊ すご～い^1 500パーティクルは&　 とんでるミュウ！/",
  "SCR_TEXT_xbox_195": "＊ あのスロットマシン^1 メチャHD^1！&＊ てゆうか　ほとんど^1…&＊ 401K…？/%",
  "SCR_TEXT_xbox_196": "＊ じきに^1　なにもかもが&　 さまがわりして　しまうだろう…/",
  "SCR_TEXT_xbox_197": "＊ この　からだと　ひとつになれ^1ば&　 わたの　つまった　ホワホワな&　 にちじょうは　おわりをつげ…/",
  "SCR_TEXT_xbox_198": "＊ ネコみみしょうじょの　アニメキャラ&　 としての^1　あらたな　じんせいが&　 はじまるのだ。/",
  "SCR_TEXT_xbox_199": "＊ にくたいのある　じんせい^1。&＊ にくたいには^1　さまざまな^1…&＊ メンテナンスが　ひつようだ。/",
  "SCR_TEXT_xbox_200": "＊ どこかが　こわれたりすれ^1ば&　 アルフィーに　たすけを　もとめるしか&　 なくなるかもしれん…/",
  "SCR_TEXT_xbox_201": "＊ しょうじき　おそろしい^1。が^1　オレは&　 この　からだを　きにいっている^1。&　 もとの　すがたには　もどらん！/",
  "SCR_TEXT_xbox_202": "＊ …/",
  "SCR_TEXT_xbox_203": "＊ あー^1！&＊ ごめんニャ^1！　うっかり&　 わすれるとこだったミュウ！/",
  "SCR_TEXT_xbox_204": "＊ 1000パーティクル　たっせい&　 おめでとう^1！&　 ごほうびに…/",
  "SCR_TEXT_xbox_205": "＊ 1000パーティクル&　 サブスク・スペシャルを&　 プレゼントしちゃうミュウ！/",
  "SCR_TEXT_xbox_206": "\\W＊ ウソじゃないミュウ^1！&＊ あなただけに　あげる&　 \\Rスペシャル・ギフト\\W　ミュウ…/",
  "SCR_TEXT_xbox_207": "＊ みんなには　ナイショよ？/",
  "SCR_TEXT_xbox_208": "＊ さあ…^1　もっと　ちかくに　きて…/",
  "SCR_TEXT_xbox_209": "＊ めを　とじて…/",
  "SCR_TEXT_xbox_210": "＊ …じゃ^1　スーパーシークレット&　 ソング^1　うたってあげるね^1！&＊ オホン！^1　さん　ハイ…！/",
  "SCR_TEXT_xbox_211": "＊ う～う～う^2～&＊ う～う～う^2～&＊ う～う～う～^1～ う う～/",
  "SCR_TEXT_xbox_212": "＊ う～う～う～う～う～う～う～う～&＊ う～う～う～う～う～～/",
  "SCR_TEXT_xbox_213": "＊ う～～/",
  "SCR_TEXT_xbox_214": "＊ …/",
  "SCR_TEXT_xbox_215": "＊ ハハ…^1　ウワハハハ！&＊ どうだ！^1？　きさまの　ひよわな&　 こころは　とても　たえきれまい！/",
  "SCR_TEXT_xbox_216": "＊ (…にやぁ～ん　はずかしい^1！)&＊ もう　ぜったい　うたわないもんッ^1！&　 げきレアソング　ミュウ！/%",
  "SCR_TEXT_xbox_217": "＊ すご～い^1　1000パーティクル！&＊ おめでとう！/",
  "SCR_TEXT_xbox_218": "＊ …が！　あのうたは&　 にどと　うたわん！/",
  "SCR_TEXT_xbox_219": "＊ ふたたび　ききたけれ^1ば&  GamerBOXを　もう1だい&　 かうことだ！/%",
  "SCR_TEXT_xbox_220": "＊ イヌカジノへ　ようこそミュウ～！/",
  "SCR_TEXT_xbox_221": "＊ ごようけんを　どうぞ^1！&＊ わたしの　なまえは…/",
  "SCR_TEXT_xbox_222": "＊ まて^1。&＊ まてよ^1！&＊ ちょっと　まて！/",
  "SCR_TEXT_xbox_223": "＊ きさま…^1　きさまは^1！&　 きさまはーッ！^1！&＊ ひよわな^1　にっくき　ニンゲンめ！/",
  "SCR_TEXT_xbox_224": "＊ この　すがたになって&　 さいしょの　おしご^1と&　 おうえんしに　きてくれたのミュウ？/",
  "SCR_TEXT_xbox_225": "＊ ハハハ^1…&＊ アハハハハハハハハ！！^1！&＊ それは…/",
  "SCR_TEXT_xbox_226": "＊ とっても　うれしいぞ！！/",
  "SCR_TEXT_xbox_227": "＊ よ～し^1　それじゃ^1　おれいだミュウ～^1！&　 ニンゲンがゲットした　しょうひん^1に&　 みゅうみゅうが　コメントするミュウ～！/",
  "SCR_TEXT_xbox_228": "＊ しょうひんを　チェックしたら&　 わたしに　はなしかけてミュウ～！/%",
  "xbox_controller_connect_0": "コントローラーが　せつぞくされていません",
  "xbox_controller_connect_1": "コントローラーを　せつぞくしてください。",
  "xbox_controller_connect_2": "かわった　クセを　おもちのようで。",
  "xbox_controller_connect_3": "コントローうー　せつぞくされひいもせん",
  "xbox_controller_connect_4": "コントローうーが　せつぞくされひいもせん",
  "xbox_controller_connect_5": "アタマが　せつぞくされていません。\nどうたいが　せつぞくされていません。\nウデが　せつぞくされていません。\nアシが　せつぞくされていません。\nハダが　せつぞくされていません。\nミミが　せつぞくされていません。\nカオが　せつぞくされていません。\nクチが　せつぞくされていません。\nココロが　せつぞくされていません。\nハが　せつぞくされていません。\nココロが　せつぞくされていません。",
  "xbox_controller_connect_6": "イケメンスケルトンと　デートできて\nテンションがあがり　うっかり\nコントローラーを　ぬいてしまいましたね。\nわかります。"
}