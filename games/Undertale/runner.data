  "obj_phonecall_room_411": "* Ring.../",
  "obj_phonecall_room_412": "\\TS \\E3 \\F6 \\TA %",
  "obj_phonecall_room_413": "* Alphys^1! Here!/",
  "obj_phonecall_room_414": "\\E6* Th-that blue laser&  seems totally&  impassable!/",
