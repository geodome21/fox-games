  "obj_core_laserswitch_138": "* Click.../%%",
  "obj_countermiddle_116": "* PERFECT^1!&* GREAT JOB^1, BEAUTIFUL!/",
  "obj_countermiddle_117": "* WE'VE GOT ALL OF THE&  INGREDIENTS WE NEED TO BAKE&  THE CAKE!/",
  "obj_countermiddle_118": "\\W* \\YMILK\\W... &* \\YSUGAR\\W...&* \\YEGGS\\W.../",
  "obj_countermiddle_119": "* ... OH MY^1!&* WAIT A MAGNIFICENT MOMENT^1!&* HOW COULD I FORGET!!!/",
  "obj_countermiddle_120": "\\W* WE'RE MISSING THE MOST&  \\YIMPORTANT INGREDIENT\\W!/%%",
  "obj_creditsloader_449": "\\XI mean^1, we haven't&even done the\\R &Special Thanks\\X yet.../",
