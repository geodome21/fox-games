  "obj_mainend_843": "THANK YOU^1, HUMAN!/",
  "obj_mainend_844": "COME BACK AND&VISIT SOMETIME!!/",
  "obj_mainend_845": "\\E3WAIT..^1.&UNDYNE WOULD&PROBABLY KILL YOU./",
  "obj_mainend_846": "\\E0BUT..^1.&YOU'D GET TO&SEE ME./",
  "obj_mainend_847": "SO YOU GOTTA&RISK IT!!!/",
  "obj_mainend_848": "YOU GOTTA!!!/",
  "obj_mainend_849": "SEE YOU SOON./%%",
  "obj_mainend_875": "* so^1, it's been a&  while./",
  "obj_mainend_876": "\\E1* since you left^1, things&  have..^1.&* gotten interesting./",
  "obj_mainend_877": "\\E0* with ASGORE gone^1, the&  people looked to&  undyne to rule.../",
  "obj_mainend_878": "\\E3* but she was nowhere&  to be found./",
  "obj_mainend_879": "\\E2* so mettaton just&  kind of..^1.&* took over?/",
  "obj_mainend_880": "\\E1* he's brainwashed&  everyone with his&  stupid TV show./",
  "obj_mainend_881": "* and made the&  underground into his&  personal paradise./",
  "obj_mainend_882": "\\E3* it's honestly..^1.&* kinda disturbing./",
  "obj_mainend_883": "\\E1* as for me^1?&* oh^1, yeah.../",
  "obj_mainend_884": "\\E2* i'm his agent./%%",
  "obj_mainend_896": "\\E0* HEY THERE^1, DARLING!/",
  "obj_mainend_897": "* THANK YOU SO MUCH FOR&  YOUR HARD WORK.../",
  "obj_mainend_898": "* THANKS TO YOU, THE&  UNDERGROUND IS MORE&  EXCITING THAN EVER!/",
  "obj_mainend_899": "\\E7* OOH LA LA...&* STATUES... MONUMENTS&  TO MY BEAUTY.../",
  "obj_mainend_900": "\\E6* FLOWERS IN THE&  ARRANGEMENT OF MY&  NAME.../",
  "obj_mainend_901": "\\E5* HEDGES IN THE SHAPE&  OF MY SMILE.../",
  "obj_mainend_902": "\\E8* UNDER MY RULE, THE&  UNDERGROUND'S PROBLEMS&  ARE OVER, BABY!/",
  "obj_mainend_903": "\\E7* CROWDING?&* DREARINESS???/",
  "obj_mainend_904": "\\E9* WHO NEEDS THE SUN&  WHEN YOU'VE GOT&  THE SPOTLIGHT!!?/",
  "obj_mainend_905": "\\E1* ECONOMIC COLLAPSE?&* EDUCATION PROBLEMS?&* WHAT!?/",
  "obj_mainend_906": "\\E8* EVERYTHING'S COVERED&  IN GOLDEN GLITTER!/",
  "obj_mainend_907": "\\E6* THERE ARE NO&  PROBLEMS, BEAUTIFUL!/",
  "obj_mainend_908": "\\E0* AND, I'VE ENSTATED&  A NEW POLICY ON&  HUMANITY./",
  "obj_mainend_909": "\\E1* IF A HUMAN FALLS DOWN&  HERE.../",
  "obj_mainend_910": "\\E6* THEY CAN JOIN MY&  FAN CLUB FOR FREE!/",
