  "obj_core_enemyevent_188": "* (Click...)/%%",
  "obj_core_enemyevent2_142": "* Ring.../",
  "obj_core_enemyevent2_143": "\\TS \\E3 \\F6 \\TA %",
  "obj_core_enemyevent2_144": "* Sorry^1, I..^1. I.../",
  "obj_core_enemyevent2_145": "* I thought that.../",
  "obj_core_enemyevent2_146": "\\E8* Let's try the&  right path instead./",
  "obj_core_enemyevent2_147": "\\TS \\F0 \\T0 %",
  "obj_core_enemyevent2_148": "* (Click...)/%%",
  "obj_core_enemyevent2_152": "* Ring.../",
  "obj_core_enemyevent2_153": "\\TS \\E3 \\F6 \\TA %",
  "obj_core_enemyevent2_154": "* A-are you okay?/",
  "obj_core_enemyevent2_155": "* Why didn't you&  head to the&  right...?/",
  "obj_core_enemyevent2_156": "\\E4* C-C'mon..^1.&* Y-you trust me^1,&  d-don't you?/",
  "obj_core_enemyevent2_157": "\\TS \\F0 \\T0 %",
  "obj_core_enemyevent2_158": "* (Click...)/%%",
  "obj_core_laserswitch_118": "* Ring.../",
  "obj_core_laserswitch_119": "\\TS \\E3 \\F6 \\TA %",
  "obj_core_laserswitch_120": "* Oh my god^1, are&  you okay?/",
  "obj_core_laserswitch_121": "\\E8* I..^1. I'm sorry^1, I&  gave you the&  wrong order./",
  "obj_core_laserswitch_122": "\\E8* .../",
  "obj_core_laserswitch_123": "\\E6* E-everything's fine^1,&  okay?/",
  "obj_core_laserswitch_124": "* L-let's just keep&  heading to the&  right./",
  "obj_core_laserswitch_125": "\\TS \\F0 \\T0 %",
  "obj_core_laserswitch_126": "* Click.../%%",
  "obj_core_laserswitch_130": "* Ring.../",
  "obj_core_laserswitch_131": "\\TS \\E3 \\F6 \\TA %",
  "obj_core_laserswitch_132": "* Oh my god..^1.&* Are you hurt?/",
  "obj_core_laserswitch_133": "\\E8* I..^1. I'm so sorry^1,&  I... I gave you&  the wrong order./",
  "obj_core_laserswitch_134": "\\E8* .../",
  "obj_core_laserswitch_135": "\\E6* Everything's going&  to be fine^1, okay?/",
  "obj_core_laserswitch_136": "* L-let's just keep&  heading to the&  right./",
