  "SCR_TEXT_1313": "＊ ここには　なにもない！/%%",
  "SCR_TEXT_132": "＊ (そうおもったら&　 ケツイが　みなぎった)/%%",
  "SCR_TEXT_1329": "＊ (よごれたエプロンを&　 てにいれた)/%%",
  "SCR_TEXT_133": "＊ (いせきに　こんな　かわいらしい&　 いえが　あるのをみ^1て&　 ケツイが　みなぎった)/%%",
