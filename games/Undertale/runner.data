  "obj_lemonbread_207": "%%%",
  "obj_lemonbread_429": "* Smells like sweet lemons.",
  "obj_lemonbread_433": "* You hear the melody of&  pulsating flesh.",
  "obj_lemonbread_434": "* Could this be goodbye!?",
  "obj_lemonbread_435": "* Monster has low HP.",
