  "obj_controlspear_176": "* Undyne.",
  "obj_controlspear_192": "* Fridge - Full of food.",
  "obj_controlspear_204": "* Sword - Acquired taste.",
  "obj_controlspear_select": "* Select with \\*Z.",
  "obj_controlspear_218": "\\E1* ... are you.../",
  "obj_controlspear_219": "\\E5* Hitting on me????/%%",
  "obj_controlspear_223": "* ????????????????/%%",
  "obj_controlspear_235": "* The sugar is for&  tea^1, mmm'kay?/%%",
  "obj_controlspear_243": "* Oh^1, soda?/",
  "obj_controlspear_244": "\\E4* Actually^1, even though&  you pointed to it^1,&  you don't look happy./",
  "obj_controlspear_245": "\\E0* Heh^1, that's fine^1!&* I think soda's gross^1,&  too!/",
  "obj_controlspear_246": "\\E4* It rots your teeth..^1.&* It rots your mind.../",
  "obj_controlspear_247": "\\E1* IT ROTS YOUR FIGHTING&  SPIRIT!/",
  "obj_controlspear_248": "\\E9* ... huh^1?&* Why do I have it?/",
  "obj_controlspear_249": "\\E8* .../%%",
  "obj_controlspear_253": "* What^1?&* You wanna throw the&  spear at it?/%%",
  "obj_controlspear_261": "* Oh^1, you want some&  hot chocolate?/",
  "obj_controlspear_262": "\\E1* Wait^1, wait^1, I just&  remembered..^1.&* That container's empty./",
  "obj_controlspear_263": "\\E9* I stopped getting&  it because it was&  always a hassle.../",
  "obj_controlspear_264": "\\E6* ASGORE kept getting&  marshmallows stuck in&  his beard./%%",
  "obj_controlspear_268": "* That container's empty./%%",
  "obj_controlspear_276": "\\E9* ... tea^1, huh^1?&* Coming right up!/%%",
  "obj_controlspear_284": "* The fridge!^1?&* You want to have&  the entire fridge!?/",
  "obj_controlspear_285": "\\E1* No!/%%",
  "obj_controlspear_291": "* Believe me^1, I would&  GLADLY give you your&  fill of swords./",
  "obj_controlspear_292": "\\E9* If you weren't my&  beloved houseguest!/%%",
  "obj_convenientlamp_55": "* Just a conveniently-shaped&  lamp./%%",
  "obj_cookshowevent_89": "* Ring.../",
  "obj_cookshowevent_90": "\\TS \\E3 \\F6 \\TA %",
  "obj_cookshowevent_91": "* H-hey^1, it's kind of&  dark \\M9in there^1, isn't&  it?/",
  "obj_cookshowevent_92": "\\E6* Don't worry!/",
  "obj_cookshowevent_93": "\\E0*\\M8 I'll hack into the&  light system and&  brighten it up!/%%",
  "obj_cookshowevent_135": "* Oh no./%%",
  "obj_cookshowevent_156": "* OHHHH YES!!!/",
  "obj_cookshowevent_157": "* WELCOME^1, BEAUTIES, TO THE&  UNDERGROUND'S PREMIER COOKING&  SHOW!!!/%%",
  "obj_cookshowevent_174": "* PRE-HEAT YOUR OVENS^1, BECAUSE&  WE'VE GOT A VERY SPECIAL&  RECIPE FOR YOU TODAY!/",
  "obj_cookshowevent_175": "* WE'RE GOING TO BE MAKING.../",
  "obj_cookshowevent_176": "* A CAKE!/",
  "obj_cookshowevent_177": "* MY LOVELY ASSISTANT HERE&  WILL GATHER THE INGREDIENTS./",
  "obj_cookshowevent_178": "* EVERYONE GIVE THEM A BIG&  HAND!!!/%%",
  "obj_cookshowevent_202": "\\W* WE'LL NEED \\YSUGAR^1,&  MILK^1, \\WAND\\Y EGGS.\\W /",
  "obj_cookshowevent_203": "* GO FOR IT^1, SWEETHEART!/%%",
  "obj_cookshowevent_253": "\\W* A \\YHUMAN SOUL\\W!!!!/%%",
  "obj_cookshowevent_295": "* Ring.../",
  "obj_cookshowevent_296": "\\TS \\E3 \\F0 \\TM %",
  "obj_cookshowevent_297": "* HELLO...?&* I'M KIND OF IN THE&  MIDDLE OF SOMETHING HERE./",
  "obj_cookshowevent_298": "\\TS \\E3 \\F6 \\TA %",
  "obj_cookshowevent_299": "* W-wait a second!!!/",
  "obj_cookshowevent_300": "* Couldn't you make&  a.../",
  "obj_cookshowevent_301": "\\E6* Couldn't you use&  a.../",
  "obj_cookshowevent_302": "\\E4* Couldn't you make&  a substitution in&  the recipe?!/",
  "obj_cookshowevent_303": "\\TS \\E3 \\F0 \\TM %",
  "obj_cookshowevent_304": "* ... A SUBSTITUTION?&* YOU MEAN, USE A DIFFERENT,&  NON-HUMAN INGREDIENT?/",
  "obj_cookshowevent_305": "* ... WHY?/",
  "obj_cookshowevent_306": "\\TS \\E6 \\F6 \\TA %",
  "obj_cookshowevent_307": "* Uhh^1, what if&  someone's.../",
  "obj_cookshowevent_308": "\\E2* .../",
  "obj_cookshowevent_309": "\\E4* Vegan?/",
  "obj_cookshowevent_310": "\\TS \\E3 \\F0 \\TM %",
  "obj_cookshowevent_311": "* ... VEGAN./",
  "obj_cookshowevent_312": "\\TS \\E5 \\F6 \\TA %",
  "obj_cookshowevent_313": "* Uh well I mean%%",
  "obj_cookshowevent_326": "* THAT'S A BRILLIANT IDEA,&  ALPHYS!!/",
  "obj_cookshowevent_327": "* ACTUALLY, I HAPPEN TO&  HAVE AN OPTION RIGHT HERE!!!/",
  "obj_cookshowevent_328": "* MTT-BRAND ALWAYS-CONVENIENT&  HUMAN-SOUL-FLAVOR-SUBSTITUTE!/",
  "obj_cookshowevent_329": "* A CAN OF WHICH...&* IS JUST OVER ON THAT&  COUNTER!!!/%%",
  "obj_cookshowevent_376": "* WELL, DARLING?&* WHY DON'T YOU GO GET IT?/%%",
  "obj_cookshowevent_434": "* BY THE WAY^1, OUR SHOW RUNS ON&  A STRICT SCHEDULE./",
  "obj_cookshowevent_435": "\\W* IF YOU CAN'T GET THE&  CAN IN THE NEXT&  \\YONE MINUTE...\\W /",
  "obj_cookshowevent_436": "\\W* WE'LL JUST HAVE TO GO&  BACK TO THE \\RORIGINAL PLAN\\W!!!/",
  "obj_cookshowevent_437": "* SO...&* BETTER START CLIMBING,&  BEAUTIFUL!!!/%%",
  "obj_cookshowevent_472": "* Ring.../",
  "obj_cookshowevent_473": "\\TS \\E3 \\F6 \\TA %",
  "obj_cookshowevent_474": "* Oh no!!^1!&* There's not enough&  time to climb up!/",
  "obj_cookshowevent_475": "\\E2* .../",
  "obj_cookshowevent_476": "\\E6* F-f-fortunately, I&  might have a plan!/",
  "obj_cookshowevent_477": "\\E0* When I was upgrading&  your phone, I added&  a few... features./",
  "obj_cookshowevent_478": "\\E6* You see that huge&  button that says..^1.&* \"JETPACK\"?/",
  "obj_cookshowevent_479": "\\E3* Watch this!/%%",
  "obj_cookshowevent_515": "* There!/",
  "obj_cookshowevent_516": "* You should have&  just enough fuel to&  reach the top!/",
  "obj_cookshowevent_517": "\\E3* Now^1, get up&  there!!!/%%",
  "obj_cookshowevent_565": "* Ring.../",
  "obj_cookshowevent_566": "\\TS \\E3 \\F6 \\TA %",
  "obj_cookshowevent_567": "* Wow^1!&* We..^1. we did it!!/",
  "obj_cookshowevent_568": "\\E0* We..^1. we really did&  it!!!/",
  "obj_cookshowevent_569": "\\E0* Great job out&  there^1, team!/",
  "obj_cookshowevent_570": "\\E3* W-well^1, uh^1, anyway^1,&  let's keep heading&  forward!!!/",
  "obj_cookshowevent_571": "\\TS \\F0 \\T0 %",
  "obj_cookshowevent_572": "* Click.../%%",
  "obj_cookshowevent_575": "* Ring.../",
  "obj_cookshowevent_576": "\\TS \\E1 \\F6 \\TA %",
  "obj_cookshowevent_577": "* .../",
  "obj_cookshowevent_578": "\\E4* U-um..^1.&* I guess we..^1.&* ... did it?/",
  "obj_cookshowevent_579": "\\E3* W-well^1, uh^1, anyway^1,&  let's keep heading&  forward!!!/",
  "obj_cookshowevent_580": "\\TS \\F0 \\T0 %",
  "obj_cookshowevent_581": "* Click.../%%",
  "obj_core_enemyevent_97": "* Ring.../",
  "obj_core_enemyevent_98": "\\TS \\E6 \\F6 \\TA %",
  "obj_core_enemyevent_99": "* H-hey^1, why don't&  you try to use&  the elevator first?/",
  "obj_core_enemyevent_100": "* .../%%",
  "obj_core_enemyevent_106": "* Ring.../",
  "obj_core_enemyevent_107": "\\TS \\E6 \\F6 \\TA %",
