  "mett_opera1_1": "Oh my love        ",
  "mett_opera1_2": "Please run away   ",
  "mett_opera1_3": "Monster King       ",
  "mett_opera1_4": "Forbids your stay  ",
  "mett_opera1_5": "Humans must       ",
  "mett_opera1_6": "Live far apart    ",
  "mett_opera1_7": "Even if             ",
  "mett_opera1_8": "It breaks my heart  ",
  "mett_opera1_9": "They'll put you    ",
  "mett_opera1_10": "In the dungeon     ",
  "mett_opera1_11": "It'll suck         ",
  "mett_opera1_12": "And then you'll#die a lot  ",
  "mett_opera1_13": "Really sad         ",
  "mett_opera1_14": "You're gonna die     ",
  "mett_opera1_15": "Cry cry cry      ",
  "mett_opera1_16": "So sad it's#happening.       ",
  "mett_opera2_1": "Oh my love",
  "mett_opera2_2": "Has fallen#down",
  "mett_opera2_3": "Now in tears",
  "mett_opera2_4": "We all will#drown",
  "mett_opera2_5": "Colored#tiles",
  "mett_opera2_6": "Make them#a fool",
  "mett_opera2_7": "If only they",
  "mett_opera2_8": "Still knew#the rules",
  "mett_opera2_9": "Well that#was",
  "mett_opera2_10": "A sorry try",
  "mett_opera2_11": "Now let's#watch",
  "mett_opera2_12": "Them fry",
  "mett_operacomment_1": "(Hmmm? Getting creative?)",
  "mett_operacomment_2": "(Dance with me, darling.)",
  "mett_operacomment_3": "(Oh! The audience can feel#your passion!)",
  "mett_operacomment_3_unfrantic": "(Show the audience#your passion!)",
  "mett_operacomment_3_touch": "(So close... How passionate...)",
  "mett_operacomment_3_frantic1": "(... do you need some help?)",
  "mett_operacomment_3_frantic2": "(... what ARE you doing?)",
  "mett_operacomment_4": "(Don't stop now!)",
  "mett_operacomment_4_unfrantic": "(Look at you, leaping around#the stage...)",
  "mett_operacomment_4_touch": "(Can't keep your hands off, huh?)",
  "mett_operacomment_4_frantic1": "(Is that how humans dance?)",
  "mett_operacomment_4_frantic2": "(Humans are stranger#than I thought.)",
  "mett_operacomment_5": "(Oh! They're really#getting into it.)",
  "mett_operacomment_5_unfrantic": "(Moving so far...)",
  "mett_operacomment_5_touch": "(Who can blame you?)",
  "mett_operacomment_5_frantic1": "(Hmmm, I'll have to get used#to it...)",
  "mett_operacomment_5_frantic2": "(Even better than#I thought...)",
  "mett_operacomment_6": "(So that's what#it's like.)",
  "mett_operacomment_7": "(Dancing with... A human.)",
  "mett_operacomment_8": "(What a shame...)",
