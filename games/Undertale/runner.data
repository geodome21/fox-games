  "obj_phonecall_room_276": "\\TS \\E6 \\F6 \\TA %",
  "obj_phonecall_room_277": "* Ready^1?&* This is it!/",
  "obj_phonecall_room_278": "* Take the elevator&  up to the top&  of the CORE!/",
  "obj_phonecall_room_279": "\\TS \\F0 \\T0 %",
