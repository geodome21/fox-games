  "SCR_TEXT_2252": "* (There's another quantum&  physics book...)/",
  "SCR_TEXT_2253": "* (You decide to stop.)/%%",
  "SCR_TEXT_2257": " %%",
  "SCR_TEXT_2265": "THAT'S MY ROOM^1!/",
  "SCR_TEXT_2266": "IF YOU'VE&FINISHED LOOKING&AROUND.../",
  "SCR_TEXT_2267": "WE COULD GO IN&AND.../",
  "SCR_TEXT_2268": "\"HANG-OUT\" LIKE&A PAIR OF VERY&COOL FRIENDS?/",
  "SCR_TEXT_2269": "\\E3DO WHATEVER&PEOPLE DO WHEN&THEY DATE???/",
  "SCR_TEXT_2270": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_2271": "* (Go inside?)& &         Yes         No\\C",
  "SCR_TEXT_2272": " %",
  "SCR_TEXT_2276": "* (It's the door to&  Papyrus's room.)/",
  "SCR_TEXT_2277": "* (It's covered in many&  labels...)/",
  "SCR_TEXT_2278": "\\TP %",
  "SCR_TEXT_2279": "* (NO GIRLS ALLOWED!)/",
  "SCR_TEXT_2280": "* (NO BOYS ALLOWED!)/",
  "SCR_TEXT_2281": "* (PAPYRUS ALLOWED.)/%%",
  "SCR_TEXT_2286": " %%",
  "SCR_TEXT_2297": "THERE ARE NO&SKELETONS INSIDE&MY CLOSET!!!/",
  "SCR_TEXT_2298": "\\E3EXCEPT ME&SOMETIMES./",
  "SCR_TEXT_2299": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_2300": "* (Look in the closet?)& &         Yes         No\\C",
  "SCR_TEXT_2301": " ",
  "SCR_TEXT_2305": "* (Look in the closet?)& &         Yes         No\\C",
  "SCR_TEXT_2306": " ",
  "SCR_TEXT_2313": "* (Clothes are hung up&  neatly inside.)/%%",
  "SCR_TEXT_2317": " %%",
  "SCR_TEXT_2322": "IT'S OK TO BE&INTIMIDATED BY&MY FASHION SENSE./%%",
  "SCR_TEXT_2328": "\\E3SO^1, UM.../",
  "SCR_TEXT_2329": "\\E3IF YOU'VE SEEN&EVERYTHING.../",
  "SCR_TEXT_2330": "\\E2DO YOU WANT TO&START HANGING OUT?/",
