  "obj_core_enemyevent_117": "\\TS \\E6 \\F6 \\TA %",
  "obj_core_enemyevent_118": "* Okay^1, you should&  be able to make&  it through here.../",
  "obj_core_enemyevent_119": "* .../%%",
  "obj_core_enemyevent_139": "* W-watch out!/%%",
  "obj_core_enemyevent_182": "* Th-that was close.../",
  "obj_core_enemyevent_183": "* Wh..^1. why are there&  so many monsters&  here?/",
  "obj_core_enemyevent_184": "\\E6* I mean..^1.&* It's no problem^1,&  r-r-right?/",
  "obj_core_enemyevent_185": "* W-w-we've just got&  to keep heading&  forward!/",
  "obj_core_enemyevent_186": "\\E9* .../",
