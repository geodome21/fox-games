  "battle_name_c": "C",
  "battle_name_header": "   ＊ ",
  "blt_sizebone_115": "THIS IS AN&ERROR&MESSAGE^1.&REALLY!!!/%%",
  "blt_sizebone_118": "きさまは&よわ&すぎる！&こんなに&カンタンに&つかまえ&られる&とはなッ！/",
  "blt_sizebone_119": "これから&きさまを、&「プリズン&ゾーン」に&とじこめて&やるッ！/",
  "blt_sizebone_120": "兄ちゃんが&いう&ところの…/",
  "blt_sizebone_121": "「うちの&ガレージ」&だッ！/",
  "blt_sizebone_122": "きさまは&イヌごや&いき&だぞッ！/",
  "blt_sizebone_123": "ニャハハハ&ハハハ！/%%",
  "blt_sizebone_127": "さっきは&だっそう&できたかも&しれない&が… /",
  "blt_sizebone_128": "こんかいは&せつびを&アップ&グレード&したからな/",
  "blt_sizebone_129": "きさまは&ふたたび&とじこめ&られ…/",
  "blt_sizebone_130": "にげたく&なくなって&しまう&だろう！/",
  "blt_sizebone_131": "ニャハハハ&ハハハ！/%%",
  "blt_sizebone_136": "きさまも&しつこい&ヤツだな… /",
  "blt_sizebone_137": "だが^1！&オレさま&には&つうよう&しないッ！/",
  "blt_sizebone_138": "オレさまの&ほうが&モーレツ&しつこい&からなッ！/",
  "blt_sizebone_139": "もし、&きさまが&「じぶんの&ほうが&ぜんぜん&しつこい」&と&おもっている&なら…/",
  "blt_sizebone_140": "それは&ちがうぞ…&ブンポウ&テキに&まちがって&いるッ！/",
  "blt_sizebone_141": "ただしく&は…/",
  "blt_sizebone_142": "「ぜんぜん&しつこく&ないとも&いえなくも&なくも&ない」…&だッ！/\"",
  "blt_sizebone_143": "どうだッ！&べんきょう&に&なったか！/",
  "blt_sizebone_144": "ニャハハハ&ハハハ！/%%",
