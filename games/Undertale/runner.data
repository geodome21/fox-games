  "SCR_TEXT_1294": "* (You got the Burnt Pan.)/%%",
  "SCR_TEXT_1297": "* (You're carrying too much.)/%%",
  "SCR_TEXT_1301": " %%",
  "SCR_TEXT_1308": "* (There's an apron lying on&  the ground.)/",
  "SCR_TEXT_1309": "* (Will you take it?)& &         Take it     Leave it  \\C ",
