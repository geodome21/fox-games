  "obj_torboss_2ndtime_153": "And that's the&end of Hard&Mode!/%%",
  "obj_torboss_2ndtime_175": "\\E1Eh??/",
  "obj_torboss_2ndtime_176": "\\E2You are ending&it NOW?/",
  "obj_torboss_2ndtime_177": "\\E1And on such a&dramatic moment...?/%%",
  "obj_torboss_2ndtime_192": "That's the&difficult part./",
  "obj_torboss_2ndtime_193": "Not the bullets./",
  "obj_torboss_2ndtime_194": "\\M2But^1, accepting&that it's all&over.../%%",
  "obj_torboss_2ndtime_211": "But there WILL be&more^1, will there&not?/%%",
  "obj_torboss_2ndtime_224": "\\M1Maybe./",
  "obj_torboss_2ndtime_225": "\\M2Knowing the&answer is.../",
  "obj_torboss_2ndtime_226": "\\M2... HARD./",
  "obj_torboss_2ndtime_227": "\\E4.../%%",
  "obj_torboss_2ndtime_264": "Hey!/",
  "obj_torboss_2ndtime_265": "Aren't you&supposed&to be dying or&something?/%%",
  "obj_torboss_2ndtime_280": "Well^1.&What is the point&of that now?/%%",
  "obj_torboss_2ndtime_293": "What will you do&instead...?/%%",
  "obj_torboss_2ndtime_308": "Hmmm^1.&Perhaps I will&bake another pie./",
  "obj_torboss_2ndtime_309": "That last one ended&up a little burnt./%%",
  "obj_torboss_2ndtime_324": "\\E2I thought it was&good./",
  "obj_torboss_2ndtime_325": "\\E1Theoretically./",
  "obj_torboss_2ndtime_326": "\\E4It's not like I&ate it all while&you were&fighting./%%",
  "obj_torboss_2ndtime_360": "Hey^1! Hey^1!&Can I have some&pie!/%%",
  "obj_torboss_2ndtime_377": "You are just going&to eat it all.../%%",
  "obj_torboss_2ndtime_400": "I can helllp!!!/%%",
  "obj_torboss_2ndtime_415": "Snoring on the&floor is NOT help./%%",
  "obj_torboss_2ndtime_429": "I'm not snoring^1,&I'm cheering you&on in my sleep!!/",
  "obj_torboss_2ndtime_430": ".../",
  "obj_torboss_2ndtime_431": "Oh^1, you're still&here?/",
  "obj_torboss_2ndtime_432": "Don't you have&anything better&to do?/%%",
  "obj_torboss_2ndtime_512": "\\E0Hey./",
  "obj_torboss_2ndtime_513": "\\E3What's the hold&up!?/",
  "obj_torboss_2ndtime_514": "\\E9Shouldn't she be&dead by now!?/",
  "obj_torboss_2ndtime_515": "\\E1I've been waiting&in that room for.../",
  "obj_torboss_2ndtime_516": "\\E6.../",
  "obj_torboss_2ndtime_517": "\\E7... Hard mode...?/",
  "obj_torboss_2ndtime_518": "\\E0Gee^1, you better&take a picture./",
  "obj_torboss_2ndtime_519": "People are gonna&think you're REALLY&cool./",
  "obj_torboss_2ndtime_520": "\\E9... NOT!/",
  "obj_torboss_2ndtime_521": "\\E8Golly^1, talk about&a tryhard./",
  "obj_torboss_2ndtime_522": "PA^1. THE^1. TIC./%%",
  "obj_torboss_2ndtime_544": "\\E0Uh^1, so^1, are you&gonna keep going^1,&or...?/%%",
  "obj_torboss_2ndtime_558": "It's over./%%",
  "obj_torboss_2ndtime_578": "\\E8Hahaha^1!&I KNEW that!/",
  "obj_torboss_2ndtime_579": "Why does everyone&have to be so&condescending!?/",
  "obj_torboss_2ndtime_580": "\\E1.../",
  "obj_torboss_2ndtime_581": "\\E8So what's YOUR&excuse^1?&Sitting around&here...?/",
  "obj_torboss_2ndtime_582": "\\E0Don't you have&anything better to%%",
  "obj_torboss_2ndtime_595": "I already said&that./%%",
  "obj_tordogcall_64": "* Ring..\\E0.\\TT /",
  "obj_tordogcall_65": "\\F1 %",
  "obj_tordogcall_66": "* Hello^1!&* This is TORIEL./",
