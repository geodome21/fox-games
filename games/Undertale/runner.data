  "SCR_TEXT_1345": " ",
  "SCR_TEXT_1348": "＊ (からっぽのゴミばこだ)/%%",
  "SCR_TEXT_135": "＊ (はじめてみるせかいの&　 つめたいくうきに　ふれて&　 ケツイが　みなぎった)/%%",
  "SCR_TEXT_136": "＊ (あのランプの　かたちの&　 ちょうどよさを　おもいだすと&　 ケツイが　みなぎった)/%%",
