  "obj_mettnewsevent_999": "\\M9＊ なんということだ^1！&＊ またしても　してやられたッ！/",
  "obj_mettsugar_58": "＊ (さとうを　みつけた)/%%",
  "obj_mettwallhole_58": "＊ (かべの　うらには　はば1メートル&　 ほどの　せまいスペースがある)/%%",
  "obj_mettwallhole_61": "＊ (ただの　かざりの　ようだ)/%%",
  "obj_mewmew_body_105": "\\E4バカめ！　そんな　ぶきで&オレに　ダメージを&あたえられると　おもうか！？/",
  "obj_mewmew_body_106": "\\E7ガードを　かためて&いるかぎり&このからだは　むてきだ！/",
  "obj_mewmew_body_107": "\\E2(しかも　とっても&キュートだミュウ～)/%%",
  "obj_mewmew_body_110": "\\E8おい！きいてなかったのか！？&オレに　ダメージを&あたえることはできん！！/",
  "obj_mewmew_body_111": "\\E6いや^1…&まて^1！&まてよ！？/",
  "obj_mewmew_body_112": "\\E7そういうことか！！&さては　きさま^1　オレの&かんじょうを　かいほう&しようと　しているな！/",
  "obj_mewmew_body_113": "\\E4よし^1　そのままつづけろ！&その　きたならしい&にくたいで　オレを&こうげきしつづけろ！/%%",
  "obj_mewmew_body_117": "\\E4この　すがたなら&せかいいちキュートな&デュラハンになれるに&ちがいない！/",
  "obj_mewmew_body_118": "\\E2あとは　せなかに　のれる&おっきなニャンコを&みつけるだけミュウ～！/%%",
  "obj_mewmew_body_122": "\\E8クッ^1…　そろそろ&たえつづけるのも&くつうに　なってきたぞ！！/%%",
  "obj_mewmew_body_127": "\\E8おいッ！くうきを　よめ！！/%%",
  "obj_mewmew_body_132": "\\E0え～　ウソ～&しんじられないミュウ～/%%",
  "obj_mewmew_body_347": "＊ ぷんすかみゅうみゅうは&　 もうれつに　ミュウミュウ&　 ないている。",
  "obj_mewmew_body_371": "あらたな　じんせい！！^8 %%",
  "obj_mewmew_body_372": "イケてる　じんせい！！^8 %%",
  "obj_mewmew_body_383": "オレは　しゅくふくする^8！ %%",
  "obj_mewmew_body_384": "ふたりを　しゅくふく&してやる^8！ %%",
  "obj_mewmew_body_385": "ハハハハハ！&よかったなッ^8！ %%",
  "obj_mewmew_body_386": "すえながく&おしあわせにッ^8！ %%",
  "obj_mewmew_body_387": "せかいいち　しあわせに&なるといい！^8！ %%",
  "obj_mewmew_body_388": "ハハハ！！^8！ %%",
  "obj_mewmew_body_394": "くらえ！^8！ %%",
  "obj_mewmew_body_395": "これも　くらえ！^8！ %%",
  "obj_mewmew_body_396": "これも！^8！ %%",
  "obj_mewmew_body_397": "だが　これは　だめだ！^8！ %%",
  "obj_mewmew_body_398": "それは　くらうな！^8！ %%",
  "obj_mewmew_body_399": "オレのだ！^8！ %%",
  "obj_mewmew_body_400": "あああ～！&まちがえて&つかっちゃった～！^8！ %%",
  "obj_mewmew_boss_100": "\\E7そう！　より　ゆうしゅうな&マネキンとしてな！！/%%",
  "obj_mewmew_boss_105": "\\E2はぁ^1～　アンダイン^1～&カゲキで^1　カワイ^1イ&アンダイン～/",
  "obj_mewmew_boss_106": "\\E2この　すがたを　みたら&どんなかお　するかな～&たのしみだミュウ～/%%",
  "obj_mewmew_boss_111": "\\E2きっと　ヤリを&あめあられと　ふらせて&こうげき　してくるんだろな～/",
  "obj_mewmew_boss_112": "\\E2ヤリが　い～っぱい&ささったら^1　せかいいちの&ピンクッションに&なっちゃうミュウ～/%%",
  "obj_mewmew_boss_117": "\\E5え…^1　まさか…&きさま…そ…そのかおは…/",
  "obj_mewmew_boss_118": "\\E6アンダインには…もう…/",
  "obj_mewmew_boss_119": "\\E9…つきあってるコが&いるのか…？/%%",
  "obj_mewmew_boss_124": "\\E9…/",
  "obj_mewmew_boss_125": "\\E4ヒ^1…ヒヒヒヒヒ…&ヒヒヒヒヒヒヒ…/",
  "obj_mewmew_boss_126": "\\E6そうか^1…かのじょはもう&すでに　だれかのものか…&ならば…/",
  "obj_mewmew_boss_127": "\\E7どうしてやるか&いうまでもない！/%%",
  "obj_mewmew_boss_132": "\\E8クソッ^1…&もういい^1！&たくさんだ！！/",
  "obj_mewmew_boss_133": "なぜ　まだ　にくたいと&ひとつに　なれぬのだ！？/",
  "obj_mewmew_boss_134": "こうなったら&ぜんりょくを　だすしか&ないのか！？/%%",
  "obj_mewmew_boss_139": "\\E8では…^1！&これで　どうだ！！/%%",
  "obj_mewmew_boss_146": "\\E5な…なん…だと！^1？&きさま　さては&ヘンタイだな！/",
  "obj_mewmew_boss_147": "\\E6オレの　こうげきを&いっぱつ　のこらず&かわすとは！/",
  "obj_mewmew_boss_148": "\\E5ありえん^1…&ありえん^1！&だんじて　ありえん！！/",
  "obj_mewmew_boss_149": "\\E7ならば^1！&これで^1！&どうだ！！/%%",
  "obj_mewmew_boss_154": "\\E8フウゥゥ…！！/",
  "obj_mewmew_boss_155": "\\E8このていどで　オレに&ほめられると　おもったら&おおまちがいだ！/",
  "obj_mewmew_boss_156": "\\E7くらえ！！/%%",
  "obj_mewmew_boss_161": "\\E2ニャンと^1！　すごいミャ！/",
  "obj_mewmew_boss_162": "\\E1ヤバヤバ～！　キレッキレ～！&イケてる～！　バッキバキ～！&サイコ～！　サイキョ～！&あんたが　カミか！！/",
  "obj_mewmew_boss_163": "\\E8…とでも　いうと&おもったか！？&まだまだだ！！/%%",
  "obj_mewmew_boss_168": "\\E9なぜだ…&オレは　なにを&まちがえている…？/%%",
  "obj_mewmew_boss_173": "\\E0おしえておしえて！！&「ラブ」って　なぁに！？/%%",
  "obj_mewmew_boss_238": "＊ ぷんすかみゅうみゅうが&　 もうれつに　ミュウミュウと　なく。",
  "obj_mewmew_boss_239": "＊ ぷんすかみゅうみゅうは　ピンクの&　 かがみのまえで　にらむ　かおを^1し&　 そのまま　こちらを　むいた。",
  "obj_mewmew_boss_24": "\\E7バトル！^1！&りゅうけつ！^1！&むさべつ　さつりく！！/",
  "obj_mewmew_boss_240": "＊ げんきいっぱいの　たかいこえ^1が&　 みゅうみゅうの　むねから&　 だいおんりょうで　ながれた。",
  "obj_mewmew_boss_241": "＊ ぷんすかみゅうみゅうは&　 とれそうな　あたまを&　 つけなおした。",
  "obj_mewmew_boss_242": "＊ ぷんすかみゅうみゅうは&　 スカダンスを　おどろうとした^1。が&　 ぜんぜん　おんがくに　あわない。",
  "obj_mewmew_boss_243": "＊ こうすいと　オタクの&　 においがする。",
  "obj_mewmew_boss_246": "＊ ぷんすかみゅうみゅうは&　 はなしを　きいてくれそうだ…",
  "obj_mewmew_boss_248": "＊ 「ラブ」を　おしえるには&　 どうすればいい…？",
  "obj_mewmew_boss_25": "\\E4これぞ　パーフェクトな&かんじょうの&トリプルコンボ…/",
  "obj_mewmew_boss_252": "＊ こちらを　にらみつけている。",
  "obj_mewmew_boss_26": "\\E1これで　あたらしい&からだと　ひとつに&なれる^1　ミュウ～/",
  "obj_mewmew_boss_27": "\\E3それでそれで^1～&おニューの&スペシャルわざで～…/",
  "obj_mewmew_boss_28": "\\E7このバトルを　さいこうに&もりあげてやるぞ！/%%",
  "obj_mewmew_boss_32": "\\E4オレが　この　にくたいを&どこで　てにいれたか…/",
  "obj_mewmew_boss_33": "\\E7きになるか！^1？&しりたいか！^1？&ハハハハハ！！/",
  "obj_mewmew_boss_336": "＊ みゅうみゅうフィギュア - AT 0 DF 0&＊ とうしんだいの　フィギュア。&＊ つかいみちは^1…　ナゾだ。/%%",
  "obj_mewmew_boss_338": "＊ ぷんすかみゅうみゅう - AT 45 DF ??&＊ 「みゅうみゅう2: ゲキオコ&　 みゅうみゅうの　ぎゃくしゅう！」/%%",
  "obj_mewmew_boss_34": "\\E1いいよ^1～　おしえてあげる～/%%",
  "obj_mewmew_boss_349": "＊ みゅうみゅうフィギュアの&　 みみの　うしろを　やさしく&　 かいてやった。/%%",
  "obj_mewmew_boss_354": "＊ ぷんすかみゅうみゅうに&　 はなしかけた^1。&＊ かいわは　はずまなかった。/%%",
  "obj_mewmew_boss_359": "＊ ぷんすかみゅうみゅうに&　 「いかり　だけが　せいかいとは&　 かぎらない」と　つたえた。/%%",
  "obj_mewmew_boss_365": "＊ …が　「ラブ」を　ことばで&　 せつめいするのは　むずかしい。/%%",
  "obj_mewmew_boss_40": "\\E8よわい！^1！&よわい！^1！&よわすぎる！^1！/",
  "obj_mewmew_boss_41": "これでは　あまりに&てぬるすぎる！！/",
  "obj_mewmew_boss_42": "Lスティックと　Rスティックを&そとむきに　たおしてみろ！/%%",
  "obj_mewmew_boss_451": "\\E6な^1…なんだと？/",
  "obj_mewmew_boss_452": "つまりそれは…/",
  "obj_mewmew_boss_453": "\\E5ほかの^1…かんじょうも&ためせと　いうことか…？/",
  "obj_mewmew_boss_454": "\\E6たとえば…/",
  "obj_mewmew_boss_455": "\\E2「ラブ」とか？/",
  "obj_mewmew_boss_456": "\\E9そうか^1　それなら…/",
  "obj_mewmew_boss_457": "…/",
  "obj_mewmew_boss_458": "\\E5いいだろう！^1！&さあ　ニンゲンよ！！&すきにしろ！/%%",
  "obj_mewmew_boss_47": "\\E8がああああああ！&わかった！もういい！！/",
  "obj_mewmew_boss_474": "＊ (...？)/%%",
  "obj_mewmew_boss_475": "＊ (…いま　フィギュアが^1…&　 わらったような…？)/%%",
  "obj_mewmew_boss_48": "うごきを　れんしゅうし^1ろ&いま　オレが&はなしている　あいだに！/",
  "obj_mewmew_boss_49": "\\E6どうだ^1？&うごきの　れんしゅうは&じゅうぶんか？/",
  "obj_mewmew_boss_50": "\\E4よし^1　では　はじめるぞ！/%%",
  "obj_mewmew_boss_506": "\\E8やめろ！^1！&もういい！^1！&たくさんだ！！/",
  "obj_mewmew_boss_507": "しょたいめんの　あいてを&ベタベタさわるとは^1！&とんだ　じょうしき&しらずめ！/",
  "obj_mewmew_boss_508": "ぜったいに^1！&さわっては！^1！&ならん！^1！/",
  "obj_mewmew_boss_509": "\\E2だって　くすぐったいもーん/",
  "obj_mewmew_boss_510": "\\E6は…^1？&きさま…オレが　だれだか&わからないのか…？/",
  "obj_mewmew_boss_511": "\\E3ほ…ほ～う…/",
  "obj_mewmew_boss_512": "\\E5そ…そのほうが&いいかもミュウ～！/",
  "obj_mewmew_boss_513": "\\E7だってだって～&このカンペキな　からだと&ひとつに　なれたら^1～/",
  "obj_mewmew_boss_514": "\\E0あたらしい^1　ステキな&じんせいが&はじまるんだミュウ～！/",
  "obj_mewmew_boss_515": "\\E6…だが　どんなに　けんめいに&こころみても…/",
  "obj_mewmew_boss_516": "\\E8なぜか^1！&ひとつに^1！&なれぬのだ！！/",
  "obj_mewmew_boss_517": "オレの　かんじょうに&ざつねんが　まざって&いるせいだ…！！/",
  "obj_mewmew_boss_518": "もっと　きんぱくし^1た&アツい　バトルが&ひつようなのだ！/",
  "obj_mewmew_boss_519": "オレの　まじりけのない&いかりの　かんじょうを&ひきだすのだ！！/",
  "obj_mewmew_boss_520": "\\E5…/",
  "obj_mewmew_boss_521": "\\E0そうだ！！/",
  "obj_mewmew_boss_522": "\\E5おい！^1！ニンゲン！！/",
  "obj_mewmew_boss_523": "\\E7オレと　たたかえ！！/%%",
  "obj_mewmew_boss_564": "\\E8クソッ^1…&もういい^1！&たくさんだ！！/",
  "obj_mewmew_boss_565": "なぜだ！&なぜに　ダメなのだ！？/",
  "obj_mewmew_boss_566": "オレは　こんなにも&いかっている！/",
  "obj_mewmew_boss_567": "オレは　こんなにも&たたかっている！/",
  "obj_mewmew_boss_568": "なのに　なぜ　この　からだと&ひとつに　なれぬのだ！？/",
  "obj_mewmew_boss_569": "\\E5どうして…/",
  "obj_mewmew_boss_570": "\\E9オレは　なにを&まちがえている…？/%%",
  "obj_mewmew_boss_585": "＊ ぷんすかみゅうみゅうは&　 はなしを　きいてくれそうだ…",
  "obj_mewmew_boss_67": "\\E5この　にくたいはな^1…&ある　ふしぎな　ばしょで&みつけたのだ/",
  "obj_mewmew_boss_68": "\\E6それは　なんとも^1…&カガクてきな　ばしょだった/%%",
  "obj_mewmew_boss_72": "\\E5あそこで　なにが&おこなわれていたの^1か&それは　わからないが…/",
  "obj_mewmew_boss_73": "\\E6この　にくたいを&みた　しゅんか^1ん&オレは　さとった…/",
  "obj_mewmew_boss_74": "\\E7これは　オレだ！^1！&オレだ！^1！&オレなのだ！^1！と！/%%",
  "obj_mewmew_boss_79": "\\E5だから　このからだを&のっとったのだ！^1！&だれが　オレを&せめられよう！/",
  "obj_mewmew_boss_80": "\\E6そもそも　かがくしゃが&びしょうじょの&とうしんだいフィギュア^1で&なにを　するき　だった！？/%%",
  "obj_mewmew_boss_85": "\\E5オレは　きっと&このフィギュアを&おそるべき　じっけんから&すくったに　ちがいない！/",
  "obj_mewmew_boss_86": "\\E7オレは　フィギュアを すく^1い&どうじに　みずからをも&すくったのだ！！/%%",
