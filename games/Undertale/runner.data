  "SCR_TEXT_4979": " ",
  "SCR_TEXT_498": "＊ つりいとを　まいてみる？& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_4983": "＊ エラー…/%%",
  "SCR_TEXT_4987": "\\E7＊ だ…　だよね^1！&＊ わたしも^1　そうなったら&　 いいなって　おもって！/",
  "SCR_TEXT_4988": "\\E7＊ きっと　すごく&　 おにあいの　カップル&　 だったんだろうなー。/",
  "SCR_TEXT_4989": "\\E0＊ こんなに　もえる&　 カップリング　ないよねっ！/",
  "SCR_TEXT_499": " ",
  "SCR_TEXT_4990": "\\E7＊ トリ Ｘ ゴア…/",
  "SCR_TEXT_4991": "\\E5＊ せってい^1は　わたしの&　 もと　じょうしと^1…&　 その　もとヨメ…/",
  "SCR_TEXT_4992": "\\E8＊ …あれ^1　なんか…&　 そうかんがえたら&　 きゅうに　なえてきた…/%%",
  "SCR_TEXT_4998": "\\E8＊ …だよね^1。&　 わたしも　そうおもう。/",
  "SCR_TEXT_4999": "\\E7＊ でも^1　もうそうするのは&　 じゆうだよね…？/",
  "SCR_TEXT_5000": "\\E2＊ …どうじんマンガ&　 かくのだって&　 じゆうだよねっ！/",
  "SCR_TEXT_5001": "\\E1＊ じゃんじゃん&　 かこーっと！/%%",
  "SCR_TEXT_5007": "\\E0＊ ああ^1！　そうだ！/",
  "SCR_TEXT_5008": "\\E3＊ もう　きみと&　 たたかう　ひつようが&　 なくなったから…/",
  "SCR_TEXT_5009": "\\E2＊ やっと&　 たずねることが&　 できるね…/",
  "SCR_TEXT_5010": "\\E0＊ 「おちゃでも&　 いかがかな？」と。/",
  "SCR_TEXT_5011": "\\E2＊ …/",
  "SCR_TEXT_5012": "\\E0＊ …おちゃでも&　 いかがかな？/",
  "SCR_TEXT_5013": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_5014": "& & \\>0いただきます\\>1いりません\\C",
  "SCR_TEXT_5015": " ",
  "SCR_TEXT_5019": "＊ エラー…/%%",
  "SCR_TEXT_5023": "＊ そうか^1！&＊ それは　よかった！/",
  "SCR_TEXT_5024": "\\E3＊ でも^1…&　 さっき　いれたぶんは&　 もう　さめてしまったな…/",
  "SCR_TEXT_5025": "＊ さめた　おちゃを&　 おだしする　わけには&　 いかない。/",
  "SCR_TEXT_5026": "\\E0＊ でも^1　よいへんじが&　 もらえて　うれしいよ。/",
  "SCR_TEXT_5027": "\\E0＊ いそいで　いれなおす&　 からね。/",
  "SCR_TEXT_5028": "\\E0＊ きみと^1は　いい&　 ちゃのみともだちに&　 なれそうな　きがするよ。/%%",
  "SCR_TEXT_5034": "\\E3＊ …/",
  "SCR_TEXT_5035": "\\E3＊ そ…　そうか。/",
  "SCR_TEXT_5037": "\\E2＊ フリスク^1！　やめろ^1！&＊ アズゴアのハートを&　 ズタボロに するきか！/",
  "SCR_TEXT_5039": "\\E2＊ いいんだよ^1…&　 アンダイン。/",
  "SCR_TEXT_5040": "\\E0＊ どのみち　わたしの&　 ハートは^1　とっくに&　 ズタボロだ。/",
  "SCR_TEXT_5042": "\\E6＊ アズゴア^1！　やめろ^1！&＊ わたしのハートまで&　 ズタボロになる！/",
  "SCR_TEXT_5044": "\\E9＊ そうだよ　アズゴア^1…&＊ アンダインのハートを&　 きずつけないで。/",
  "SCR_TEXT_5045": "\\E2＊ それは　わたしの&　 や^1　く^1　め！/",
  "SCR_TEXT_5047": "\\E2＊ ちょッ！　アルフィー^1！&　 また　ゴミまみれに&　 するぞ！！/",
  "SCR_TEXT_5049": "\\E0オレさまも&ゴミまみれ&に　なって&いい？/",
  "SCR_TEXT_5051": "\\E9＊ ああ^1　いいとも。/",
  "SCR_TEXT_5053": "\\E1＊ てことは^1　オイラも&　 ゴミに　まみれに&　 いけってことか。/",
  "SCR_TEXT_5055": "\\E0＊ あら^1　じゃあ　わたしも&　 ゴミに　まみれに&　 いっていいかしら？/",
  "SCR_TEXT_5057": "\\E1＊ えと^1…　どうぞ？/",
  "SCR_TEXT_5059": "\\E0＊ わたしも&　 ゴミにまみれて&　 かまわないかい？/",
  "SCR_TEXT_5061": "\\E6＊ ああ！！&＊ かってにしてくれ！！/",
  "SCR_TEXT_5063": "\\E1＊ ごめんなさい^1…&　 やっぱり　わたし&　 ゴミまみれは　イヤだわ。/",
  "SCR_TEXT_5065": "\\E5＊ え…/",
  "SCR_TEXT_5067": "\\E1＊ はぁ…　やれやれ…/%%",
  "SCR_TEXT_5073": "＊ (このさきへ　すすむ^1と&　 あなたの　たびは　ほんとうに&　 おわりを　むかえます)/",
  "SCR_TEXT_5074": "＊ (なかまたちも　いっしょに&　 ちていのせかいを　あとにします)/",
  "SCR_TEXT_5075": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_5076": " & \\>0まだ\\>1さきへ& \\>0すすまない\\>1すすむ\\C",
  "SCR_TEXT_5077": " ",
  "SCR_TEXT_5081": " %%",
  "SCR_TEXT_5095": "\\E0＊ まあ…/",
  "SCR_TEXT_5097": "\\E0＊ みんな^1　ごらん^1…&　 うつくしいだろう？/",
  "SCR_TEXT_5099": "\\E3＊ すごい^1…&　 テレビで　みるより&　 ぜんぜんきれい…/",
  "SCR_TEXT_5100": "\\E7＊ そうぞうしてたのより&　 ずっと　きれい！/",
  "SCR_TEXT_5102": "\\E1＊ フリスク^1　おまえは&　 こんな　きれいなところに&　 すんでるのか！？/",
  "SCR_TEXT_5103": "\\E9＊ たいようは　あかるく^1…&　 そよかぜは　ここちよい…！/",
  "SCR_TEXT_5104": "＊ いきてるって&　 すばらしいな！/",
  "SCR_TEXT_5106": "\\E0ねえ&兄ちゃん…/",
  "SCR_TEXT_5107": "\\E3あの&でっかい&ボールは&なに？/",
  "SCR_TEXT_5109": "\\E1＊ あれは　「たいよう」って&　 いうんだ。/",
  "SCR_TEXT_511": "＊ つりばりには　ヘンなかおした&　 モンスターのしゃしんが&　 ひっかかっている…/",
  "SCR_TEXT_5111": "\\E0え^1！&あれがッ？/",
  "SCR_TEXT_5112": "オレさま、&ついに&たいように&あえた&ぞッ！/",
  "SCR_TEXT_5114": "\\E0＊ こうして　いつまででも&　 ながめて　いたくなるね…/",
  "SCR_TEXT_5116": "\\E0＊ ええ^1　ほんとうに。/",
  "SCR_TEXT_5117": "\\E1＊ でも　そろそろ&　 これからのことを&　 かんがえないと。/",
  "SCR_TEXT_5119": "\\E3＊ ああ^1　そうだったね。/",
  "SCR_TEXT_512": "＊ (でんわ　ください！&　 これが　ボクの　ばんごうです！)/",
  "SCR_TEXT_5120": "\\E0＊ みんな　きいてくれ…/",
  "SCR_TEXT_5121": "＊ われわれは^1　あらたな&　 みらいに　むかって&　 あゆみはじめる。/",
  "SCR_TEXT_5122": "＊ ニンゲンと　モンスターが&　 なかよく　きょうぞんする&　 じだいの　まくあけだ。/",
  "SCR_TEXT_5123": "\\E2＊ そこで^1　フリスク…/",
  "SCR_TEXT_5124": "＊ きみに　おねがいしたい&　 ことがあるんだ。/",
  "SCR_TEXT_5125": "\\E0＊ モンスターと　ニンゲンの&　 あいだを　とりもつ「大使」&　 に　なってくれないか？/",
  "SCR_TEXT_5126": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_5127": "＊ (「大使」に　なる？)& & \\>0なる\\>1ならない\\C",
  "SCR_TEXT_5128": " ",
  "SCR_TEXT_513": "＊ でんわするのは　やめておいた。/%%",
  "SCR_TEXT_5133": "ウヒョウ！　エラーだ！/%%",
  "SCR_TEXT_5136": "\\E0やった^1！&フリスクは&ぜったい、&じょうずな&大使に&なるよッ！/",
  "SCR_TEXT_5137": "そして^1、&この&いだいなる&パピルス&さまは…/",
  "SCR_TEXT_5138": "じょうずな&マスコット&に&なって&やるッ！/",
  "SCR_TEXT_5139": "さっそく&ごあいさつ&しに&いって&くるねッ^1！&だいいち&いんしょう&だいじッ！/%%",
  "SCR_TEXT_5143": "\\E0しんぱい&ないよ、&フリスク^1！&オレさまに&まかせろ！/",
  "SCR_TEXT_5144": "きさまが&大使を&やりたく&なければ…/",
  "SCR_TEXT_5145": "かわりに&オレさまが&やるッ！/",
  "SCR_TEXT_5146": "さっそく&ごあいさつ&しに&いって&くるねッ^1！&だいいち&いんしょう&だいじッ！/%%",
  "SCR_TEXT_5151": "＊ フリスク…/",
  "SCR_TEXT_5152": "\\E2＊ あなたは　もともと&　 このせかいで　くらして&　 いたんでしょう…？/",
  "SCR_TEXT_5153": "\\E1＊ それなら　かえるべき&　 ばしょが　あるのよね？/",
  "SCR_TEXT_5154": "\\E2＊ これから　どうするの？/",
  "SCR_TEXT_5155": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_5156": "\\>0トリエルと\\>1かえるべき& \\>0いっしょに\\>1ばしょが& \\>0くらしたい\\>1ある\\C",
  "SCR_TEXT_5157": " ",
  "SCR_TEXT_516": "＊ つりばりには　メモが&　 ひっかかっている。/",
  "SCR_TEXT_5161": " %%",
  "SCR_TEXT_517": "＊ (やっぱ^1　いいです！)/%%",
  "SCR_TEXT_5182": "＊ (ドアには　ゆうびんうけが　ない)/",
  "SCR_TEXT_5183": "＊ (したの　すきまから&　 てがみを　いれる？)& \\>0いれる\\>1ダメ！！\\C",
  "SCR_TEXT_5184": " ",
  "SCR_TEXT_5197": "＊ (ドアの　したから&　 てがみを　いれて　ノックした)/%%",
  "SCR_TEXT_5206": "＊ (もうすこし　ふところで&　 あたためておこう…)/%%",
  "SCR_TEXT_5212": "＊ (アルフィーの　かきおきだ…)/",
  "SCR_TEXT_5213": "＊ (どうする…？)& & \\>0よむ\\>1よまない\\C",
  "SCR_TEXT_5214": " ",
  "SCR_TEXT_522": "＊ そっとしておいた。/%%",
  "SCR_TEXT_5220": "＊ (てがきで　とても　よみにくい^1…&　 がんばって　よんでみた…)/",
  "SCR_TEXT_5221": "＊ はいけい。/",
  "SCR_TEXT_5222": "＊ わたしに　ちからを&　 かしてくれて&　 ほんとうに　ありがとう。/",
  "SCR_TEXT_5223": "＊ みんなには^1…&　 とても　かんしゃしています。/",
  "SCR_TEXT_5224": "＊ でもね^1…&＊ あらためて　みとめるのは&　 ゆうきが　いるけど…/",
  "SCR_TEXT_5225": "＊ わたしの　もんだいは&　 まわりの　みんなに　かいけつ&　 してもらえる　ものじゃない。/",
  "SCR_TEXT_5226": "＊ わたし^1…&　 いいモンスターになりたい。/",
  "SCR_TEXT_5227": "＊ もう　ビクビクしながら&　 いきるのはイヤなの。/",
  "SCR_TEXT_5228": "＊ そのためには^1 &　 じぶんの　おかした　あやまちに&　 きちんと　むきあわなきゃ。/",
  "SCR_TEXT_5229": "＊ だから　いまから&　 それを　じっこうすることに&　 しました。/",
  "SCR_TEXT_5230": "＊ ただ^1　これだけは&　 はっきり　いっておきます。/",
  "SCR_TEXT_5231": "＊ これは　あくまで&　 わたしひとりの　もんだい。/",
  "SCR_TEXT_5232": "＊ でも　もし　わたしからの&　 れんらくが　とだえて…/",
  "SCR_TEXT_5233": "＊ 「しんじつ」を　しりたいと&　 おもったときは…/",
  "SCR_TEXT_5234": "＊ この　てがみの　まうえにある&　 いりぐちに　はいってください。/",
  "SCR_TEXT_5235": "＊ みんなには&　 わたしが　なにをしたか&　 しる　けんりが　あるから。/",
  "SCR_TEXT_5236": "＊ (てがみに　かいてあるのは&　 それだけだ)/%%",
  "SCR_TEXT_5240": " %%",
  "SCR_TEXT_5250": "＊ (ポテトチップスは　25Gだ)& & \\>0かう\\>1かわない\\C",
  "SCR_TEXT_5251": " ",
  "SCR_TEXT_5255": "＊ (ポテトチップスは　うりきれだ)/%%",
  "SCR_TEXT_5256": " ",
  "SCR_TEXT_5274": "＊ (じどうはんばいき　から&　 ポペトチッスプが　でてきた)/%%",
  "SCR_TEXT_5275": "＊ おかねが　たりない。/%%",
  "SCR_TEXT_5277": "＊ (これいじょう　アイテムを&　 もてない) /%%",
  "SCR_TEXT_5280": "＊%%",
  "SCR_TEXT_5285": "＊ プルルルル\\E0…\\TT /",
  "SCR_TEXT_5286": "\\F1 %",
  "SCR_TEXT_529": "＊ じぶんの　ぶんしんを&　 かんたんに　たにんに　たくした&　 ボクが　バカだった…/%%",
  "SCR_TEXT_5290": "＊ もしもし？&＊ トリエルです。/",
  "SCR_TEXT_5291": "＊ とくに　ふかいいみは&　 ないんだけれど^1…&　 どちらか　えらぶなら…/",
  "SCR_TEXT_5292": "＊ シナモン^1？　それとも&　 バタースコッチ？/",
  "SCR_TEXT_5293": "\\E1＊ … まって^1！&＊ こたえないで…/",
  "SCR_TEXT_5294": "\\E0＊ エラーメッセージです！& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5295": "\\E0＊ バタースコッチでしょう？& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5296": "\\E0＊ シナモンでしょう？& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5297": " ",
  "SCR_TEXT_5309": "\\E0＊ うふふふふ^1。&＊ やっぱり。/",
  "SCR_TEXT_5310": "\\E1＊ このせかいに　ニンゲンが&　 おちてくるとね…/",
  "SCR_TEXT_5311": "\\E1＊ なぜか　まえから&　 しってるひとの　ような&　 きがするの。/",
  "SCR_TEXT_5312": "\\E0＊ じつはね^1　あなたを&　 さいしょに　みたときも…/",
  "SCR_TEXT_5313": "\\E1＊ むかしの　ともだちに&　 であったような&　 きもちに　なったのよ。/",
  "SCR_TEXT_5314": "\\E0＊ ふしぎよね？/",
  "SCR_TEXT_5315": "＊ それはともかく^1 &　 おしえてくれて&　 ありがとう。/",
  "SCR_TEXT_5316": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_5317": "＊ ツー…/%%",
  "SCR_TEXT_5323": "\\E1＊ あら^1…　そうなのね。/",
  "SCR_TEXT_5324": "\\E0＊ わかったわ^1。&＊ それじゃ　またあとでね。/",
  "SCR_TEXT_5325": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_5326": "＊ ツー…/%%",
  "SCR_TEXT_533": "＊ えっ^1…&＊ いま^1　ボクの　からだの&　 かけらを　たべました…？/",
  "SCR_TEXT_5337": "＊ (いま　メタトンに　うしろを&　 むかせれば　ながいスピーチを&　 スキップできそうだ)/",
  "SCR_TEXT_5338": "＊ (どうする？)& & \\>0スキップ\\>1もういちどきく\\C",
  "SCR_TEXT_5339": " ",
  "SCR_TEXT_534": "＊ ボクの　めのまえで！？/",
  "SCR_TEXT_5345": "＊ (メタトンに&　 「うしろに　おもしろいものがある」&　 と　つたえた)/%%",
  "SCR_TEXT_535": "＊ あなたとは　もう&　 くちも　ききたくありません^1…&＊ かえってください！/%%",
  "SCR_TEXT_5353": " %%",
  "SCR_TEXT_5359": "＊ ただ…/",
  "SCR_TEXT_5360": "＊ ひとつだけ　どうしても&　 きになる　ことがあんだ。/",
  "SCR_TEXT_5361": "＊ オイラも^1 &　 せいとうぼうえい　なら&　 しょうがないとおもうぜ。/",
  "SCR_TEXT_5362": "＊ アンタは　いろいろと&　 めんどうに　まきこまれた&　 からな。/",
  "SCR_TEXT_5363": "＊ ただ…/",
  "SCR_TEXT_5364": "＊ アンタ　ときどき…/",
  "SCR_TEXT_5365": "＊ なにが　おきるか&　 わかってるみたいに&　 こうどう　するだろ。/",
  "SCR_TEXT_5366": "＊ ぜんぶ　いちど&　 けいけん　したこと&　 ある　みたいにさ。/",
  "SCR_TEXT_5367": "＊ こんなこと　いうと&　 ヘンに　おもわれる&　 かもしれないけど…/",
  "SCR_TEXT_5368": "\\W＊ もしアンタが　なにかの&　 \\Yとくしゅのうりょく\\Wを&　 もってんなら…/",
  "SCR_TEXT_5369": "＊ ただしい　ことをする&　 せきにんが　あるんじゃ&　 ないか？/",
  "SCR_TEXT_5370": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_5371": " & & \\>0ある\\>1ない\\C",
  "SCR_TEXT_5372": " ",
  "SCR_TEXT_5379": "\\E1＊ へえ。/",
  "SCR_TEXT_5380": "\\E0＊ そうか。/",
  "SCR_TEXT_5381": "\\E3＊ …/%%",
  "SCR_TEXT_5390": "\\E1＊ そうか。/",
  "SCR_TEXT_5391": "\\E0＊ ま^1　かんがえは&　 ひとそれぞれ　だから…/",
  "SCR_TEXT_5392": "\\E2＊ オイラは　なにも&　 いうつもりは　ないぜ。&　 ただ…/",
  "SCR_TEXT_5393": "\\E3＊ …/%%",
  "SCR_TEXT_540": "＊ ボクのかけら^1　だいじにしてくれて&　 ありがとうございます…/%%",
  "SCR_TEXT_5402": "＊ プルルルル…/",
  "SCR_TEXT_5404": "\\E0＊ もしもし！/",
  "SCR_TEXT_5405": "\\E3＊ あのね^1　ぜんぜん&　 かんけいない&　 はなしなんだけど…/",
  "SCR_TEXT_5406": "\\E2＊ …/",
  "SCR_TEXT_5407": "\\E6＊ こんど　いっしょに^1…&　 ニンゲンのアニメ　みない？/",
  "SCR_TEXT_5408": "＊ ヒマなときに…/",
  "SCR_TEXT_5409": "\\E4＊ えとね^1　&　 「キスキスキューティ&　 みゅうみゅう」っていうの。/",
  "SCR_TEXT_5410": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_5411": " & & \\>0いいよ！\\>1…いやです\\C",
  "SCR_TEXT_5412": " ",
  "SCR_TEXT_5420": "＊ ほほほんとにっ！？/",
  "SCR_TEXT_5421": "\\E3＊ すっごく　おもしろいの^1！&＊ いっちばん　すきな&　 アニメなのーっ！/",
  "SCR_TEXT_5422": "＊ みゅうみゅうっていう&　 ニンゲンのおんなのこが&　 でてきてね！%",
  "SCR_TEXT_5423": "\\E3＊ ニンゲンなのに&　 ネコミミだから　すごく&　 きにしてるんだけどね！%",
  "SCR_TEXT_5424": "\\E6＊ でも　さいごには！%",
  "SCR_TEXT_5425": "＊ ネコミミなんて&　 かんけいない　って&　 きづくんだ！%",
  "SCR_TEXT_5426": "＊ ネコミミでも　みんな&　 みゅうみゅうのことが&　 だいすき…！%",
  "SCR_TEXT_5427": "\\E7＊ メッチャかんどう&　 だよ～！%",
  "SCR_TEXT_5428": "\\E5＊ あ　ゴメン&　 ネタバレしちゃった。%",
  "SCR_TEXT_5429": "\\E6＊ それと　みゅうみゅうには&　 とくしゅのうりょくが&　 あって！！%",
  "SCR_TEXT_5430": "\\E5＊ キスした　あいてを&　 マインドコントロール&　 しちゃうんだ！%",
  "SCR_TEXT_5431": "\\E3＊ こまったときは&　 キスして　あいてを&　 あやつって　かいけつ！%",
  "SCR_TEXT_5432": "\\E5＊ キスされたあいては&　 そのあとのことを&　 おぼえてないの！%",
  "SCR_TEXT_5433": "\\E3＊ でも　キスしようとして&　 しっぱいするとね！&＊ なんと！！%",
  "SCR_TEXT_5434": "\\E4＊ なんと^1…　えっと^1…&　 あ^1　そうそ^1う&　 もちろん…%",
  "SCR_TEXT_5435": "\\E5＊ さいごは^1　みゅうみゅうも&　 きづくんだ…　マインド&　 コントロールなんて…%",
  "SCR_TEXT_5436": "\\E3＊ あー　ごめん！&　 ぜんぶ　ネタバレ&　 しちゃダメだよね。%",
  "SCR_TEXT_5437": "\\E5＊ とにかく^1　あなたも&　 きっと　ハマると&　 おもうっ！ /",
  "SCR_TEXT_5438": "\\E0＊ だから^1　このたびが&　 おわったら^1 &　 いっしょに　みようねっ！/",
  "SCR_TEXT_5439": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_5440": "＊ ツー…/%%",
  "SCR_TEXT_5445": "\\E5＊ そ…　そか^1！　うん！&＊ べつに　いいよ！/",
  "SCR_TEXT_5446": "＊ ちょっと^1　きいてみた…&　 だけだから！！/",
  "SCR_TEXT_5447": "\\E6＊ でででも　きっと&　 いちど　みたら&　 ハマると　おもうなっ！/",
  "SCR_TEXT_5448": "＊ だから　よかったら&　 みてみてねっ！/",
  "SCR_TEXT_5449": "\\TS \\F0 \\T0 %",
  "SCR_TEXT_545": "＊ えっ…^1？　また…？/",
  "SCR_TEXT_5450": "＊ ツー…/%%",
  "SCR_TEXT_5455": "\\M1＊ あ^1！&＊ おかえりなさいだお！/",
  "SCR_TEXT_5456": "\\M0＊ すごいヒミツを　おしえてあげるお！/",
  "SCR_TEXT_5457": "\\M1＊ じつは　オニオンさん…&　 バンドやってみることに&　 したんだお。/",
  "SCR_TEXT_5458": "\\M1＊ バンドめいは&　 「レッドホット・ちびペッパーズ」&　 だお。/",
  "SCR_TEXT_5459": "\\M0＊ でも　まだ　なまえしか&　 きめてないんだお。/",
  "SCR_TEXT_546": "＊ ごめんなさい^1…　これいじょう&　 あげたら^1　ボクのからだが&　 なくなっちゃいます…/",
  "SCR_TEXT_5460": "\\M3＊ オニオンさんは^1 &　 がっき　できないお…&＊ うたも　ヘタだお。/",
  "SCR_TEXT_5461": "\\M1＊ どうおもう！^1？&＊ にんきでると　おもう！？/",
  "SCR_TEXT_5462": " & & \\>0おもう\\>1おもわん\\C",
  "SCR_TEXT_5463": " ",
  "SCR_TEXT_547": "＊ やっぱり^1…　じりきで　いけない&　 ばしょへ　いきたいなんて&　 のぞんじゃ　いけなかったんだ。/",
  "SCR_TEXT_5471": "\\M0＊ オニオンさんも^1　そうおもうお…/%%",
  "SCR_TEXT_5477": " %%",
  "SCR_TEXT_548": "＊ ボクたちモンスターは　みんな&　 おなじ　うんめい…/",
  "SCR_TEXT_5485": "＊ (ランプだ)/",
  "SCR_TEXT_5486": "＊ (あかりを　つける？)& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5487": " ",
  "SCR_TEXT_549": "＊ ちていのせかいから^1　えいえんに&　 でることはできないんだ…/%%",
  "SCR_TEXT_5493": "＊ (でんきゅうが　ついていない^1)&＊ (ソケットには&　 かいちゅうでんとうが　さしてある)/",
  "SCR_TEXT_5494": "＊ (かいちゅうでんとうを　つける？)& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5495": " ",
  "SCR_TEXT_5499": " %%",
  "SCR_TEXT_55": " ",
  "SCR_TEXT_5506": "＊ (かいちゅうでんとうの　でんちが&　 きれている)/%%",
  "SCR_TEXT_5510": " %%",
  "SCR_TEXT_5517": "＊ やあ　キミ^1！&＊ オレのなまえ　おぼえてる？/",
  "SCR_TEXT_5518": "＊ (おぼえてる？)& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5519": " ",
  "SCR_TEXT_5527": "＊ えっ…　えええぇぇえっ！^1？&＊ ホントに　おぼえてたの！？/",
  "SCR_TEXT_5528": "＊ まさか^1…　このオレが^1…&　 まけるなんてええええぇぇ！/%%",
  "SCR_TEXT_5533": "＊ えっ…　えええぇぇえっ！^1？&＊ おぼえてないの！？/",
  "SCR_TEXT_5534": "＊ まさか^1…　このオレが^1…&　 まけるなんてええええぇぇ！/%%",
  "SCR_TEXT_554": "＊ ボクのちょうしは　どうですか^1？&＊ このまえあげた　ボクのからだの&　 かけらのことですけど…/",
  "SCR_TEXT_5541": "＊ (しろい　こいぬだ^1)&＊ (ぐっすり　ねむっている…)/",
  "SCR_TEXT_5542": "＊ (イヌと　たたかう？)& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5543": " ",
  "SCR_TEXT_5550": "＊ (イヌとは　たたかえない)/",
  "SCR_TEXT_5551": "＊ (イヌのしたに　しいてある　ぬのは&　 あちこち　あなだらけのようだ)/",
  "SCR_TEXT_5552": "＊ (イヌは　ぬのに&　 「パッチ」を　あてないと&　 いけないようだ)/",
  "SCR_TEXT_5553": "＊ (それが　すんだら　たたかえる^1)&＊ (…かも？)/",
  "SCR_TEXT_5554": "＊ (よくみると^1　ぬのに　あいた&　 あなは　どんどん　おおきく&　 なっているようだ)/",
  "SCR_TEXT_5555": "＊ (イヌが　ぜんぶの　あなに&　 「パッチ」をあてるには&　 かなりのじかんが　かかりそうだ)/",
  "SCR_TEXT_5556": "＊ (イヌは　ふつ^1う&　 あみものが　とくいではない)/",
  "SCR_TEXT_5557": "＊ (かぎあみ　なんて&　 もってのほかだ)/%%",
  "SCR_TEXT_5561": "＊ (ねむれるイヌ^1は&　 おこして　たたかうべからず^1)&＊ (…という　ことわざがある)/%%",
  "SCR_TEXT_5566": "＊ (コンコン)/",
  "SCR_TEXT_5569": "＊ うわああああ^1！&＊ ルームサービスうぅぅ！/",
  "SCR_TEXT_5570": "＊ 「ビチャビちゃ」　もってきてくれた？& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5571": " ",
  "SCR_TEXT_5575": "＊ ルームサービス…　けっきょく&　 こなかったな^1…&＊ (はぁ…)/%%",
  "SCR_TEXT_5581": "＊ ありがとんくす。/%%",
  "SCR_TEXT_5585": "＊ (へんじが　ない)/%%",
  "SCR_TEXT_559": "＊ えっ^1？　なくしちゃったんですか…^1？&＊ …しかたないですね…　じゃあ&　 もう1つあげます…/",
  "SCR_TEXT_5598": "＊ (ビチャビちゃを　ドアのしたの&　 すきまから　そそぎいれた)/",
  "SCR_TEXT_5599": "＊ うあああああぁぁ^2！&＊ サーブのしかたも　カンペキ！^1！&＊ チップあげるうぅぅ！/",
  "SCR_TEXT_5600": "＊ (99G　てにいれた)/%%",
  "SCR_TEXT_5604": "＊ ^1…&＊ もってないだろ。/%%",
  "SCR_TEXT_5609": "＊ じゃあ　なにしにきたの…！？/%%",
  "SCR_TEXT_5614": "＊ (コンコン)/",
  "SCR_TEXT_5617": "＊ うわああああ ^1！&＊ ルームサービスうぅぅ！/",
  "SCR_TEXT_5618": "＊ 「シナモンキー」&　 もってきてくれた？ & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5619": " ",
  "SCR_TEXT_5623": "＊ ルームサービス…　けっきょく&　 こなかったな^1…&＊ (はぁ…)/%%",
  "SCR_TEXT_5628": "＊ とんくす。/%%",
  "SCR_TEXT_563": "＊ もちものが　いっぱい^1？&＊ そうですか^1…　ボクのことなんて&　 けっきょく　どうでもいいんですね。/%%",
  "SCR_TEXT_5632": "＊ (へんじがない)/%%",
  "SCR_TEXT_5646": "＊ (シナモンキーを　ペラペラに&　 つぶして^1　ドアのしたの&　 すきまから　さしいれた)/",
  "SCR_TEXT_5647": "＊ うあああああぁぁ^2！&＊ サーブのしかたも　カンペキ！^1！&＊ チップあげるうぅぅ！/",
  "SCR_TEXT_5648": "＊ (99G　てにいれた)/%%",
  "SCR_TEXT_5652": "＊ ^1…&＊ もってないだろ。/%%",
  "SCR_TEXT_5657": "＊ じゃあ　なにしにきたの…！？/%%",
  "SCR_TEXT_5662": "＊ (どうぶつが　うごきまわる&　 けはいがする…)/",
  "SCR_TEXT_5663": "＊ (ドアのしたの　すきまから&　 なにか　いれられそうだ)/",
  "SCR_TEXT_5664": " & & \\>0いれる\\>1いれない\\C",
  "SCR_TEXT_5665": " ",
  "SCR_TEXT_5669": "＊ (へんじがない)/%%",
  "SCR_TEXT_567": "＊ もう　なくさないでくださいね。/",
  "SCR_TEXT_5676": "＊ (…)/",
  "SCR_TEXT_5677": "＊ (ちょうどよさげなものを&　 もっていない)/%%",
  "SCR_TEXT_568": "＊ (ゆきだるまのかけらを&　 てにいれた)/%%",
  "SCR_TEXT_5705": "＊ (ドアのまえに&　 ホットドッグをおいた)/",
  "SCR_TEXT_5706": "＊ (とつぜん　ドアのしたから&　 しろいイヌのてが　あらわれた)/",
  "SCR_TEXT_5707": "＊ (ホットドッグを　へやのなかに&　 ひきいれようと　している…)/",
  "SCR_TEXT_5708": "＊ (てのいきおいが　つよすぎて&　 うまくつかめない…)/",
  "SCR_TEXT_5709": "＊ (…)/",
  "SCR_TEXT_5710": "＊ (ようやくゲット！)/",
  "SCR_TEXT_5711": "＊ (…)/",
  "SCR_TEXT_5712": "＊ (へやのなかから&　 いしうすを　まわすような&　 おとがする)/",
  "SCR_TEXT_5713": "＊ (ドアのしたの　すきまから&　 ハッシュパピーが　でてきた)/",
  "SCR_TEXT_5714": "＊ (ハッシュパピーを&　 てにいれた)/%%",
  "SCR_TEXT_5720": "＊ (ドアのまえに&　 ホットキャットをおいた)/",
  "SCR_TEXT_5721": "＊ (うなりごえが　きこえる…)/%%",
  "SCR_TEXT_5727": "＊ (ドアのまえに　ドッグサラダを&　 おいた^1)&＊ (ドアのしたに　すいこまれていく)/",
  "SCR_TEXT_5728": "＊ (…)/",
  "SCR_TEXT_5729": "＊ (ドッグサラダは　やみのなかに&　 すいこまれていった)/%%",
  "SCR_TEXT_5736": "＊ (ドアのまえに　イヌのおとしものを&　 おいた)/",
  "SCR_TEXT_5737": "＊ (じしゃくに　ひきよせられるよう^1に&　 ドアのしたに　すいこまれていく)/",
  "SCR_TEXT_5738": "＊ (…)/",
  "SCR_TEXT_5743": "＊ (ビヨン！^1)&＊ (いきおいよく&　 おしもどされた！)/%%",
  "SCR_TEXT_5747": "＊ (ドアのしたから　ゆっくり^1と&　 イヌのおとしものが　2つ&　 でてきた)/%%",
  "SCR_TEXT_5755": " %%",
  "SCR_TEXT_576": "＊ こんにちは^1。&＊ ボクは　ゆきだるまです。/",
  "SCR_TEXT_5761": "＊ ええ^1　そうなんです^1。&＊ みやこへの　エレベーターは&　 こしょうちゅうで。/",
  "SCR_TEXT_5762": "＊ ですので　とうホテルで^1は&　 ただいま　ごしゅくはくりょうきんを&　 おおはば　ねさげちゅう　ですよ！/",
  "SCR_TEXT_5763": "＊ 1ぱく　200Gです。&　 いかがなさいますか^1？& \\>0とまる\\>1やめとく\\C",
  "SCR_TEXT_5764": " ",
  "SCR_TEXT_5768": "＊ 1ぱく　200Gです。&　 いかがなさいますか^1？& \\>0とまる\\>1やめとく\\C",
  "SCR_TEXT_5769": " ",
  "SCR_TEXT_577": "＊ ボクのゆめは　せかいりょこう^1…&＊ でも　あいにくボクは　ここから&　 うごけません。/",
  "SCR_TEXT_5774": "＊ ゆっくり　おやすみ&　 いただけましたか？/",
  "SCR_TEXT_5775": "＊ え^1？&＊ キー…^1？&＊ おへやの…？/",
  "SCR_TEXT_5776": "＊ とうホテルでは^1　そのような&　 システムは　さいようして&　 おりません。/",
  "SCR_TEXT_5777": "＊ いちど　おへやを　でられた^1ら&　 もういちど　りょうきんを&　 おしはらい　いただきます。/",
  "SCR_TEXT_5778": "＊ 1ぱく　200Gです。&　 いかがなさいますか^1？& \\>0とまる\\>1やめとく\\C",
  "SCR_TEXT_5779": " ",
  "SCR_TEXT_578": "＊ たびびとさん^1　もしよかった^1ら&　 ひとつおねがいしても&　 いいですか…？/",
  "SCR_TEXT_579": "＊ ボクのからだから　ゆきをとって&　 とおくへ　はこんでほしいんです。& \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5791": "＊ ごりよう　ありがとうございます^1。&＊ では　おへやに　ごあんない&　 いたします。/%%",
  "SCR_TEXT_5797": "＊ …おカネが　たりないようですが。/%%",
  "SCR_TEXT_580": " ",
  "SCR_TEXT_5802": "＊ きが　かわられましたら&　 いつでも　おしらせください^1。&＊ では　グラマラスな　いちにちを！/%%",
  "SCR_TEXT_5807": "＊ …わたしの　うんめいのひと…？/",
  "SCR_TEXT_5808": "＊ …/",
  "SCR_TEXT_5809": "＊ (ちょっと。どうして　そんな&　 めんどくさそうな　かおしてるの？)/",
  "SCR_TEXT_5810": "＊ (そんな　やるきのない&　 たいどじゃ^1　さいこうの&　 パフォーマンスは　できないよ…)/",
  "SCR_TEXT_5811": "＊ (おきゃくさまに　しつれいだから&　 スキップする？)/",
  "SCR_TEXT_5812": "＊ (どうする？)& & \\>0えんじる\\>1スキップする\\C",
  "SCR_TEXT_5813": " ",
  "SCR_TEXT_5819": "＊ (そう^1)&＊ (じゃあ…　ひとつ　ブチかまそう&　 か！)/%%",
  "SCR_TEXT_5823": "＊ (はぁ…ギガガッカリだよ…^1)&＊ (でも…　ショー・マスト&　 ゴー・オン　だ！)/%%",
  "SCR_TEXT_5829": "おもしろい。/",
  "SCR_TEXT_5830": "お前^1は　戻りたいというのか？/",
  "SCR_TEXT_5831": "みずから破壊した世界に？/",
  "SCR_TEXT_5832": "こんな結末になったの^1は&自分のせいだというのに。/",
  "SCR_TEXT_5833": "お前が　その手^1で&この世界を破壊したというのに。/",
  "SCR_TEXT_5834": "その結果を受け入れられないと？/",
  "SCR_TEXT_5835": "お前は　自分のしたことの&つけを払わずに済むと思っている。& \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5836": "",
  "SCR_TEXT_5842": "勝手なものだ。/%%",
  "SCR_TEXT_5846": "では　何を期待している？/%%",
  "SCR_TEXT_5851": "では…/",
  "SCR_TEXT_5852": "こうしよう。/",
  "SCR_TEXT_5853": "お前^1は　私が求めるものを&持っている。/",
  "SCR_TEXT_5854": "それを差し出せ。/",
  "SCR_TEXT_5855": "そうすれば　この世界を&復活させてやろう。/",
  "SCR_TEXT_5856": " & & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5857": "",
  "SCR_TEXT_5863": "交渉成立だ。/",
  "SCR_TEXT_5864": "お前のタマシイをいただこう。& & \\>0はい\\>1いいえ\\C",
  "SCR_TEXT_5865": " ",
  "SCR_TEXT_5869": "ならば永遠に&ここにいるがいい。/",
  "SCR_TEXT_5870": " ",
  "SCR_TEXT_5877": "…/",
  "SCR_TEXT_5878": "よし^1。望みをかなえてやる。/%%",
  "SCR_TEXT_5882": "ならば永遠に&ここにいるがいい。/",
  "SCR_TEXT_5883": " ",
