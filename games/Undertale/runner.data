  "SCR_TEXT_1131": " %%",
  "SCR_TEXT_1139": "* (It's a pair of ballet shoes.)/",
  "SCR_TEXT_1140": "* (Will you take it?)& &         Take it     Leave it  \\C ",
  "SCR_TEXT_1141": " ",
  "SCR_TEXT_1144": "* Nothing's here!!!/%%",
  "SCR_TEXT_1160": "* (You got the Ballet Shoes.)/%%",
  "SCR_TEXT_1163": "* (You're carrying too much.)/%%",
  "SCR_TEXT_1167": " %%",
