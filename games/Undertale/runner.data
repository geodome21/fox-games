  "obj_bara01_278": "H-HEY,&STOP&THAT!!",
  "obj_bara01_285": "02...&this is,&like,&for you.",
  "obj_bara01_286": "Like,&02...",
  "obj_bara01_287": "02...&are you&really..",
  "obj_bara01_288": "...",
