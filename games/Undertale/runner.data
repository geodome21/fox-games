  "obj_memoryhead_183": "じゃあ&またね",
  "obj_memoryhead_188": "なら&うごか&ないで",
  "obj_memoryhead_189": "ちょっと&まってて",
  "obj_memoryhead_190": "すぐに&いっしょに&なれるよ",
  "obj_memoryhead_195": "%%%",
  "obj_memoryhead_420": "＊ しかし　だれもこなかった。",
  "obj_memoryhead_421": "＊ しかし　だれもこなかった。",
