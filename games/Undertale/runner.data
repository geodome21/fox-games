  "scr_battlegroup_1791": "* It's time to say goodbye.",
  "obj_basicmonster_act": "* Monster does an action.",
  "obj_basicmonster_info": "* Smells like a monster.",
  "obj_basicmonster_mercy": "* Monster seems satisfied.",
  "obj_basicmonster_lowhp": "* Monster has low HP.",
