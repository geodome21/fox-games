  "obj_heartdefeated_343": "* But it refused^5.%%",
  "obj_hearthflame_57": "* The fire isn't burning hot...&* Just pleasantly warm.&* You could put your hand inside./%%",
  "obj_heatsflamesman_75": "\\W* Heh^1.&* I'm \\RHeats Flamesman\\W.&* Remember my name!/%%",
  "obj_heatsflamesman_85": "* I'll always remember that&  you remembered!/%%",
  "obj_heatsflamesman_90": "* I'll never forget that you&  forgot!/%%",
  "obj_heatsflamesman_97": "* What?&* Do you want a rematch?/%%",
  "obj_hivestem_99": "* hOIVS!/%%",
  "obj_hivestem_103": "* p..^1.&* tem heard human allergics&  to tem.../",
  "obj_hivestem_104": "* dat OK..^1.&* tem understan.../",
  "obj_hivestem_105": "* tem..^1.&* ALSO allergic to tem!!!/%%",
  "obj_hotelreceptionist_95": "* bepis/%%",
  "obj_hotelreceptionist_100": "* Sorry^1, we aren't allowing&  any more guests at this time./",
  "obj_hotelreceptionist_101": "* Or ever again./%%",
  "obj_hotelreceptionist_107": "* How unusual./",
  "obj_hotelreceptionist_108": "* Mettaton usually shows up&  now to tell everyone they're&  doing a great job./",
  "obj_hotelreceptionist_109": "* Even if I was having a bad&  day^1, we'll always give each&  other a thumbs-up^1, and.../",
  "obj_hotelreceptionist_110": "* ... oh^1, what am I doing^1?&* I'm not being very&  professional./%%",
  "obj_icecap_139": "Where's&YOUR&hat?",
  "obj_icecap_140": "Your&head&looks so&...NAKED",
  "obj_icecap_141": "What a&great&hat!&(Mine)",
  "obj_icecap_142": "Snow?&No! It's&hat&residue.",
  "obj_icecap_143": "I just&looove&my hat.&OK?",
  "obj_icecap_148": "Fine!!!&I don't&care!!!",
  "obj_icecap_149": "OK!&I'll&ignore&you too.",
  "obj_icecap_150": "Better&a hatter&than a&HATER.",
  "obj_icecap_156": "HELLO???&My hat's&up here.",
  "obj_icecap_157": "What?&What are&you&doing?",
  "obj_icecap_163": "DUH!&Who&DOESN'T&know?",
  "obj_icecap_164": "Envious?&TOO BAD!",
  "obj_icecap_165": "My hat's&too loud&for me to&hear you.",
  "obj_icecap_169": "I KNEW&IT!!!&THIEF!!",
  "obj_icecap_170": "HELP!!!&FASHION&POLICE!!",
  "obj_icecap_175": "Haha!&That was&ACTUALLY&funny!",
  "obj_icecap_176": "Ha!&Imitated&it spot-&on!",
  "obj_icecap_177": "That's&the best&one in&a while!",
  "obj_icecap_182": "%%%",
  "obj_icecap_374": "* It's snowing dandruff.",
  "obj_icecap_375": "* Ice Cap also wants a hat&  for its nose.",
  "obj_icecap_376": "* Ice Cap makes sure its hat&  is still there.",
  "obj_icecap_377": "* Ice Cap is thinking about a&  certain article of clothing.",
  "obj_icecap_378": "* Here comes that new clothes&  smell.",
  "obj_icecap_379": "* Ice Cap is secretly checking&  if you're looking at&  its hat.",
  "obj_icecap_380": "* Ice Cap is desperate for&  attention.",
  "obj_icecap_381": "* Ice Cap's hat is loose.",
  "obj_icecap_396": "* ICE CAP - ATK 11 DEF 4&* This teen wonders why&  it isn't named 'Ice Hat.'/^",
  "obj_icecap_406": "* You continue not looking&  at Ice Cap's hat./",
  "obj_icecap_407": "* It seems defeated.../^",
  "obj_icecap_412": "* You manage to tear your&  eyes away from Ice Cap's&  hat./",
  "obj_icecap_413": "* It looks annoyed.../^",
  "obj_icecap_422": "* You inform Ice Cap that&  it has a great hat!/^",
  "obj_icecap_431": "* You tried to steal Ice Cap's&  hat.../",
  "obj_icecap_432": "* ... but it's not weakened&  enough!/^",
  "obj_icecap_435": "* And succeeded!&* (It melts in your hands...)/^",
  "obj_icecap_npcb_70": "* Everyone's wearing hats^1.&* Should I branch into a&  different item?/",
  "obj_icecap_npcb_71": "* Ice jorts./",
  "obj_icecap_npcb_72": "* ... doesn't have the same&  ring to it./%%",
  "obj_icecap_npcb_73": "* Ice socks and sandals./%%",
  "obj_icecap_npcb_77": "* I know how to set myself&  apart now^1!&* An ear piercing!/",
  "obj_icecap_npcb_78": "* .../",
  "obj_icecap_npcb_79": "* Wait./%%",
  "obj_icecap_npcg_70": "* Hey^1, stop thinking about&  my hat!/",
  "obj_icecap_npcg_71": "* ... you aren't thinking about&  my hat?/",
  "obj_icecap_npcg_72": "* ... can you^1, please?/%%",
  "obj_icecap_npcg_77": "* Ha^1!&* After all this time^1, you're&  still thinking about my hat!/",
  "obj_icecap_npcg_78": "* .../",
  "obj_icecap_npcg_79": "* ... please?/%%",
  "obj_icecap_npcr_70": "* We all live in the woods^1,&  so no one can tell us&  what to do!/",
  "obj_icecap_npcr_71": "* But now everyone ignores&  us.../",
  "obj_icecap_npcr_72": "* I don't want freedom if&  it means no one's gonna&  pay attention to me./%%",
  "obj_icecap_npcr_77": "* Maybe someone on the surface&  will pay attention to me./",
  "obj_icecap_npcr_78": "* There're so many people^1,&  someone has to^1, right!?/%%",
  "obj_icecube_174": "I...&I...",
  "obj_icecube_175": "What can&I say...",
  "obj_icecube_176": "What's&the&point...",
  "obj_icecube_177": "So...&Cold...",
  "obj_icecube_181": "Yeah...&I like&my hair&too.",
  "obj_icecube_182": "Hmm...&Hats are&for&posers.",
  "obj_icecube_183": "So I can&still&impress&you?",
  "obj_icecube_184": "I wanted&you to&see me&as cool.",
  "obj_icecube_188": "Haha!&That was&ACTUALLY&funny!",
  "obj_icecube_189": "Ha!&Imitated&it spot-&on!",
  "obj_icecube_190": "That's&the best&one in&a while!",
  "obj_icecube_196": "%%%",
