  "obj_autowater_90": "* (The cup evaporated^1, too.)/%%",
  "obj_bara01_252": "Like,&give us&the soul&brah.",
  "obj_bara01_253": "Like,&\"you're&dead\"&and all.",
  "obj_bara01_254": "Like,&prepare&to die,&right?",
  "obj_bara01_255": "Like,&perish&and&stuff.",
  "obj_bara01_259": "D...&Dude...",
  "obj_bara01_262": "Like,&team&attack!",
  "obj_bara01_266": "Like...&what?&I don't&get it.",
